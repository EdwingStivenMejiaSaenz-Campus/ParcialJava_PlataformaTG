<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ include file="/WEB-INF/jspf/seguridad.jspf" %><%@ include file="/WEB-INF/jspf/conexion.jspf" %>
<c:if test="${pageContext.request.method ne 'POST' or sessionScope.rol ne 'COMITE' or empty param.csrf or param.csrf ne sessionScope.csrf}"><c:redirect url="/dashboard.jsp"><c:param name="error" value="acceso"/></c:redirect></c:if>
<c:choose><c:when test="${param.accion eq 'reporte' and not empty fn:trim(param.descripcion) and fn:length(param.descripcion) le 10000}">
<sql:update var="total" dataSource="${db}">INSERT INTO reportes_uts(usuario_id,proyecto_id,descripcion) SELECT ?,p.id,? FROM (SELECT 1) v LEFT JOIN proyectos p ON p.id=CAST(NULLIF(?::text,'') AS bigint) WHERE (?='' OR p.id IS NOT NULL)
<sql:param value="${sessionScope.usuarioId}"/><sql:param value="${param.descripcion}"/><sql:param value="${param.proyecto_id}"/><sql:param value="${param.proyecto_id}"/></sql:update>
<c:if test="${total gt 0}"><c:redirect url="/comun/reportes.jsp"><c:param name="ok" value="1"/></c:redirect></c:if><c:redirect url="/comun/reportes.jsp"><c:param name="error" value="validacion"/></c:redirect>
</c:when><c:when test="${param.accion eq 'beneficio' and (param.estado eq 'PENDIENTE' or param.estado eq 'APROBADO' or param.estado eq 'RECHAZADO') and not empty fn:trim(param.acta) and not empty param.fecha and not empty fn:trim(param.comentarios) and fn:length(param.acta) le 90}">
<sql:update var="afectadas" dataSource="${db}">INSERT INTO beneficios_saber_uts(proyecto_id,estudiante_id,comite_id,estado,acta,fecha_acta,comentarios) SELECT p.id,pe.estudiante_id,?,?,?,?,? FROM proyectos p JOIN proyecto_estudiantes pe ON pe.proyecto_id=p.id WHERE p.id=CAST(NULLIF(?::text,'') AS bigint) AND pe.estudiante_id=CAST(NULLIF(?::text,'') AS bigint)
<sql:param value="${sessionScope.usuarioId}"/><sql:param value="${param.estado}"/><sql:param value="${param.acta}"/><sql:param value="${param.fecha}"/><sql:param value="${param.comentarios}"/><sql:param value="${param.proyecto_id}"/><sql:param value="${param.estudiante_id}"/></sql:update>
<c:if test="${afectadas gt 0}"><sql:update dataSource="${db}">INSERT INTO notificaciones(usuario_id,proyecto_id,mensaje) VALUES(?,?,CONCAT('Respuesta Beneficio Saber TyT/PRO: ',?))<sql:param value="${param.estudiante_id}"/><sql:param value="${param.proyecto_id}"/><sql:param value="${param.estado}"/></sql:update><c:redirect url="/comun/seguimiento.jsp"><c:param name="id" value="${param.proyecto_id}"/><c:param name="ok" value="1"/></c:redirect></c:if><c:redirect url="/dashboard.jsp"><c:param name="error" value="validacion"/></c:redirect>
</c:when><c:otherwise><c:redirect url="/dashboard.jsp"><c:param name="error" value="validacion"/></c:redirect></c:otherwise></c:choose>