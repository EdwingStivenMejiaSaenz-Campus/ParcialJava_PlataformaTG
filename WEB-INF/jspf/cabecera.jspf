<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ taglib prefix="fn" uri="http://java.sun.com/jsp/jstl/functions" %>
<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Sistema · Trabajos de Grado UTS</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/estilos.css"><script defer src="${pageContext.request.contextPath}/js/panel-uts.js"></script></head>
<body class="uts-panel-layout"><div class="uts-app"><aside class="uts-side" id="navegacion">
<div class="uts-side-brand"><img src="${pageContext.request.contextPath}/img/logo-sistemas-transparente.png" alt="Ingeniería de Sistemas UTS"><button type="button" aria-label="Contraer menú" class="nav-toggle" data-toggle-nav><svg class="ui-icon" aria-hidden="true"><use href="${pageContext.request.contextPath}/img/icons.svg#menu"/></svg></button></div>
<nav aria-label="Navegación principal">
<a href="${pageContext.request.contextPath}/dashboard.jsp" data-active="dashboard.jsp"><span class="nav-icon"><svg class="ui-icon" aria-hidden="true"><use href="${pageContext.request.contextPath}/img/icons.svg#home"/></svg></span> Inicio</a>
<a href="${pageContext.request.contextPath}/comun/perfil.jsp"><span class="nav-icon"><svg class="ui-icon" aria-hidden="true"><use href="${pageContext.request.contextPath}/img/icons.svg#user"/></svg></span> Mi perfil</a>
<c:if test="${sessionScope.rol eq 'ADMINISTRADOR'}"><a href="${pageContext.request.contextPath}/admin/usuarios.jsp"><span class="nav-icon"><svg class="ui-icon" aria-hidden="true"><use href="${pageContext.request.contextPath}/img/icons.svg#users"/></svg></span> Usuarios</a></c:if><c:if test="${sessionScope.rol eq 'COMITE'}"><a href="${pageContext.request.contextPath}/comun/usuarios_visual.jsp"><span class="nav-icon"><svg class="ui-icon" aria-hidden="true"><use href="${pageContext.request.contextPath}/img/icons.svg#users"/></svg></span> Usuarios</a></c:if>
<a href="${pageContext.request.contextPath}/comun/banco_visual.jsp"><span class="nav-icon"><svg class="ui-icon" aria-hidden="true"><use href="${pageContext.request.contextPath}/img/icons.svg#book"/></svg></span> Banco de ideas</a>
<c:if test="${sessionScope.rol eq 'ESTUDIANTE' or sessionScope.rol eq 'COMITE' or sessionScope.rol eq 'ADMINISTRADOR'}"><a href="${pageContext.request.contextPath}/comun/proyectos_visual.jsp?tipo=proyectos"><span class="nav-icon"><svg class="ui-icon" aria-hidden="true"><use href="${pageContext.request.contextPath}/img/icons.svg#folder"/></svg></span> Proyectos de grado</a>
<a href="${pageContext.request.contextPath}/comun/proyectos_visual.jsp?tipo=practicas"><span class="nav-icon"><svg class="ui-icon" aria-hidden="true"><use href="${pageContext.request.contextPath}/img/icons.svg#briefcase"/></svg></span> Prácticas</a></c:if>
<c:if test="${sessionScope.rol eq 'COMITE' or sessionScope.rol eq 'EVALUADOR' or sessionScope.rol eq 'DIRECTOR'}"><a href="${pageContext.request.contextPath}/comun/propuestas_banco.jsp"><span class="nav-icon"><svg class="ui-icon" aria-hidden="true"><use href="${pageContext.request.contextPath}/img/icons.svg#filetext"/></svg></span> Propuestas Banco</a></c:if>
<c:if test="${sessionScope.rol eq 'DIRECTOR'}"><a href="${pageContext.request.contextPath}/director/proyectos.jsp"><span class="nav-icon"><svg class="ui-icon" aria-hidden="true"><use href="${pageContext.request.contextPath}/img/icons.svg#user"/></svg></span> Docente Director</a></c:if>
<c:if test="${sessionScope.rol eq 'EVALUADOR'}"><a href="${pageContext.request.contextPath}/evaluador/proyectos.jsp"><span class="nav-icon"><svg class="ui-icon" aria-hidden="true"><use href="${pageContext.request.contextPath}/img/icons.svg#user"/></svg></span> Docente Evaluador</a><a href="${pageContext.request.contextPath}/evaluador/sustentacion.jsp"><span class="nav-icon"><svg class="ui-icon" aria-hidden="true"><use href="${pageContext.request.contextPath}/img/icons.svg#file"/></svg></span> Evaluación final</a></c:if>
<a href="${pageContext.request.contextPath}/comun/formatos.jsp"><span class="nav-icon"><svg class="ui-icon" aria-hidden="true"><use href="${pageContext.request.contextPath}/img/icons.svg#book"/></svg></span> Base documental</a>
<a href="${pageContext.request.contextPath}/comun/historico_visual.jsp"><span class="nav-icon"><svg class="ui-icon" aria-hidden="true"><use href="${pageContext.request.contextPath}/img/icons.svg#clock"/></svg></span> Módulo Histórico</a>
<c:if test="${sessionScope.rol eq 'COMITE'}"><a href="${pageContext.request.contextPath}/comite/config_visual.jsp"><span class="nav-icon"><svg class="ui-icon" aria-hidden="true"><use href="${pageContext.request.contextPath}/img/icons.svg#settings"/></svg></span> Configuraciones</a></c:if>
<c:if test="${sessionScope.rol eq 'ADMINISTRADOR'}"><a href="${pageContext.request.contextPath}/admin/auditoria.jsp"><span class="nav-icon"><svg class="ui-icon" aria-hidden="true"><use href="${pageContext.request.contextPath}/img/icons.svg#clock"/></svg></span> Auditoría</a><a href="${pageContext.request.contextPath}/admin/catalogos.jsp"><span class="nav-icon"><svg class="ui-icon" aria-hidden="true"><use href="${pageContext.request.contextPath}/img/icons.svg#settings"/></svg></span> Configuraciones</a></c:if>
</nav><div class="uts-side-bottom"><a href="${pageContext.request.contextPath}/comun/calendario.jsp"><svg class="ui-icon" aria-hidden="true"><use href="${pageContext.request.contextPath}/img/icons.svg#calendar"/></svg> Calendario académico</a><a href="${pageContext.request.contextPath}/comun/notificaciones.jsp"><svg class="ui-icon" aria-hidden="true"><use href="${pageContext.request.contextPath}/img/icons.svg#bell"/></svg> Notificaciones</a><a href="${pageContext.request.contextPath}/logout.jsp"><svg class="ui-icon" aria-hidden="true"><use href="${pageContext.request.contextPath}/img/icons.svg#logout"/></svg> Cerrar sesión</a></div></aside>
<div class="uts-workspace"><header class="uts-welcome"><button type="button" class="nav-toggle mobile-menu" data-toggle-nav aria-label="Abrir menú"><svg class="ui-icon" aria-hidden="true"><use href="${pageContext.request.contextPath}/img/icons.svg#menu"/></svg></button><span>Bienvenido</span><span class="uts-user"><svg class="ui-icon" aria-hidden="true"><use href="${pageContext.request.contextPath}/img/icons.svg#user"/></svg> <c:out value="${sessionScope.nombre}"/> <small> · <c:out value="${sessionScope.rol}"/></small> <svg class="ui-icon" aria-hidden="true"><use href="${pageContext.request.contextPath}/img/icons.svg#chevron"/></svg></span></header><main class="contenido">
<c:if test="${not empty param.ok}"><div class="alert ok">Respuesta enviada correctamente. Consulta el estado actualizado.</div></c:if>
<c:if test="${not empty param.error}"><div class="alert error">No fue posible completar la operación. Comprueba tus permisos y los requisitos de la fase.</div></c:if>
