<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ include file="/WEB-INF/jspf/seguridad.jspf" %><c:if test="${sessionScope.rol ne 'EVALUADOR'}"><c:redirect url="/dashboard.jsp"><c:param name="error" value="acceso"/></c:redirect></c:if><%@ include file="/WEB-INF/jspf/conexion.jspf" %>
<sql:query var="proyectos" dataSource="${db}">SELECT p.*,u.nombre AS estudiante,pe.nombre AS periodo FROM proyectos p JOIN usuarios u ON u.id=p.estudiante_id JOIN periodos pe ON pe.id=p.periodo_id WHERE p.evaluador_id=CAST(NULLIF(?::text,'') AS bigint) AND (p.titulo LIKE CONCAT('%',?,'%') OR p.codigo LIKE CONCAT('%',?,'%') OR u.nombre LIKE CONCAT('%',?,'%')) AND (?='' OR p.estado=?) AND (?='' OR p.periodo_id=CAST(NULLIF(?::text,'') AS bigint)) AND (?='' OR EXISTS(SELECT 1 FROM evaluaciones ev WHERE ev.proyecto_id=p.id AND ev.tipo=?)) ORDER BY p.modificado_en DESC<sql:param value="${sessionScope.usuarioId}"/><sql:param value="${empty param.buscar ? '' : param.buscar}"/><sql:param value="${empty param.buscar ? '' : param.buscar}"/><sql:param value="${empty param.buscar ? '' : param.buscar}"/><sql:param value="${empty param.estado ? '' : param.estado}"/><sql:param value="${empty param.estado ? '' : param.estado}"/><sql:param value="${empty param.periodo ? '' : param.periodo}"/><sql:param value="${empty param.periodo ? '' : param.periodo}"/><sql:param value="${empty param.tipo ? '' : param.tipo}"/><sql:param value="${empty param.tipo ? '' : param.tipo}"/></sql:query>
<%@ include file="/WEB-INF/jspf/cabecera.jspf" %><h1>Evaluaciones asignadas</h1><p class="sub">Consulta la propuesta, sus documentos y la rejilla institucional.</p><div class="panel"><form method="get" class="actions-inline"><input name="buscar" placeholder="Título, código o estudiante" value="<c:out value='${param.buscar}'/>"><select name="estado"><option value="">Todos los estados</option><option>AVAL_DIRECTOR</option><option>EVALUADA</option><option>INFORME_AVALADO</option><option>EN_EVALUACION_FINAL</option><option>LISTO_SUSTENTACION</option></select><input name="periodo" type="number" min="1" placeholder="ID periodo"><select name="tipo"><option value="">Todas las evaluaciones</option><option value="PROPUESTA">Propuesta</option><option value="INFORME_FINAL">Informe Final</option></select><button>Filtrar</button></form><div class="table-scroll"><table><tr><th>Proyecto</th><th>Estudiante</th><th>Estado</th><th>Evaluación</th></tr><c:forEach var="p" items="${proyectos.rows}"><tr><td><c:out value="${p.titulo}"/><div class="mini"><c:out value="${p.codigo}"/></div></td><td><c:out value="${p.estudiante}"/></td><td>${p.fase} / ${p.estado}</td><td><a class="btn secondary" href="evaluacion.jsp?id=${p.id}">Abrir evaluación</a></td></tr></c:forEach></table></div></div><%@ include file="/WEB-INF/jspf/pie.jspf" %>
