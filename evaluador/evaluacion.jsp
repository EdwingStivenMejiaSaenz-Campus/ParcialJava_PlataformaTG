<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ include file="/WEB-INF/jspf/seguridad.jspf" %><c:if test="${sessionScope.rol ne 'EVALUADOR' and sessionScope.rol ne 'DIRECTOR'}"><c:redirect url="/dashboard.jsp"><c:param name="error" value="acceso"/></c:redirect></c:if><%@ include file="/WEB-INF/jspf/conexion.jspf" %>
<sql:query var="proyecto" dataSource="${db}">SELECT p.*,u.nombre AS estudiante,u.identificacion AS estudiante_identificacion,pr.nombre AS programa,periodo.nombre AS periodo,g.nombre AS grupo,l.nombre AS linea,m.nombre AS modalidad FROM proyectos p JOIN usuarios u ON u.id=p.estudiante_id JOIN programas pr ON pr.id=p.programa_id JOIN periodos periodo ON periodo.id=p.periodo_id LEFT JOIN grupos_investigacion g ON g.id=p.grupo_id LEFT JOIN lineas_investigacion l ON l.id=p.linea_id JOIN modalidades m ON m.id=p.modalidad_id WHERE p.id=CAST(NULLIF(?::text,'') AS bigint) AND (p.evaluador_id=CAST(NULLIF(?::text,'') AS bigint) OR (p.evaluador_propuesta_excepcion_id=CAST(NULLIF(?::text,'') AS bigint) AND p.fase='PROPUESTA'))<sql:param value="${param.id}"/><sql:param value="${sessionScope.usuarioId}"/><sql:param value="${sessionScope.usuarioId}"/></sql:query><c:if test="${empty proyecto.rows}"><c:redirect url="/dashboard.jsp"><c:param name="error" value="acceso"/></c:redirect></c:if><c:set var="p" value="${proyecto.rows[0]}"/>
<c:set var="tipo" value="${p.fase eq 'INFORME_FINAL' or p.fase eq 'SUSTENTACION' ? 'INFORME_FINAL' : 'PROPUESTA'}"/>
<sql:query var="evs" dataSource="${db}">SELECT * FROM evaluaciones WHERE proyecto_id=CAST(NULLIF(?::text,'') AS bigint) AND evaluador_id=CAST(NULLIF(?::text,'') AS bigint) AND tipo=? ORDER BY id DESC LIMIT 1<sql:param value="${p.id}"/><sql:param value="${sessionScope.usuarioId}"/><sql:param value="${tipo}"/></sql:query>
<sql:query var="equipo" dataSource="${db}">SELECT u.nombre,u.identificacion,u.nivel,u.plan FROM proyecto_estudiantes pe JOIN usuarios u ON u.id=pe.estudiante_id WHERE pe.proyecto_id=CAST(NULLIF(?::text,'') AS bigint)<sql:param value="${p.id}"/></sql:query><sql:query var="versiones" dataSource="${db}">SELECT * FROM propuestas WHERE proyecto_id=CAST(NULLIF(?::text,'') AS bigint) ORDER BY version DESC<sql:param value="${p.id}"/></sql:query>
<sql:query var="items" dataSource="${db}">SELECT c.*,ec.cumple AS respuesta,ec.observacion AS comentario FROM criterios c LEFT JOIN evaluacion_criterios ec ON ec.criterio_id=c.id AND ec.evaluacion_id=CAST(NULLIF(?::text,'') AS bigint) WHERE (c.modalidad_id IS NULL OR c.modalidad_id=CAST(NULLIF(?::text,'') AS bigint)) AND c.tipo=? ORDER BY c.id<sql:param value="${not empty evs.rows ? evs.rows[0].id : 0}"/><sql:param value="${p.modalidad_id}"/><sql:param value="${tipo}"/></sql:query>
<%@ include file="/WEB-INF/jspf/cabecera.jspf" %><h1>Evaluar trabajo de grado</h1><p class="sub"><c:out value="${p.titulo}"/> · <c:out value="${p.estudiante}"/> · <c:out value="${p.modalidad}"/></p>
<div class="panel"><h2>Expediente</h2><p>Código: <c:out value="${p.codigo}"/> · Programa: <c:out value="${p.programa}"/> · Periodo: <c:out value="${p.periodo}"/></p><p>Grupo: <c:out value="${p.grupo}"/> · Línea: <c:out value="${p.linea}"/></p><p>Equipo: <c:forEach var="miembro" items="${equipo.rows}"><c:out value="${miembro.nombre}"/> (<c:out value="${miembro.identificacion}"/>), </c:forEach></p><p>Tipo: <strong><c:out value="${tipo}"/></strong> · Estado: <strong><c:out value="${p.estado}"/></strong></p><c:forEach var="v" items="${versiones.rows}"><p>Propuesta versión ${v.version}: <c:choose><c:when test="${not empty v.fdc124_url}"><a href="<c:out value='${v.fdc124_url}'/>" rel="noopener noreferrer" target="_blank">Consultar F-DC-124</a></c:when><c:otherwise><a href="../comun/historial.jsp?id=${p.id}">Consultar adjuntos F-DC-124</a></c:otherwise></c:choose></p></c:forEach><h3>Documentos asociados</h3><sql:query var="documentos" dataSource="${db}">SELECT d.* FROM documentos d WHERE d.proyecto_id=CAST(NULLIF(?::text,'') AS bigint) ORDER BY d.fecha DESC<sql:param value="${p.id}"/></sql:query><c:forEach var="d" items="${documentos.rows}"><p><c:choose><c:when test="${not empty d.archivo_token}"><a href="../comun/archivo.jsp?token=<c:out value='${d.archivo_token}'/>"><c:out value="${d.nombre}"/></a></c:when><c:otherwise><a href="<c:out value='${d.url}'/>" target="_blank" rel="noopener noreferrer"><c:out value="${d.nombre}"/></a></c:otherwise></c:choose> · <c:out value="${d.tipo}"/></p></c:forEach></div>
<c:choose><c:when test="${empty evs.rows}"><div class="panel"><h2>Iniciar evaluación</h2><c:choose><c:when test="${(tipo eq 'PROPUESTA' and (p.estado eq 'AVAL_DIRECTOR' or p.estado eq 'EN_EVALUACION')) or (tipo eq 'INFORME_FINAL' and (p.estado eq 'INFORME_AVALADO' or p.estado eq 'EN_EVALUACION_FINAL'))}"><form method="post" action="../acciones/guardar.jsp"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="accion" value="evaluacion_iniciar"><input type="hidden" name="proyecto_id" value="${p.id}"><input type="hidden" name="tipo" value="${tipo}"><button>Crear borrador de evaluación</button></form></c:when><c:otherwise><p class="alert error">Este proyecto todavía no se encuentra habilitado para crear la evaluación. <c:choose><c:when test="${p.fase eq 'PROPUESTA' and p.estado eq 'EN_REVISION'}">La propuesta está pendiente del aval del Director. Una vez avalada, podrás crear el borrador desde esta pantalla.</c:when><c:otherwise>Estado actual: <c:out value="${p.estado}"/>. Verifica la fase académica y las autorizaciones correspondientes.</c:otherwise></c:choose></p><a class="btn secondary" href="proyectos.jsp">Volver a mis evaluaciones</a></c:otherwise></c:choose></div></c:when><c:otherwise><c:set var="e" value="${evs.rows[0]}"/><div class="panel"><h2>Rejilla institucional <span class="pill"><c:out value="${e.estado}"/></span></h2><p class="mini">Responde cada indicador aplicable. El concepto APROBADO exige que todos los indicadores sean afirmativos.</p><div class="table-scroll"><table><tr><th>Indicador</th><th>Resultado</th><th>Observación</th><th>Guardar</th></tr><c:forEach var="c" items="${items.rows}"><tr><td><form id="crit_${c.id}" method="post" action="../acciones/guardar.jsp"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="accion" value="evaluacion_criterio"><input type="hidden" name="evaluacion_id" value="${e.id}"><input type="hidden" name="criterio_id" value="${c.id}"><c:out value="${c.nombre}"/></form></td><td><select form="crit_${c.id}" name="cumple" <c:if test="${e.estado eq 'DEFINITIVA'}">disabled</c:if>><option value="">Sin responder</option><option value="1" <c:if test="${c.respuesta eq 1}">selected</c:if>>Sí cumple</option><option value="0" <c:if test="${c.respuesta eq 0}">selected</c:if>>No cumple</option></select></td><td><input form="crit_${c.id}" name="observacion" value="<c:out value='${c.comentario}'/>" <c:if test="${e.estado eq 'DEFINITIVA'}">disabled</c:if>></td><td><button form="crit_${c.id}" <c:if test="${e.estado eq 'DEFINITIVA'}">disabled</c:if>>Guardar</button></td></tr></c:forEach></table></div></div><div class="panel"><h2>Concepto final</h2><c:choose><c:when test="${e.estado eq 'BORRADOR'}"><form method="post" action="../acciones/guardar.jsp"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="accion" value="evaluacion_finalizar"><input type="hidden" name="evaluacion_id" value="${e.id}"><div class="field"><label>Concepto</label><select name="concepto"><option value="APROBADO">Aprobado</option><option value="NO_APROBADO">No aprobado</option><option value="CORRECCIONES">Solicitar correcciones</option></select></div><div class="field"><label>Observaciones generales</label><textarea name="observaciones" required></textarea></div><div class="field"><label>Resultado Turnitin (si aplica)</label><input name="similitud" maxlength="120"></div><div class="buttons"><button>Enviar evaluación definitiva</button></div></form></c:when><c:otherwise><p><strong><c:out value="${e.concepto}"/></strong></p><p><c:out value="${e.observaciones}"/></p><p class="mini">Fecha: ${e.enviado_en}</p></c:otherwise></c:choose></div><c:if test="${e.estado eq 'DEFINITIVA' and ((tipo eq 'PROPUESTA' and (p.estado eq 'AVAL_DIRECTOR' or p.estado eq 'EN_EVALUACION')) or (tipo eq 'INFORME_FINAL' and (p.estado eq 'INFORME_AVALADO' or p.estado eq 'EN_EVALUACION_FINAL')))}"><div class="panel"><h2>Nueva evaluación de <c:out value="${tipo eq 'PROPUESTA' ? 'propuesta' : 'informe final'}"/></h2><p>La nueva versión recibió autorización para volver a evaluación. La evaluación anterior permanece registrada en el historial.</p><form method="post" action="../acciones/guardar.jsp"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="accion" value="evaluacion_iniciar"><input type="hidden" name="proyecto_id" value="${p.id}"><input type="hidden" name="tipo" value="${tipo}"><button>Crear borrador de evaluación</button></form></div></c:if></c:otherwise></c:choose><%@ include file="/WEB-INF/jspf/pie.jspf" %>
