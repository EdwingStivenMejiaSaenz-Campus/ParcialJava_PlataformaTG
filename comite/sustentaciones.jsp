<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ include file="/WEB-INF/jspf/seguridad.jspf" %><c:if test="${sessionScope.rol ne 'COMITE'}"><c:redirect url="/dashboard.jsp"><c:param name="error" value="acceso"/></c:redirect></c:if><%@ include file="/WEB-INF/jspf/conexion.jspf" %>
<sql:query var="proyectos" dataSource="${db}">SELECT id,codigo,titulo FROM proyectos WHERE fase IN ('INFORME_FINAL','SUSTENTACION') ORDER BY id DESC</sql:query><sql:query var="sustentaciones" dataSource="${db}">SELECT s.*,p.codigo,p.titulo FROM sustentaciones s JOIN proyectos p ON p.id=s.proyecto_id ORDER BY s.fecha DESC</sql:query>
<%@ include file="/WEB-INF/jspf/cabecera.jspf" %><h1>Sustentaciones</h1><p class="sub">Programación y control de actividades del proceso de grado.</p><div class="panel"><h2>Programar sustentación</h2><form method="post" action="../acciones/guardar.jsp"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="accion" value="sustentacion_crear"><div class="form-grid"><div class="field"><label>Proyecto</label><select name="proyecto_id"><c:forEach var="p" items="${proyectos.rows}"><option value="${p.id}"><c:out value="${p.codigo}"/> - <c:out value="${p.titulo}"/></option></c:forEach></select></div><div class="field"><label>Fecha y hora</label><input type="datetime-local" name="fecha" required></div><div class="field"><label>Lugar o medio</label><input name="lugar" required maxlength="250"></div><div class="field wide"><label>Participantes</label><textarea name="participantes" required></textarea></div></div><div class="buttons"><button>Programar</button></div></form></div><div class="panel table-scroll"><h2>Calendario de sustentaciones</h2><table><tr><th>Proyecto</th><th>Fecha</th><th>Lugar</th><th>Estado</th></tr><c:forEach var="s" items="${sustentaciones.rows}"><tr><td><c:out value="${s.titulo}"/></td><td>${s.fecha}</td><td><c:out value="${s.lugar}"/></td><td><form method="post" action="../acciones/guardar.jsp" class="actions-inline"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="accion" value="sustentacion_estado"><input type="hidden" name="id" value="${s.id}"><select name="estado"><option value="PROGRAMADA">Programada</option><option value="REALIZADA" <c:if test="${s.estado eq 'REALIZADA'}">selected</c:if>>Realizada</option><option value="CANCELADA" <c:if test="${s.estado eq 'CANCELADA'}">selected</c:if>>Cancelada</option></select><button>Guardar</button></form></td></tr></c:forEach></table></div><%@ include file="/WEB-INF/jspf/pie.jspf" %>
