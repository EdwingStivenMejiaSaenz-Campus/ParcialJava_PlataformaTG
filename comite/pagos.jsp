<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ include file="/WEB-INF/jspf/seguridad.jspf" %><c:if test="${sessionScope.rol ne 'COMITE'}"><c:redirect url="/dashboard.jsp"/></c:if><%@ include file="/WEB-INF/jspf/conexion.jspf" %>
<sql:query var="pagos" dataSource="${db}">SELECT pg.*,u.nombre AS estudiante,p.codigo,p.titulo,pe.fin AS fin_periodo,CASE WHEN pg.estado='VALIDADO' AND EXISTS(SELECT 1 FROM reglas_pagos rp JOIN periodos origen ON origen.id=pg.periodo_id WHERE rp.modalidad_id=pg.modalidad_id AND rp.plan=u.plan AND rp.activo=1 AND (SELECT COUNT(*) FROM periodos z WHERE z.inicio>=origen.inicio AND z.inicio<=CURRENT_DATE)>rp.periodos_vigencia) THEN 'VENCIDO' ELSE pg.estado END AS estado_vigente FROM pagos pg JOIN usuarios u ON u.id=pg.estudiante_id JOIN proyectos p ON p.id=pg.proyecto_id JOIN periodos pe ON pe.id=pg.periodo_id ORDER BY pg.id DESC LIMIT 200</sql:query>
<%@ include file="/WEB-INF/jspf/cabecera.jspf" %><h1>Fase 1 · Validar pagos</h1><p><a class="btn secondary" href="asignaciones.jsp">Asignar Director y Evaluador al proyecto ↗</a></p><p class="sub">Abre el enlace de Google Drive del comprobante y valida o rechaza el pago. Al validar se habilita la fase 2 para que los estudiantes entreguen su F-DC-124 por enlace.</p><div class="panel table-scroll"><table><tr><th>Estudiante / proyecto</th><th>Referencia / fecha</th><th>Estado</th><th>Acciones</th></tr><c:forEach var="p" items="${pagos.rows}"><tr><td><c:out value="${p.estudiante}"/> · <c:out value="${p.codigo}"/><div><c:out value="${p.titulo}"/></div></td><td><c:out value="${p.referencia}"/> · ${p.fecha_pago}<c:if test="${not empty p.archivo_token}"><p><a href="../comun/archivo.jsp?token=${p.archivo_token}">Ver comprobante</a></p></c:if><c:if test="${not empty p.url}"><p><a href="<c:out value='${p.url}'/>" rel="noopener noreferrer" target="_blank">Ver enlace</a></p></c:if></td><td><c:out value="${p.estado_vigente}"/><div class="mini">Periodo hasta ${p.fin_periodo}</div></td><td><c:if test="${p.estado eq 'PENDIENTE'}"><form method="post" action="../acciones/guardar.jsp" class="actions-inline"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="accion" value="pago_validar"><input type="hidden" name="id" value="${p.id}"><select name="estado"><option value="VALIDADO">Aceptar pago · pasar a Fase 2</option><option value="RECHAZADO">Rechazar</option></select><button>Guardar</button></form></c:if></td></tr></c:forEach></table></div><%@ include file="/WEB-INF/jspf/pie.jspf" %>