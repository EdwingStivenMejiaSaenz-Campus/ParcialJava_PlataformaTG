<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ include file="/WEB-INF/jspf/seguridad.jspf" %><c:if test="${sessionScope.rol ne 'COMITE'}"><c:redirect url="/dashboard.jsp"><c:param name="error" value="acceso"/></c:redirect></c:if><%@ include file="/WEB-INF/jspf/conexion.jspf" %><sql:query var="p" dataSource="${db}">SELECT * FROM periodos WHERE estado='ACTIVO' ORDER BY inicio DESC LIMIT 1</sql:query><%@ include file="/WEB-INF/jspf/cabecera.jspf" %><h1 class="uts-heading">Configuración <b>GENERAL</b></h1><p class="sub">Aquí podrás ajustar algunos módulos generales del sistema para modificar su comportamiento:</p><div class="uts-columns"><button type="button" class="uts-home-card" data-modal="fechas" style="width:100%"><div class="home-icon">▦</div><strong>Fechas del periodo</strong><p>Ajusta las fechas del periodo académico actual.</p></button><a class="uts-home-card" href="../comun/respaldo_info.jsp"><div class="home-icon">▤</div><strong>Copia de seguridad</strong><p>Consultar configuración del respaldo y restauración.</p></a><a class="uts-home-card" href="periodos.jsp"><div class="home-icon">⚙</div><strong>Periodos académicos</strong><p>Crear, activar y cerrar periodos, banco de ideas y calendario.</p></a></div>
<dialog id="fechas" class="uts-dialog"><div class="uts-dialog-inner"><button class="dialog-close" type="button" data-close-modal>×</button><c:choose><c:when test="${not empty p.rows}"><h2>Fechas del periodo <span class="uts-tag fase"><c:out value="${p.rows[0].nombre}"/></span></h2><form method="post" action="../acciones/guardar.jsp" data-confirm-send><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="accion" value="periodo_actualizar"><input type="hidden" name="id" value="${p.rows[0].id}"><input type="hidden" name="nombre" value="<c:out value='${p.rows[0].nombre}'/>"><input type="hidden" name="inicio" value="${p.rows[0].inicio}"><input type="hidden" name="fin" value="${p.rows[0].fin}"><div class="field"><label>Inicio de propuestas banco</label><input type="date" name="apertura" value="${p.rows[0].apertura_banco}" required></div><div class="field"><label>Fin de propuestas banco</label><input type="date" name="cierre" value="${p.rows[0].cierre_banco}" required></div><p class="uts-small">Las demás fechas del proceso se administran en el calendario académico.</p><div class="dialog-actions"><button type="button" data-close-modal class="cancel-button">Cancelar</button><button class="lime-button" type="submit">Enviar</button></div></form></c:when><c:otherwise><p>Primero crea o activa un periodo académico.</p><a class="btn" href="periodos.jsp">Crear periodo</a></c:otherwise></c:choose></div></dialog><%@ include file="/WEB-INF/jspf/pie.jspf" %>