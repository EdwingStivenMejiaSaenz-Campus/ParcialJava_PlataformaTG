<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ include file="/WEB-INF/jspf/seguridad.jspf" %><c:if test="${sessionScope.rol ne 'COMITE'}"><c:redirect url="/dashboard.jsp"/></c:if><%@ include file="/WEB-INF/jspf/conexion.jspf" %>
<sql:query var="modalidades" dataSource="${db}">SELECT * FROM modalidades WHERE activo=1 ORDER BY nombre</sql:query>
<sql:query var="criterios" dataSource="${db}">SELECT c.*,m.nombre AS modalidad FROM criterios c LEFT JOIN modalidades m ON m.id=c.modalidad_id ORDER BY c.tipo,m.nombre,c.id</sql:query>
<%@ include file="/WEB-INF/jspf/cabecera.jspf" %><h1>Criterios de evaluación</h1><p class="sub">Registrar los indicadores de la rejilla F-DC-124 correspondiente a cada modalidad y etapa; revisar con el formato institucional vigente antes de habilitar.</p><div class="panel"><form action="../acciones/guardar.jsp" method="post" class="form-grid"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="accion" value="criterio_crear"><div class="field"><label>Indicador</label><input name="nombre" required maxlength="160"></div><div class="field"><label>Modalidad</label><select name="modalidad_id"><option value="">Todas</option><c:forEach var="m" items="${modalidades.rows}"><option value="${m.id}"><c:out value="${m.nombre}"/></option></c:forEach></select></div><div class="field"><label>Tipo de evaluación</label><select name="tipo"><option>PROPUESTA</option><option>INFORME_FINAL</option></select></div><div class="field"><label>Indicador obligatorio</label><select name="obligatorio"><option value="1">Sí</option><option value="0">No</option></select></div><button>Registrar criterio</button></form></div><div class="panel table-scroll"><table><tr><th>Tipo</th><th>Modalidad</th><th>Indicador</th><th>Obligatorio</th></tr><c:forEach var="c" items="${criterios.rows}"><tr><td>${c.tipo}</td><td><c:out value="${c.modalidad}" default="Todas"/></td><td><c:out value="${c.nombre}"/></td><td>${(c.obligatorio eq 1) ? 'Sí' : 'No'}</td></tr></c:forEach></table></div><%@ include file="/WEB-INF/jspf/pie.jspf" %>
