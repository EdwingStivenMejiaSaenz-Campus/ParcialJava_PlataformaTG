<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ include file="/WEB-INF/jspf/seguridad.jspf" %><c:if test="${sessionScope.rol ne 'COMITE'}"><c:redirect url="/dashboard.jsp"/></c:if><%@ include file="/WEB-INF/jspf/conexion.jspf" %>
<sql:query var="docentes" dataSource="${db}">SELECT id,nombre,rol FROM usuarios WHERE rol IN('DIRECTOR','EVALUADOR') AND activo=1 ORDER BY nombre</sql:query>
<sql:query var="programas" dataSource="${db}">SELECT id,nombre FROM programas WHERE activo=1 ORDER BY nombre</sql:query>
<sql:query var="perfiles" dataSource="${db}">SELECT pf.*,u.nombre AS docente,pr.nombre AS programa FROM perfiles_docentes pf JOIN usuarios u ON u.id=pf.usuario_id JOIN programas pr ON pr.id=pf.programa_id ORDER BY u.nombre,pr.nombre</sql:query>
<%@ include file="/WEB-INF/jspf/cabecera.jspf" %><h1>Perfil y disponibilidad docente</h1><p class="sub">Registrar quién puede evaluar en cada programa y si se encuentra disponible antes de asignar proyectos.</p>
<div class="panel"><form action="../acciones/guardar.jsp" method="post" class="form-grid"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="accion" value="perfil_docente"><div class="field"><label>Docente</label><select name="usuario_id" required><c:forEach var="d" items="${docentes.rows}"><option value="${d.id}"><c:out value="${d.nombre}"/> · ${d.rol}</option></c:forEach></select></div><div class="field"><label>Programa académico</label><select name="programa_id" required><c:forEach var="p" items="${programas.rows}"><option value="${p.id}"><c:out value="${p.nombre}"/></option></c:forEach></select></div><div class="field"><label>Disponible</label><select name="disponible"><option value="1">Sí</option><option value="0">No</option></select></div><div class="field"><label>Autorizado para evaluar</label><select name="habilitado"><option value="1">Sí</option><option value="0">No</option></select></div><button>Guardar perfil</button></form></div>
<div class="panel table-scroll"><table><tr><th>Docente</th><th>Programa</th><th>Disponible</th><th>Evalúa</th></tr><c:forEach var="pf" items="${perfiles.rows}"><tr><td><c:out value="${pf.docente}"/></td><td><c:out value="${pf.programa}"/></td><td>${(pf.disponible eq 1) ? 'Sí' : 'No'}</td><td>${(pf.habilitado_evaluador eq 1) ? 'Sí' : 'No'}</td></tr></c:forEach></table></div><%@ include file="/WEB-INF/jspf/pie.jspf" %>
