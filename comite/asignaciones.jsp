<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ include file="/WEB-INF/jspf/seguridad.jspf" %><c:if test="${sessionScope.rol ne 'COMITE'}"><c:redirect url="/dashboard.jsp"><c:param name="error" value="acceso"/></c:redirect></c:if><%@ include file="/WEB-INF/jspf/conexion.jspf" %>
<sql:query var="proyectos" dataSource="${db}">SELECT p.*,u.nombre AS estudiante,d.nombre AS director,e.nombre AS evaluador,sd.nombre AS solicitado_director,sc.nombre AS solicitado_codirector FROM proyectos p JOIN usuarios u ON u.id=p.estudiante_id LEFT JOIN usuarios d ON d.id=p.director_id LEFT JOIN usuarios e ON e.id=p.evaluador_id LEFT JOIN usuarios sd ON sd.id=p.solicitud_director_id LEFT JOIN usuarios sc ON sc.id=p.solicitud_codirector_id WHERE (p.titulo LIKE CONCAT('%',?,'%') OR p.codigo LIKE CONCAT('%',?,'%') OR u.nombre LIKE CONCAT('%',?,'%') OR EXISTS(SELECT 1 FROM propuestas v WHERE v.proyecto_id=p.id AND (v.problema LIKE CONCAT('%',?,'%') OR v.justificacion LIKE CONCAT('%',?,'%')))) AND (?='' OR d.nombre LIKE CONCAT('%',?,'%')) AND (?='' OR e.nombre LIKE CONCAT('%',?,'%')) AND (?='' OR p.modalidad_id=CAST(NULLIF(?::text,'') AS bigint)) AND (?='' OR p.fase=?) AND (?='' OR p.estado=?) AND (?='' OR p.periodo_id=CAST(NULLIF(?::text,'') AS bigint)) AND (?='' OR p.programa_id=CAST(NULLIF(?::text,'') AS bigint)) ORDER BY p.id DESC LIMIT 200<sql:param value="${empty param.buscar ? '' : param.buscar}"/><sql:param value="${empty param.buscar ? '' : param.buscar}"/><sql:param value="${empty param.buscar ? '' : param.buscar}"/><sql:param value="${empty param.buscar ? '' : param.buscar}"/><sql:param value="${empty param.buscar ? '' : param.buscar}"/><sql:param value="${empty param.director ? '' : param.director}"/><sql:param value="${empty param.director ? '' : param.director}"/><sql:param value="${empty param.evaluador ? '' : param.evaluador}"/><sql:param value="${empty param.evaluador ? '' : param.evaluador}"/><sql:param value="${empty param.modalidad ? '' : param.modalidad}"/><sql:param value="${empty param.modalidad ? '' : param.modalidad}"/><sql:param value="${empty param.fase ? '' : param.fase}"/><sql:param value="${empty param.fase ? '' : param.fase}"/><sql:param value="${empty param.estado ? '' : param.estado}"/><sql:param value="${empty param.estado ? '' : param.estado}"/><sql:param value="${empty param.periodo ? '' : param.periodo}"/><sql:param value="${empty param.periodo ? '' : param.periodo}"/><sql:param value="${empty param.programa ? '' : param.programa}"/><sql:param value="${empty param.programa ? '' : param.programa}"/></sql:query>
<sql:query var="directores" dataSource="${db}">SELECT id,nombre FROM usuarios WHERE rol='DIRECTOR' AND activo=1 ORDER BY nombre</sql:query><sql:query var="evaluadores" dataSource="${db}">SELECT id,nombre FROM usuarios WHERE rol='EVALUADOR' AND activo=1 ORDER BY nombre</sql:query>
<%@ include file="/WEB-INF/jspf/cabecera.jspf" %><h1>Asignación de docentes</h1><p><a class="btn secondary" href="perfiles.jsp">Configurar perfiles académicos y disponibilidad</a></p><p class="sub">Formaliza director, codirector y evaluador. Los roles se comprueban al guardar.</p><div class="panel"><form method="get" class="actions-inline"><input name="buscar" placeholder="Código, título o estudiante" value="<c:out value='${param.buscar}'/>"><input name="director" placeholder="Director" value="<c:out value='${param.director}'/>"><input name="evaluador" placeholder="Evaluador" value="<c:out value='${param.evaluador}'/>"><input name="modalidad" type="number" placeholder="ID modalidad" min="1" value="<c:out value='${param.modalidad}'/>"><input name="periodo" type="number" placeholder="ID periodo" min="1" value="<c:out value='${param.periodo}'/>"><input name="programa" type="number" placeholder="ID programa" min="1" value="<c:out value='${param.programa}'/>"><select name="fase"><option value="">Todas las fases</option><option>PROPUESTA</option><option>DESARROLLO</option><option>INFORME_FINAL</option><option>SUSTENTACION</option><option>CIERRE</option></select><input name="estado" placeholder="Estado (ej. EVALUADA)" value="<c:out value='${param.estado}'/>"><button>Filtrar</button></form><div class="table-scroll"><table><tr><th>Proyecto</th><th>Director / evaluador actual</th><th>Formalizar asignación</th></tr><c:forEach var="p" items="${proyectos.rows}"><tr><td><strong><c:out value="${p.titulo}"/></strong><div class="mini"><c:out value="${p.codigo}"/> · <c:out value="${p.estudiante}"/></div></td><td><div>Director: <c:out value="${p.director}" default="Pendiente"/></div><div>Evaluador: <c:out value="${p.evaluador}" default="Pendiente"/></div><div class="mini">Solicitud director: <c:out value="${p.solicitado_director}" default="Ninguna"/></div><div class="mini">Solicitud codirector: <c:out value="${p.solicitado_codirector}" default="Ninguna"/></div></td><td><form method="post" action="../acciones/guardar.jsp" class="actions-inline"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="accion" value="asignar_docentes"><input type="hidden" name="proyecto_id" value="${p.id}"><select name="director_id" aria-label="Director"><option value="">Sin director</option><c:forEach var="d" items="${directores.rows}"><option value="${d.id}" <c:if test="${p.director_id eq d.id}">selected</c:if>><c:out value="${d.nombre}"/></option></c:forEach></select><select name="codirector_id" aria-label="Codirector"><option value="">Sin codirector</option><c:forEach var="d" items="${directores.rows}"><option value="${d.id}" <c:if test="${p.codirector_id eq d.id}">selected</c:if>><c:out value="${d.nombre}"/></option></c:forEach></select><select name="evaluador_id" aria-label="Evaluador"><option value="">Sin evaluador</option><c:forEach var="e" items="${evaluadores.rows}"><option value="${e.id}" <c:if test="${p.evaluador_id eq e.id}">selected</c:if>><c:out value="${e.nombre}"/></option></c:forEach></select><button>Asignar</button></form><form method="post" action="../acciones/guardar.jsp" class="actions-inline"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="accion" value="excepcion_integrantes"><input type="hidden" name="proyecto_id" value="${p.id}"><select name="excepcion_tres"><option value="0">Límite: 2</option><option value="1" <c:if test="${(p.excepcion_tres eq 1)}">selected</c:if>>Excepción: 3</option></select><button>Aplicar excepción</button></form><form method="post" action="../acciones/guardar.jsp" class="actions-inline"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="accion" value="excepcion_evaluador_propuesta"><input type="hidden" name="proyecto_id" value="${p.id}"><select name="habilitar"><option value="0">Evaluación separada</option><option value="1" <c:if test="${not empty p.evaluador_propuesta_excepcion_id}">selected</c:if>>Director evalúa propuesta (plan posterior)</option></select><button>Registrar excepción</button></form></td></tr></c:forEach></table></div></div><%@ include file="/WEB-INF/jspf/pie.jspf" %>
