<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ include file="/WEB-INF/jspf/seguridad.jspf" %><%@ include file="/WEB-INF/jspf/conexion.jspf" %>
<sql:query var="ideas" dataSource="${db}">SELECT i.id,i.titulo,i.descripcion,i.estado,i.nivel,i.modalidad_id,pe.nombre AS periodo,pe.estado AS periodo_estado,pe.apertura_banco,pe.cierre_banco,m.nombre AS modalidad FROM ideas i JOIN periodos pe ON pe.id=i.periodo_id LEFT JOIN modalidades m ON m.id=i.modalidad_id WHERE (? IN('COMITE','ADMINISTRADOR','DIRECTOR','EVALUADOR')) OR (?='ESTUDIANTE' AND i.estado='ABIERTA' AND pe.estado='ACTIVO' AND CURRENT_DATE BETWEEN pe.apertura_banco AND pe.cierre_banco AND m.activo=1 AND EXISTS(SELECT 1 FROM usuarios u WHERE u.id=CAST(NULLIF(?::text,'') AS bigint) AND u.activo=1 AND u.rol='ESTUDIANTE' AND u.programa_id=i.programa_id AND (i.nivel IS NULL OR u.nivel IS NULL OR i.nivel=u.nivel) AND NOT EXISTS(SELECT 1 FROM proyectos px JOIN proyecto_estudiantes ep ON ep.proyecto_id=px.id WHERE px.idea_id=i.id AND ep.estudiante_id=u.id AND px.estado NOT IN ('RECHAZADO','FINALIZADO')))) ORDER BY i.id DESC LIMIT 400
<sql:param value="${sessionScope.rol}"/><sql:param value="${sessionScope.rol}"/><sql:param value="${sessionScope.usuarioId}"/></sql:query>
<%@ include file="/WEB-INF/jspf/cabecera.jspf" %><div class="uts-toolbar"><h1 class="uts-heading">Banco de <b>IDEAS</b></h1><div class="uts-toolbuttons"><c:if test="${sessionScope.rol eq 'COMITE'}"><a class="icon-action green" href="../comite/ideas.jsp" title="Gestionar y republicar ideas"><svg class="ui-icon" aria-hidden="true"><use href="${pageContext.request.contextPath}/img/icons.svg#refresh"/></svg> Republicar ideas</a></c:if></div></div>
<div class="uts-searchbar"><label>Mostrar <select data-page-size><option>5</option><option>10</option><option>20</option></select> registros por página</label><label>Buscar: <input type="search" data-filter-table="tablaBanco" placeholder="Ingrese una clave."></label></div>
<div class="table-scroll"><table class="uts-table" id="tablaBanco" data-paginate><thead><tr><th>ID</th><th>Título de la idea</th><th>Disponible</th><th>Periodo</th><th>Nivel</th><th>Acciones</th></tr></thead><tbody><c:forEach var="i" items="${ideas.rows}"><tr><td class="uts-code">BAN-<c:out value="${i.id}"/></td><td><c:out value="${i.titulo}"/><div class="uts-small"><c:out value="${fn:substring(i.descripcion,0,100)}"/></div></td><td><span class="uts-tag ${i.estado eq 'ABIERTA' and i.periodo_estado eq 'ACTIVO' ? 'ok' : 'bad'}">${i.estado eq 'ABIERTA' and i.periodo_estado eq 'ACTIVO' ? 'Sí' : 'No'}</span></td><td><c:out value="${i.periodo}"/></td><td><c:out value="${i.nivel}"/></td><td><div class="act"><button class="icon-action blue" type="button" data-modal="idea-${i.id}" aria-label="Ver idea"><svg class="ui-icon" aria-hidden="true"><use href="${pageContext.request.contextPath}/img/icons.svg#eye"/></svg></button><c:if test="${sessionScope.rol eq 'ESTUDIANTE' and i.estado eq 'ABIERTA'}"><form method="post" action="../acciones/guardar.jsp" class="uts-inline-form"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="accion" value="proyecto_de_idea"><input type="hidden" name="idea_id" value="${i.id}"><button type="submit" class="icon-action green" aria-label="Inscribir esta idea" title="Inscribir esta idea"><svg class="ui-icon" aria-hidden="true"><use href="${pageContext.request.contextPath}/img/icons.svg#check"/></svg></button></form></c:if></div></td></tr></c:forEach></tbody></table></div><div class="uts-list-footer"><span class="uts-small" data-table-status></span><div class="uts-pagination" data-pagination></div></div>
<c:forEach var="i" items="${ideas.rows}"><dialog class="uts-dialog" id="idea-${i.id}"><div class="uts-dialog-inner"><button class="dialog-close" type="button" data-close-modal aria-label="Cerrar">×</button><h2>Detalles de la <span class="uts-tag fase">IDEA</span></h2><dl class="uts-detail-grid"><dt>Título:</dt><dd><c:out value="${i.titulo}"/></dd><dt>Modalidad:</dt><dd><c:out value="${empty i.modalidad ? 'Por definir' : i.modalidad}"/></dd><dt>Objetivo o descripción:</dt><dd><c:out value="${i.descripcion}"/></dd><dt>Nivel:</dt><dd><c:out value="${i.nivel}"/></dd><dt>Periodo:</dt><dd><c:out value="${i.periodo}"/></dd><dt>Disponible:</dt><dd>${i.estado eq 'ABIERTA' ? 'Sí, sujeto al calendario y elegibilidad' : 'No disponible'}</dd></dl><div class="dialog-actions"><button type="button" data-close-modal class="cancel-button">Cerrar</button></div></div></dialog></c:forEach>
<p class="uts-small">El Comité puede abrir o cerrar el Banco de Ideas al final de cada semestre desde periodos. Las fechas y la habilitación académica se validan en el servidor.</p>
<%@ include file="/WEB-INF/jspf/pie.jspf" %>