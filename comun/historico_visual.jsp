<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ include file="/WEB-INF/jspf/seguridad.jspf" %><%@ include file="/WEB-INF/jspf/conexion.jspf" %><sql:query var="historico" dataSource="${db}">SELECT p.id,p.codigo,p.titulo,p.modificado_en,u.nombre AS estudiante FROM proyectos p JOIN usuarios u ON u.id=p.estudiante_id WHERE p.estado='FINALIZADO' AND ((? IN('ADMINISTRADOR','COMITE')) OR (?='ESTUDIANTE' AND EXISTS(SELECT 1 FROM proyecto_estudiantes pe WHERE pe.proyecto_id=p.id AND pe.estudiante_id=CAST(NULLIF(?::text,'') AS bigint))) OR (?='DIRECTOR' AND p.director_id=CAST(NULLIF(?::text,'') AS bigint)) OR (?='EVALUADOR' AND p.evaluador_id=CAST(NULLIF(?::text,'') AS bigint))) ORDER BY p.modificado_en DESC LIMIT 200<sql:param value="${sessionScope.rol}"/><sql:param value="${sessionScope.rol}"/><sql:param value="${sessionScope.usuarioId}"/><sql:param value="${sessionScope.rol}"/><sql:param value="${sessionScope.usuarioId}"/><sql:param value="${sessionScope.rol}"/><sql:param value="${sessionScope.usuarioId}"/></sql:query><%@ include file="/WEB-INF/jspf/cabecera.jspf" %><h1 class="uts-heading">Módulo <b>HISTÓRICO</b></h1><div class="uts-searchbar"><label>Buscar: <input type="search" data-filter-table="tablaHistorico" placeholder="Ingrese una clave."></label></div><div class="table-scroll"><table class="uts-table" id="tablaHistorico"><thead><tr><th>ID</th><th>Descripción</th><th>Estado</th><th>Acciones</th></tr></thead><tbody><c:forEach var="p" items="${historico.rows}"><tr><td><c:out value="${p.codigo}"/></td><td><c:out value="${p.titulo}"/></td><td><span class="uts-tag ok">Finalizado</span></td><td><a class="icon-action blue" href="historial.jsp?id=${p.id}" title="Ver historial"><svg class="ui-icon" aria-hidden="true"><use href="${pageContext.request.contextPath}/img/icons.svg#eye"/></svg></a></td></tr></c:forEach></tbody></table></div><%@ include file="/WEB-INF/jspf/pie.jspf" %>