<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ include file="/WEB-INF/jspf/seguridad.jspf" %><%@ include file="/WEB-INF/jspf/conexion.jspf" %>
<%-- Vista general reservada a la gestión académica. El estudiante usa su expediente privado. --%>
<c:if test="${sessionScope.rol eq 'ESTUDIANTE'}"><c:redirect url="/estudiante/proyectos.jsp"/></c:if>
<c:set var="tipo" value="${param.tipo eq 'practicas' ? 'practicas' : 'proyectos'}"/>
<sql:query var="proyectos" dataSource="${db}">SELECT p.id,p.codigo,p.titulo,p.fase,p.estado,p.director_id,p.evaluador_id,EXISTS(SELECT 1 FROM pagos pp WHERE pp.proyecto_id=p.id AND pp.estado='VALIDADO') AS pago_ok,u.nombre AS estudiante,m.nombre AS modalidad,pe.nombre AS periodo FROM proyectos p JOIN usuarios u ON u.id=p.estudiante_id JOIN modalidades m ON m.id=p.modalidad_id JOIN periodos pe ON pe.id=p.periodo_id
WHERE ((? IN('COMITE','ADMINISTRADOR')) OR (?='ESTUDIANTE' AND EXISTS(SELECT 1 FROM proyecto_estudiantes s WHERE s.proyecto_id=p.id AND s.estudiante_id=CAST(NULLIF(?::text,'') AS bigint))) OR (?='DIRECTOR' AND p.director_id=CAST(NULLIF(?::text,'') AS bigint)) OR (?='EVALUADOR' AND p.evaluador_id=CAST(NULLIF(?::text,'') AS bigint))) AND ((?='practicas' AND m.nombre='Práctica') OR (?='proyectos' AND m.nombre!='Práctica')) ORDER BY p.modificado_en DESC LIMIT 500
<sql:param value="${sessionScope.rol}"/><sql:param value="${sessionScope.rol}"/><sql:param value="${sessionScope.usuarioId}"/><sql:param value="${sessionScope.rol}"/><sql:param value="${sessionScope.usuarioId}"/><sql:param value="${sessionScope.rol}"/><sql:param value="${sessionScope.usuarioId}"/><sql:param value="${tipo}"/><sql:param value="${tipo}"/></sql:query>
<%@ include file="/WEB-INF/jspf/cabecera.jspf" %>
<div class="uts-toolbar"><h1 class="uts-heading"><c:choose><c:when test="${tipo eq 'practicas'}">Prácticas <b>EMPRESARIALES</b></c:when><c:otherwise>Proyectos de <b>GRADO</b></c:otherwise></c:choose></h1><div class="uts-toolbuttons">
<c:if test="${sessionScope.rol eq 'COMITE'}"><a class="icon-action red" href="../comun/reportes.jsp" title="Enviar reporte"><svg class="ui-icon" aria-hidden="true"><use href="${pageContext.request.contextPath}/img/icons.svg#warning"/></svg></a></c:if>
<a href="../comun/calendario.jsp" class="icon-action green" title="Calendario académico"><svg class="ui-icon" aria-hidden="true"><use href="${pageContext.request.contextPath}/img/icons.svg#calendar"/></svg></a><c:if test="${sessionScope.rol eq 'COMITE'}"><a href="../comite/decisiones.jsp" class="icon-action dark" title="Gestión de proyectos"><svg class="ui-icon" aria-hidden="true"><use href="${pageContext.request.contextPath}/img/icons.svg#settings"/></svg></a></c:if></div></div>
<form class="uts-searchbar" method="get"><input type="hidden" name="tipo" value="${tipo}"><label>Seleccione un filtro <select name="estado" id="estadoTabla"><option value="">Todos</option><option value="COMITE">Pendientes Comité</option><option value="ESTUDIANTE">Pendientes Estudiante</option><option value="DIRECTOR">Pendientes Director</option><option value="EVALUADOR">Pendientes Evaluador</option><option value="FINALIZADO">Finalizados</option></select></label><label>Mostrar <select data-page-size><option>5</option><option>10</option><option>20</option></select> registros por página</label><label>Buscar: <input type="search" data-filter-table="tablaProyectos" placeholder="Ingrese una clave." aria-label="Buscar por código, título o estado"></label></form>
<div class="table-scroll"><table class="uts-table" id="tablaProyectos" data-paginate><thead><tr><th>ID</th><th>Descripción</th><th>Estado</th><th>Acciones</th></tr></thead><tbody>
<c:forEach var="p" items="${proyectos.rows}"><tr data-status="${p.estado}" data-owner="${p.estado eq 'BORRADOR' ? 'ESTUDIANTE' : (p.estado eq 'EN_REVISION' or p.estado eq 'INFORME_EN_REVISION' ? 'DIRECTOR' : (p.estado eq 'EN_EVALUACION' or p.estado eq 'EN_EVALUACION_FINAL' ? 'EVALUADOR' : (p.estado eq 'EVALUADA' or p.estado eq 'LISTO_SUSTENTACION' ? 'COMITE' : (p.estado eq 'FINALIZADO' ? 'FINALIZADO' : 'ESTUDIANTE'))))}"><td class="uts-code"><c:out value="${p.codigo}"/></td><td><c:out value="${p.titulo}"/><div class="uts-small"><c:out value="${p.estudiante}"/> · <c:out value="${p.periodo}"/></div></td>
<td><span class="uts-tag fase"><c:choose><c:when test="${p.estado eq 'FINALIZADO'}">Finalizado</c:when><c:when test="${p.fase eq 'PROPUESTA' and p.estado eq 'BORRADOR' and not p.pago_ok}">Fase 1</c:when><c:when test="${p.fase eq 'PROPUESTA' and (p.estado eq 'BORRADOR' or p.estado eq 'EN_REVISION')}">Fase 2</c:when><c:when test="${p.fase eq 'PROPUESTA'}">Fase 3</c:when><c:when test="${p.fase eq 'DESARROLLO' or p.estado eq 'INFORME_EN_REVISION'}">Fase 4</c:when><c:otherwise>Fase 5</c:otherwise></c:choose></span> <c:if test="${p.estado ne 'FINALIZADO'}"><span class="uts-tag responsable"><c:choose>
<c:when test="${p.estado eq 'EN_REVISION' or p.estado eq 'INFORME_EN_REVISION'}">Director</c:when>
<c:when test="${p.estado eq 'EN_EVALUACION' or p.estado eq 'EN_EVALUACION_FINAL'}">Evaluador</c:when>
<c:when test="${p.estado eq 'EVALUADA' or p.estado eq 'LISTO_SUSTENTACION'}">Comité</c:when>
<c:otherwise>Estudiante</c:otherwise></c:choose></span></c:if></td>
<td><div class="act"><a class="icon-action blue" href="expediente.jsp?id=${p.id}" data-detail title="Ver detalles" aria-label="Ver detalles del proyecto"><svg class="ui-icon" aria-hidden="true"><use href="${pageContext.request.contextPath}/img/icons.svg#eye"/></svg></a><a class="icon-action sky" href="seguimiento.jsp?id=${p.id}" title="Mapa de fases" aria-label="Seguimiento de fases"><svg class="ui-icon" aria-hidden="true"><use href="${pageContext.request.contextPath}/img/icons.svg#list"/></svg></a><c:if test="${sessionScope.rol eq 'COMITE'}"><a class="icon-action red" href="reportes.jsp?proyecto_id=${p.id}" title="Enviar reporte" aria-label="Enviar reporte"><svg class="ui-icon" aria-hidden="true"><use href="${pageContext.request.contextPath}/img/icons.svg#warning"/></svg></a></c:if></div></td></tr></c:forEach>
</tbody></table></div>
<div class="uts-list-footer"><span class="uts-small" data-table-status></span><div class="uts-pagination" data-pagination></div></div>
<dialog class="uts-dialog" id="modal-expediente" aria-label="Detalles del proyecto"><div class="uts-dialog-inner"><button class="dialog-close" type="button" data-close-modal aria-label="Cerrar">×</button><div data-modal-content>Abriendo expediente…</div></div></dialog>
<%@ include file="/WEB-INF/jspf/pie.jspf" %>