<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ include file="/WEB-INF/jspf/seguridad.jspf" %><%@ include file="/WEB-INF/jspf/conexion.jspf" %>
<sql:query var="eventos" dataSource="${db}">SELECT c.*,p.nombre AS periodo FROM calendario c JOIN periodos p ON p.id=c.periodo_id ORDER BY c.inicio DESC LIMIT 100</sql:query>
<%@ include file="/WEB-INF/jspf/cabecera.jspf" %><h1>Calendario académico</h1><p class="sub">Periodos, fechas y plazos del proceso de grado.</p><div class="panel table-scroll"><table><tr><th>Periodo</th><th>Actividad o fase</th><th>Inicio</th><th>Cierre</th></tr><c:forEach var="e" items="${eventos.rows}"><tr><td><c:out value="${e.periodo}"/></td><td><c:out value="${e.actividad}"/></td><td><c:out value="${e.inicio}"/></td><td><c:out value="${e.fin}"/></td></tr></c:forEach></table></div><%@ include file="/WEB-INF/jspf/pie.jspf" %>
