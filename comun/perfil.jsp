<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ include file="/WEB-INF/jspf/seguridad.jspf" %><%@ include file="/WEB-INF/jspf/conexion.jspf" %><sql:query var="p" dataSource="${db}">SELECT u.nombre,u.correo,u.identificacion,u.rol,u.nivel,u.plan,u.creditos,pr.nombre AS programa FROM usuarios u LEFT JOIN programas pr ON pr.id=u.programa_id WHERE u.id=CAST(NULLIF(?::text,'') AS bigint) LIMIT 1<sql:param value="${sessionScope.usuarioId}"/></sql:query><%@ include file="/WEB-INF/jspf/cabecera.jspf" %><h1 class="uts-heading">Mi <b>PERFIL</b></h1><div class="panel" style="max-width:750px"><dl class="uts-detail-grid"><dt>Nombre:</dt><dd><c:out value="${p.rows[0].nombre}"/></dd><dt>Correo:</dt><dd><c:out value="${p.rows[0].correo}"/></dd><dt>Identificación:</dt><dd><c:out value="${p.rows[0].identificacion}"/></dd><dt>Rol:</dt><dd><c:out value="${p.rows[0].rol}"/></dd><dt>Programa:</dt><dd><c:out value="${p.rows[0].programa}"/></dd><dt>Nivel:</dt><dd><c:out value="${p.rows[0].nivel}"/></dd><dt>Plan:</dt><dd><c:out value="${p.rows[0].plan}"/></dd><dt>Créditos:</dt><dd>${p.rows[0].creditos}%</dd></dl><p class="uts-info-notice">El Administrador actualiza los datos de tu cuenta y la información académica.</p></div><%@ include file="/WEB-INF/jspf/pie.jspf" %>