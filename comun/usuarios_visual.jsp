<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ include file="/WEB-INF/jspf/seguridad.jspf" %><c:if test="${sessionScope.rol ne 'COMITE'}"><c:redirect url="/dashboard.jsp"><c:param name="error" value="acceso"/></c:redirect></c:if><%@ include file="/WEB-INF/jspf/conexion.jspf" %><sql:query var="u" dataSource="${db}">SELECT id,nombre,rol,activo FROM usuarios ORDER BY id DESC LIMIT 300</sql:query><%@ include file="/WEB-INF/jspf/cabecera.jspf" %><h1 class="uts-heading">Consulta de <b>USUARIOS</b></h1><p class="uts-small">El Comité puede consultar los perfiles institucionales. La creación, cambio de roles y activación de usuarios corresponde únicamente al Administrador.</p><div class="uts-searchbar"><label>Buscar: <input type="search" data-filter-table="tablaUsuarios" placeholder="Ingrese una clave."></label></div><div class="table-scroll"><table class="uts-table" id="tablaUsuarios"><thead><tr><th>ID</th><th>Nombre</th><th>Roles</th><th>Estado</th></tr></thead><tbody><c:forEach var="a" items="${u.rows}"><tr><td><c:out value="${a.id}"/></td><td><c:out value="${a.nombre}"/></td><td><span class="uts-tag fase"><c:out value="${a.rol}"/></span></td><td>${(a.activo eq 1) ? 'Activo' : 'Inactivo'}</td></tr></c:forEach></tbody></table></div><%@ include file="/WEB-INF/jspf/pie.jspf" %>