<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ include file="/WEB-INF/jspf/seguridad.jspf" %>
<c:if test="${sessionScope.rol ne 'ADMINISTRADOR'}"><c:redirect url="/dashboard.jsp"><c:param name="error" value="acceso"/></c:redirect></c:if>
<%@ include file="/WEB-INF/jspf/conexion.jspf" %>
<sql:query var="programas" dataSource="${db}">SELECT * FROM programas WHERE activo=1 ORDER BY nombre</sql:query>
<%@ include file="/WEB-INF/jspf/cabecera.jspf" %>
<div class="panel" style="max-width:1000px;margin:auto">
<h1 class="uts-heading">Crear nuevo <b>USUARIO</b></h1>
<p class="sub">Registra el usuario y sus datos académicos. La contraseña provisional debe tener al menos 12 caracteres.</p>
<form method="post" action="../acciones/guardar.jsp"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="accion" value="usuario_crear"><div class="form-grid"><div class="field"><label>Identificación</label><input name="identificacion" required maxlength="30"></div><div class="field"><label>Nombre</label><input name="nombre" required maxlength="160"></div><div class="field"><label>Correo</label><input type="email" name="correo" required maxlength="160"></div><div class="field"><label>Contraseña provisional</label><input type="password" name="clave" minlength="12" required></div><div class="field"><label>Rol</label><select name="rol" required><option value="ESTUDIANTE">Estudiante</option><option value="DIRECTOR">Docente director</option><option value="EVALUADOR">Docente evaluador</option><option value="COMITE">Comité</option><option value="ADMINISTRADOR">Administrador</option></select></div><div class="field"><label>Programa</label><select name="programa_id"><option value="">No aplica</option><c:forEach items="${programas.rows}" var="p"><option value="${p.id}"><c:out value="${p.nombre}"/></option></c:forEach></select></div><div class="field"><label>Nivel académico</label><select name="nivel"><option value="">No aplica</option><option value="TECNICO">Técnico profesional</option><option value="TECNOLOGO">Tecnología</option><option value="PROFESIONAL">Profesional</option></select></div><div class="field"><label>Plan</label><select name="plan"><option value="">No aplica</option><option value="ANTERIOR">Anterior al Decreto 1330</option><option value="POSTERIOR">Posterior al Decreto 1330</option></select></div><div class="field"><label>Créditos aprobados (%)</label><input type="number" name="creditos" value="0" min="0" max="100"></div><div class="field"><label>Metodología aprobada</label><select name="metodologia"><option value="0">No</option><option value="1">Sí</option></select></div><div class="field"><label>Seminarios aprobados I, II, III, IV</label><div class="actions-inline"><label><input type="checkbox" name="s1" value="1"> I</label><label><input type="checkbox" name="s2" value="1"> II</label><label><input type="checkbox" name="s3" value="1"> III</label><label><input type="checkbox" name="s4" value="1"> IV</label></div><div class="actions-inline"><label><input type="checkbox" name="m1" value="1"> Matrícula Seminario I</label><label><input type="checkbox" name="m3" value="1"> Matrícula Seminario III</label></div></div></div><div class="dialog-actions"><a class="btn secondary" href="usuarios.jsp">Cancelar</a><button class="lime-button">Crear usuario</button></div></form>
</div>
<%@ include file="/WEB-INF/jspf/pie.jspf" %>
