<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ include file="/WEB-INF/jspf/seguridad.jspf" %><c:if test="${sessionScope.rol ne 'ADMINISTRADOR'}"><c:redirect url="/dashboard.jsp"><c:param name="error" value="acceso"/></c:redirect></c:if><%@ include file="/WEB-INF/jspf/conexion.jspf" %><sql:query var="programas" dataSource="${db}">SELECT * FROM programas ORDER BY nombre</sql:query>
<%@ include file="/WEB-INF/jspf/cabecera.jspf" %><h1>Catálogos académicos</h1><p class="sub">Programas de formación utilizados en el registro de estudiantes.</p><div class="panel"><form method="post" action="../acciones/guardar.jsp" class="form-grid"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="accion" value="programa_crear"><div class="field"><label>Programa académico</label><input name="nombre" required maxlength="160"></div><div class="field"><label>&nbsp;</label><button>Registrar programa</button></div></form></div><div class="panel table-scroll"><table><tr><th>ID</th><th>Programa</th><th>Activo</th></tr><c:forEach var="p" items="${programas.rows}"><tr><td>${p.id}</td><td><c:out value="${p.nombre}"/></td><td><c:out value="${p.activo}"/></td></tr></c:forEach></table></div><%@ include file="/WEB-INF/jspf/pie.jspf" %>
