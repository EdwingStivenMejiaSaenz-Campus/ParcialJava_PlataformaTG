<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ include file="/WEB-INF/jspf/seguridad.jspf" %><c:if test="${sessionScope.rol ne 'ADMINISTRADOR'}"><c:redirect url="/dashboard.jsp"><c:param name="error" value="acceso"/></c:redirect></c:if><%@ include file="/WEB-INF/jspf/conexion.jspf" %>
<sql:query var="usuarios" dataSource="${db}">SELECT u.*,pr.nombre AS programa FROM usuarios u LEFT JOIN programas pr ON pr.id=u.programa_id WHERE (u.nombre LIKE CONCAT('%',?,'%') OR u.correo LIKE CONCAT('%',?,'%') OR u.identificacion LIKE CONCAT('%',?,'%')) AND (?='' OR u.rol=?) AND (?='' OR u.activo=CAST(NULLIF(?::text,'') AS smallint)) AND (?='' OR u.programa_id=CAST(NULLIF(?::text,'') AS bigint)) AND (?='' OR u.nivel=?) AND (?='' OR u.plan=?) ORDER BY u.id DESC LIMIT 200
<sql:param value="${empty param.buscar ? '' : param.buscar}"/><sql:param value="${empty param.buscar ? '' : param.buscar}"/><sql:param value="${empty param.buscar ? '' : param.buscar}"/><sql:param value="${empty param.rol ? '' : param.rol}"/><sql:param value="${empty param.rol ? '' : param.rol}"/><sql:param value="${empty param.activo ? '' : param.activo}"/><sql:param value="${empty param.activo ? '' : param.activo}"/><sql:param value="${empty param.programa ? '' : param.programa}"/><sql:param value="${empty param.programa ? '' : param.programa}"/><sql:param value="${empty param.nivel ? '' : param.nivel}"/><sql:param value="${empty param.nivel ? '' : param.nivel}"/><sql:param value="${empty param.plan ? '' : param.plan}"/><sql:param value="${empty param.plan ? '' : param.plan}"/></sql:query>
<sql:query var="programas" dataSource="${db}">SELECT * FROM programas WHERE activo=1 ORDER BY nombre</sql:query>

<%@ include file="/WEB-INF/jspf/cabecera.jspf" %>
<div class="uts-toolbar"><h1 class="uts-heading">Gestión de <b>USUARIOS</b></h1>
 <a class="icon-action green" href="nuevo_usuario.jsp"><svg class="ui-icon"><use href="${pageContext.request.contextPath}/img/icons.svg#users"/></svg> + Crear nuevo usuario</a>
</div>
<div class="uts-searchbar"><label>Mostrar <select data-page-size><option>5</option><option>10</option><option>20</option></select> registros por página</label>
<label>Buscar: <input type="search" data-filter-table="tablaUsuarios" placeholder="Ingrese una clave" aria-label="Buscar usuarios"/></label></div>
<div class="table-scroll"><table class="uts-table" id="tablaUsuarios" data-paginate><thead><tr><th>ID</th><th>Nombre</th><th>Correo</th><th>Roles</th><th>Estado</th><th>Acciones</th></tr></thead><tbody>
<c:forEach var="u" items="${usuarios.rows}"><tr><td class="uts-code"><c:out value="${u.id}"/></td><td><c:out value="${u.nombre}"/></td><td><c:out value="${u.correo}"/></td><td><span class="uts-tag fase"><c:out value="${u.rol}"/></span></td><td><span class="uts-tag ${u.activo eq 1 ? 'ok' : 'bad'}">${u.activo eq 1 ? 'Activo' : 'Inactivo'}</span></td>
<td><div class="act"><button type="button" class="icon-action green" data-modal="editar-usuario-${u.id}" aria-label="Editar usuario" title="Editar usuario"><svg class="ui-icon"><use href="${pageContext.request.contextPath}/img/icons.svg#edit"/></svg></button>
<button type="button" class="icon-action blue" data-modal="detalle-usuario-${u.id}" title="Ver perfil" aria-label="Ver perfil"><svg class="ui-icon"><use href="${pageContext.request.contextPath}/img/icons.svg#user"/></svg></button>
<button type="button" class="icon-action red" data-disable-user="editar-usuario-${u.id}" title="Desactivar usuario" aria-label="Desactivar usuario"><svg class="ui-icon"><use href="${pageContext.request.contextPath}/img/icons.svg#trash"/></svg></button></div></td></tr></c:forEach>
</tbody></table></div>
<div class="uts-list-footer"><span class="uts-small" data-table-status></span><div class="uts-pagination" data-pagination></div></div>
<dialog class="uts-dialog" id="nuevo-usuario"><div class="uts-dialog-inner"><button type="button" class="dialog-close" data-close-modal aria-label="Cerrar">×</button><h2>Crear <span class="uts-tag fase">USUARIO</span></h2><form method="post" action="../acciones/guardar.jsp"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="accion" value="usuario_crear"><div class="form-grid"><div class="field"><label>Identificación</label><input name="identificacion" required maxlength="30"></div><div class="field"><label>Nombre</label><input name="nombre" required maxlength="160"></div><div class="field"><label>Correo</label><input type="email" name="correo" required maxlength="160"></div><div class="field"><label>Contraseña provisional</label><input type="password" name="clave" minlength="12" required></div><div class="field"><label>Rol</label><select name="rol" required><option value="ESTUDIANTE">Estudiante</option><option value="DIRECTOR">Docente director</option><option value="EVALUADOR">Docente evaluador</option><option value="COMITE">Comité</option><option value="ADMINISTRADOR">Administrador</option></select></div><div class="field"><label>Programa</label><select name="programa_id"><option value="">No aplica</option><c:forEach items="${programas.rows}" var="p"><option value="${p.id}"><c:out value="${p.nombre}"/></option></c:forEach></select></div><div class="field"><label>Nivel académico</label><select name="nivel"><option value="">No aplica</option><option value="TECNICO">Técnico profesional</option><option value="TECNOLOGO">Tecnología</option><option value="PROFESIONAL">Profesional</option></select></div><div class="field"><label>Plan</label><select name="plan"><option value="">No aplica</option><option value="ANTERIOR">Anterior al Decreto 1330</option><option value="POSTERIOR">Posterior al Decreto 1330</option></select></div><div class="field"><label>Créditos aprobados (%)</label><input type="number" name="creditos" value="0" min="0" max="100"></div><div class="field"><label>Metodología aprobada</label><select name="metodologia"><option value="0">No</option><option value="1">Sí</option></select></div><div class="field"><label>Seminarios aprobados I, II, III, IV</label><div class="actions-inline"><label><input type="checkbox" name="s1" value="1"> I</label><label><input type="checkbox" name="s2" value="1"> II</label><label><input type="checkbox" name="s3" value="1"> III</label><label><input type="checkbox" name="s4" value="1"> IV</label></div><div class="actions-inline"><label><input type="checkbox" name="m1" value="1"> Matrícula Seminario I</label><label><input type="checkbox" name="m3" value="1"> Matrícula Seminario III</label></div></div></div><div class="dialog-actions"><button type="button" class="cancel-button" data-close-modal>Cancelar</button><button class="lime-button">Crear usuario</button></div></form></div></dialog>
<c:forEach var="u" items="${usuarios.rows}">
<dialog class="uts-dialog" id="detalle-usuario-${u.id}"><div class="uts-dialog-inner"><button type="button" class="dialog-close" data-close-modal aria-label="Cerrar">×</button><h2>Detalles del <span class="uts-tag fase">USUARIO</span></h2><dl class="uts-detail-grid">
<dt>Identificación:</dt><dd><c:out value="${u.identificacion}"/></dd><dt>Nombre:</dt><dd><c:out value="${u.nombre}"/></dd><dt>Correo:</dt><dd><c:out value="${u.correo}"/></dd><dt>Rol:</dt><dd><c:out value="${u.rol}"/></dd><dt>Programa:</dt><dd><c:out value="${u.programa}"/></dd><dt>Nivel:</dt><dd><c:out value="${u.nivel}"/></dd><dt>Plan:</dt><dd><c:out value="${u.plan}"/></dd></dl><div class="dialog-actions"><button type="button" class="cancel-button" data-close-modal>Cerrar</button></div></div></dialog>
<dialog class="uts-dialog" id="editar-usuario-${u.id}"><div class="uts-dialog-inner"><button type="button" class="dialog-close" data-close-modal aria-label="Cerrar">×</button><h2>Editar <span class="uts-tag fase">USUARIO</span></h2><form method="post" action="../acciones/guardar.jsp" class="uts-edit-grid"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="accion" value="usuario_actualizar"><input type="hidden" name="id" value="${u.id}"><label class="field">Nombre<input name="nombre" aria-label="Nombre" value="<c:out value='${u.nombre}'/>" required maxlength="160"></label><label class="field">Correo<input name="correo" type="email" aria-label="Correo" value="<c:out value='${u.correo}'/>" required></label><label class="field">Rol<select name="rol" aria-label="Rol"><c:forEach var="r" items="ESTUDIANTE,DIRECTOR,EVALUADOR,COMITE,ADMINISTRADOR"><option value="${r}" <c:if test="${u.rol eq r}">selected</c:if>>${r}</option></c:forEach></select></label><label class="field">Programa<select name="programa_id" aria-label="Programa"><option value="">No aplica</option><c:forEach var="p" items="${programas.rows}"><option value="${p.id}" <c:if test="${u.programa_id eq p.id}">selected</c:if>><c:out value="${p.nombre}"/></option></c:forEach></select></label><label class="field">Nivel<select name="nivel" aria-label="Nivel"><option value="">No aplica</option><c:forEach var="v" items="TECNICO,TECNOLOGO,PROFESIONAL"><option value="${v}" <c:if test="${u.nivel eq v}">selected</c:if>>${v}</option></c:forEach></select></label><label class="field">Plan<select name="plan" aria-label="Plan"><option value="">No aplica</option><c:forEach var="v" items="ANTERIOR,POSTERIOR"><option value="${v}" <c:if test="${u.plan eq v}">selected</c:if>>${v}</option></c:forEach></select></label><label class="field">Créditos aprobados<input type="number" min="0" max="100" name="creditos" value="${u.creditos}" title="Créditos aprobados"></label><label class="field">Metodología<select name="metodologia" aria-label="Metodología"><option value="0">Metodología: No</option><option value="1" <c:if test="${u.metodologia}">selected</c:if>>Metodología: Sí</option></select></label><label class="mini">Seminarios I/II/III/IV aprobados: <input type="checkbox" name="s1" value="1" <c:if test="${u.seminario_i}">checked</c:if>> I <input type="checkbox" name="s2" value="1" <c:if test="${u.seminario_ii}">checked</c:if>> II <input type="checkbox" name="s3" value="1" <c:if test="${u.seminario_iii}">checked</c:if>> III <input type="checkbox" name="s4" value="1" <c:if test="${u.seminario_iv}">checked</c:if>> IV</label><label class="mini">Matriculados: <input type="checkbox" name="m1" value="1" <c:if test="${u.matricula_seminario_i}">checked</c:if>> I <input type="checkbox" name="m3" value="1" <c:if test="${u.matricula_seminario_iii}">checked</c:if>> III</label><label class="field">Acceso<select name="activo" aria-label="Acceso"><option value="1">Activo</option><option value="0" <c:if test="${(u.activo eq 0)}">selected</c:if>>Inactivo</option></select></label><div class="dialog-actions"><button type="button" class="cancel-button" data-close-modal>Cancelar</button><button class="lime-button">Guardar cambios</button></div></form></div></dialog>
</c:forEach>
<%@ include file="/WEB-INF/jspf/pie.jspf" %>
