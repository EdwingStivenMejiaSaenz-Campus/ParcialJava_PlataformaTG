<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ include file="/WEB-INF/jspf/seguridad.jspf" %><c:if test="${sessionScope.rol ne 'ESTUDIANTE'}"><c:redirect url="/dashboard.jsp"><c:param name="error" value="acceso"/></c:redirect></c:if><%@ include file="/WEB-INF/jspf/conexion.jspf" %>
<sql:query var="info" dataSource="${db}">SELECT u.*,p.nombre AS programa FROM usuarios u LEFT JOIN programas p ON p.id=u.programa_id WHERE u.id=CAST(NULLIF(?::text,'') AS bigint)<sql:param value="${sessionScope.usuarioId}"/></sql:query>
<c:set var="u" value="${info.rows[0]}"/>
<c:set var="investigacion" value="${u.nivel ne 'TECNICO' and ((u.plan eq 'ANTERIOR' and u.creditos ge 75 and (u.metodologia eq 1)) or (u.plan eq 'POSTERIOR' and ((u.nivel eq 'TECNOLOGO' and (u.matricula_seminario_i eq 1) and (u.seminario_i eq 1) and (u.seminario_ii eq 1)) or (u.nivel eq 'PROFESIONAL' and (u.matricula_seminario_iii eq 1) and (u.seminario_iii eq 1) and (u.seminario_iv eq 1)) or (u.nivel eq 'TECNICO' and (u.matricula_seminario_i eq 1) and (u.seminario_i eq 1) and (u.seminario_ii eq 1)))))}"/>
<c:set var="seminario" value="${u.nivel ne 'TECNICO' and ((u.plan eq 'ANTERIOR' and u.creditos ge 90 and (u.metodologia eq 1)) or (u.plan eq 'POSTERIOR' and ((u.nivel eq 'TECNOLOGO' and (u.matricula_seminario_i eq 1) and (u.seminario_i eq 1) and (u.seminario_ii eq 1)) or (u.nivel eq 'PROFESIONAL' and (u.matricula_seminario_iii eq 1) and (u.seminario_iii eq 1) and (u.seminario_iv eq 1)) or (u.nivel eq 'TECNICO' and (u.matricula_seminario_i eq 1) and (u.seminario_i eq 1) and (u.seminario_ii eq 1)))))}"/>
<c:set var="practica" value="${(u.plan eq 'ANTERIOR' and (u.metodologia eq 1) and u.creditos ge (u.nivel eq 'TECNICO' ? 70 : 90)) or (u.plan eq 'POSTERIOR' and ((u.nivel eq 'TECNOLOGO' and (u.matricula_seminario_i eq 1) and (u.seminario_i eq 1) and (u.seminario_ii eq 1)) or (u.nivel eq 'PROFESIONAL' and (u.matricula_seminario_iii eq 1) and (u.seminario_iii eq 1) and (u.seminario_iv eq 1)) or (u.nivel eq 'TECNICO' and (u.matricula_seminario_i eq 1) and (u.seminario_i eq 1) and (u.seminario_ii eq 1))))}"/>
<%@ include file="/WEB-INF/jspf/cabecera.jspf" %><h1>Habilitación académica</h1><p class="sub">Validación de requisitos según plan, nivel, créditos y cursos registrados por el Administrador.</p><div class="grid"><div class="panel"><h3>Información registrada</h3><p><strong><c:out value="${u.nombre}"/></strong></p><p class="mini"><c:out value="${u.programa}"/> · <c:out value="${u.nivel}"/></p><p><span class="pill"><c:out value="${u.plan}"/></span> · <strong><c:out value="${u.creditos}"/>%</strong> de créditos</p><p class="mini">Metodología: <c:choose><c:when test="${(u.metodologia eq 1)}">Aprobada</c:when><c:otherwise>Pendiente</c:otherwise></c:choose></p></div><div class="panel"><h3>Requisitos pendientes</h3><c:if test="${empty u.plan or empty u.nivel}"><p class="alert">El Administrador debe registrar plan y nivel académico.</p></c:if><c:if test="${u.plan eq 'POSTERIOR' and u.nivel eq 'TECNOLOGO'}"><c:if test="${(u.matricula_seminario_i eq 0)}"><p class="alert">Falta matrícula de Seminario I.</p></c:if><c:if test="${(u.seminario_i eq 0)}"><p class="alert">Falta aprobación de Seminario I.</p></c:if><c:if test="${(u.seminario_ii eq 0)}"><p class="alert">Falta acreditar Seminario II.</p></c:if></c:if><c:if test="${u.plan eq 'POSTERIOR' and u.nivel eq 'PROFESIONAL'}"><c:if test="${(u.matricula_seminario_iii eq 0)}"><p class="alert">Falta matrícula de Seminario III.</p></c:if><c:if test="${(u.seminario_iii eq 0)}"><p class="alert">Falta aprobación de Seminario III.</p></c:if><c:if test="${(u.seminario_iv eq 0)}"><p class="alert">Falta acreditar Seminario IV.</p></c:if></c:if><c:if test="${u.plan eq 'ANTERIOR' and (u.metodologia eq 0)}"><p class="alert">Se requiere metodología o su equivalente aprobado.</p></c:if><c:if test="${u.plan eq 'ANTERIOR' and u.creditos lt 75}"><p class="alert">Para modalidades de investigación se necesitan al menos 75 % de créditos.</p></c:if><c:if test="${u.plan eq 'ANTERIOR' and u.creditos lt 90 and u.nivel ne 'TECNICO'}"><p class="alert">Para Seminario y Práctica se requiere 90 % de créditos.</p></c:if><c:if test="${u.plan eq 'ANTERIOR' and u.nivel eq 'TECNICO' and u.creditos lt 70}"><p class="alert">Para Práctica de nivel Técnico se requiere 70 %.</p></c:if><c:if test="${u.plan eq 'POSTERIOR' and not ((u.nivel eq 'TECNOLOGO' and (u.matricula_seminario_i eq 1) and (u.seminario_i eq 1) and (u.seminario_ii eq 1)) or (u.nivel eq 'PROFESIONAL' and (u.matricula_seminario_iii eq 1) and (u.seminario_iii eq 1) and (u.seminario_iv eq 1)) or (u.nivel eq 'TECNICO' and (u.matricula_seminario_i eq 1) and (u.seminario_i eq 1) and (u.seminario_ii eq 1)))}"><p class="alert">Pendiente acreditar la secuencia de Seminarios I/II o III/IV. Verifique matrícula del Seminario I (Tecnología/Técnico) o III (Profesional), aprobación de este y acreditación de II o IV, respectivamente.</p></c:if></div></div>
<div class="panel"><h2>Modalidades evaluadas</h2><div class="table-scroll"><table><tr><th>Modalidad</th><th>Resultado</th></tr><c:forEach var="m" items="Proyecto de Investigación,Desarrollo Tecnológico,Monografía,Emprendimiento"><tr><td>${m}</td><td><c:choose><c:when test="${investigacion}"><span class="pill">Habilitada</span></c:when><c:otherwise>No habilitada</c:otherwise></c:choose></td></tr></c:forEach><tr><td>Seminario</td><td><c:choose><c:when test="${seminario}">Habilitada</c:when><c:otherwise>No habilitada</c:otherwise></c:choose></td></tr><tr><td>Práctica</td><td><c:choose><c:when test="${practica}">Habilitada</c:when><c:otherwise>No habilitada</c:otherwise></c:choose></td></tr></table></div><div class="buttons"><a href="proyectos.jsp" class="btn">Mis proyectos</a><a href="banco.jsp" class="btn secondary">Ver ideas disponibles</a></div></div><%@ include file="/WEB-INF/jspf/pie.jspf" %>
