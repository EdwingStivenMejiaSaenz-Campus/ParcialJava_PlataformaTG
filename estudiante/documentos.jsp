<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ include file="/WEB-INF/jspf/seguridad.jspf" %>
<c:if test="${sessionScope.rol ne 'ESTUDIANTE'}"><c:redirect url="/dashboard.jsp"><c:param name="error" value="acceso"/></c:redirect></c:if>
<%@ include file="/WEB-INF/jspf/conexion.jspf" %>
<sql:query var="proyecto" dataSource="${db}">SELECT p.* FROM proyectos p JOIN proyecto_estudiantes pe ON pe.proyecto_id=p.id WHERE p.id=CAST(NULLIF(?::text,'') AS bigint) AND pe.estudiante_id=CAST(NULLIF(?::text,'') AS bigint)<sql:param value="${param.id}"/><sql:param value="${sessionScope.usuarioId}"/></sql:query>
<c:if test="${empty proyecto.rows}"><c:redirect url="/estudiante/proyectos.jsp"><c:param name="error" value="acceso"/></c:redirect></c:if>
<sql:query var="docs" dataSource="${db}">SELECT d.*,u.nombre AS autor FROM documentos d JOIN usuarios u ON u.id=d.usuario_id WHERE d.proyecto_id=CAST(NULLIF(?::text,'') AS bigint) ORDER BY d.fecha DESC<sql:param value="${param.id}"/></sql:query>
<%@ include file="/WEB-INF/jspf/cabecera.jspf" %>
<h1>Documentos del proyecto · Enlaces</h1><p class="sub"><c:out value="${proyecto.rows[0].titulo}"/> — Los archivos permanecen en Google Drive; aquí solo registramos sus enlaces.</p>
<div class="panel"><h2>Registrar un documento por enlace</h2><p>Para el F-DC-124 de la fase 2, ve a <a href="propuesta.jsp?id=${param.id}">Pago y fases</a>. Aquí puedes registrar los demás entregables.</p>
<form method="post" action="../acciones/guardar.jsp"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="accion" value="documento_crear"><input type="hidden" name="proyecto_id" value="${param.id}"><div class="form-grid"><div class="field"><label>Tipo de entrega</label><select name="tipo"><option>Desarrollo</option><option>Informe Final</option><option>Manual de usuario</option><option>Código fuente</option><option>Soporte</option><option>Correcciones</option></select></div><div class="field"><label>Nombre del documento</label><input name="nombre" required maxlength="160"></div><div class="field wide"><label>Enlace HTTPS de Google Drive</label><input type="url" name="url" maxlength="900" required placeholder="https://drive.google.com/..." pattern="https://.*"></div></div><button type="submit">Guardar enlace</button></form>
</div>
<div class="panel table-scroll"><h2>Historial de enlaces y documentos anteriores</h2><table><thead><tr><th>Entrega</th><th>Archivo / enlace</th><th>Versión</th><th>Registrado por</th></tr></thead><tbody><c:forEach var="d" items="${docs.rows}"><tr><td><c:out value="${d.tipo}"/></td><td><c:choose><c:when test="${not empty d.archivo_token}"><a href="../comun/archivo.jsp?token=<c:out value='${d.archivo_token}'/>">Abrir archivo anterior</a></c:when><c:otherwise><a href="<c:out value='${d.url}'/>" target="_blank" rel="noopener noreferrer"><c:out value="${d.nombre}"/> ↗</a></c:otherwise></c:choose></td><td>${d.version}</td><td><c:out value="${d.autor}"/></td></tr></c:forEach></tbody></table></div>
<%@ include file="/WEB-INF/jspf/pie.jspf" %>
