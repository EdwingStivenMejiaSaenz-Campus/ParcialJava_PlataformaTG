<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ include file="/WEB-INF/jspf/seguridad.jspf" %><c:if test="${sessionScope.rol ne 'ESTUDIANTE'}"><c:redirect url="/dashboard.jsp"><c:param name="error" value="acceso"/></c:redirect></c:if><%@ include file="/WEB-INF/jspf/conexion.jspf" %>
<sql:query var="proyecto" dataSource="${db}">SELECT p.* FROM proyectos p JOIN proyecto_estudiantes pe ON pe.proyecto_id=p.id WHERE p.id=CAST(NULLIF(?::text,'') AS bigint) AND pe.estudiante_id=CAST(NULLIF(?::text,'') AS bigint)<sql:param value="${param.id}"/><sql:param value="${sessionScope.usuarioId}"/></sql:query><c:if test="${empty proyecto.rows}"><c:redirect url="/dashboard.jsp"><c:param name="error" value="acceso"/></c:redirect></c:if>
<sql:query var="docs" dataSource="${db}">SELECT d.*,u.nombre AS autor FROM documentos d JOIN usuarios u ON u.id=d.usuario_id WHERE d.proyecto_id=CAST(NULLIF(?::text,'') AS bigint) ORDER BY d.fecha DESC<sql:param value="${param.id}"/></sql:query>
<%@ include file="/WEB-INF/jspf/cabecera.jspf" %><h1>Documentos y entregables</h1><p class="sub"><c:out value="${proyecto.rows[0].titulo}"/> · <c:out value="${proyecto.rows[0].fase}"/></p><div class="panel"><h2>Subir archivo desde tu equipo</h2><p class="mini">Carga real de PDF, documentos, imágenes o ZIP hasta 20 MB. El sistema conserva una copia en Supabase en fragmentos protegidos por permisos.</p><form data-upload-uts data-destino="../acciones/subir_archivo.jsp"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="proyecto_id" value="${param.id}"><div class="form-grid"><div class="field"><label>Clase de documento</label><select name="tipo"><option>Propuesta F-DC-124</option><option>Desarrollo</option><option>Informe Final</option><option>Manual de usuario</option><option>Código fuente</option><option>Soporte</option><option>Correcciones</option><option>Comprobante de pago</option></select></div><div class="field"><label>Seleccionar archivo</label><input type="file" required></div></div><div class="buttons"><button type="submit">Subir archivo</button></div><p data-estado class="mini" role="status"></p></form></div><div class="panel"><h2>Registrar una referencia externa</h2><form method="post" action="../acciones/guardar.jsp"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="accion" value="documento_crear"><input type="hidden" name="proyecto_id" value="${param.id}"><div class="form-grid"><div class="field"><label>Tipo</label><select name="tipo"><option>Desarrollo</option><option>Informe Final</option><option>Manual de usuario</option><option>Código fuente</option><option>Soporte</option><option>Correcciones</option><option>Comprobante de pago</option></select></div><div class="field"><label>Nombre</label><input name="nombre" required></div><div class="field wide"><label>Enlace HTTPS del archivo</label><input type="url" name="url" required placeholder="https://..."></div></div><div class="buttons"><button>Registrar referencia</button></div></form><p class="mini">Para entregar archivos directamente, utiliza el formulario superior. Los enlaces se conservan como referencias externas.</p></div><div class="panel table-scroll"><h2>Historial de documentos</h2><table><tr><th>Tipo</th><th>Nombre</th><th>Versión</th><th>Autor</th><th>Fecha</th></tr><c:forEach var="d" items="${docs.rows}"><tr><td><c:out value="${d.tipo}"/></td><td><c:choose><c:when test="${not empty d.archivo_token}"><a href="../comun/archivo.jsp?token=<c:out value='${d.archivo_token}'/>"><c:out value="${d.nombre}"/> (archivo)</a></c:when><c:otherwise><a href="<c:out value='${d.url}'/>" target="_blank" rel="noopener noreferrer"><c:out value="${d.nombre}"/></a></c:otherwise></c:choose></td><td>${d.version}</td><td><c:out value="${d.autor}"/></td><td>${d.fecha}</td></tr></c:forEach></table></div><script src="${pageContext.request.contextPath}/js/archivos.js" defer></script><%@ include file="/WEB-INF/jspf/pie.jspf" %>
