<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ include file="/WEB-INF/jspf/seguridad.jspf" %><c:if test="${sessionScope.rol ne 'ESTUDIANTE'}"><c:redirect url="/dashboard.jsp"><c:param name="error" value="acceso"/></c:redirect></c:if><%@ include file="/WEB-INF/jspf/conexion.jspf" %>
<sql:query var="proyecto" dataSource="${db}">SELECT p.*,m.nombre AS modalidad FROM proyectos p JOIN proyecto_estudiantes e ON e.proyecto_id=p.id JOIN modalidades m ON m.id=p.modalidad_id WHERE p.id=CAST(NULLIF(?::text,'') AS bigint) AND e.estudiante_id=CAST(NULLIF(?::text,'') AS bigint)<sql:param value="${param.id}"/><sql:param value="${sessionScope.usuarioId}"/></sql:query><c:if test="${empty proyecto.rows}"><c:redirect url="/dashboard.jsp"><c:param name="error" value="acceso"/></c:redirect></c:if>
<sql:query var="integrantes" dataSource="${db}">SELECT u.nombre,u.identificacion,u.nivel FROM proyecto_estudiantes pe JOIN usuarios u ON u.id=pe.estudiante_id WHERE pe.proyecto_id=CAST(NULLIF(?::text,'') AS bigint)<sql:param value="${param.id}"/></sql:query>
<%@ include file="/WEB-INF/jspf/cabecera.jspf" %><h1>Integrantes del proyecto</h1><p class="sub"><c:out value="${proyecto.rows[0].titulo}"/></p><div class="panel"><h2>Equipo actual</h2><c:forEach var="e" items="${integrantes.rows}"><p><strong><c:out value="${e.nombre}"/></strong> · <c:out value="${e.identificacion}"/> · <c:out value="${e.nivel}"/></p></c:forEach><p class="mini">Máximo dos estudiantes; se permite un tercero solo para Investigación o Desarrollo Tecnológico y mediante excepción formal del Comité.</p></div><c:if test="${proyecto.rows[0].estado eq 'BORRADOR'}"><div class="panel"><h2>Agregar estudiante</h2><form method="post" action="../acciones/guardar.jsp"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="accion" value="integrante_agregar"><input type="hidden" name="proyecto_id" value="${param.id}"><div class="field"><label>Identificación del estudiante registrado</label><input name="identificacion" required></div><div class="buttons"><button>Vincular integrante</button></div></form></div></c:if><%@ include file="/WEB-INF/jspf/pie.jspf" %>
