<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ include file="/WEB-INF/jspf/seguridad.jspf" %><c:if test="${sessionScope.rol ne 'ESTUDIANTE'}"><c:redirect url="/dashboard.jsp"><c:param name="error" value="acceso"/></c:redirect></c:if><%@ include file="/WEB-INF/jspf/conexion.jspf" %>
<sql:query var="comprobantes" dataSource="${db}">SELECT a.token,a.proyecto_id,a.nombre FROM archivos a WHERE a.usuario_id=CAST(NULLIF(?::text,'') AS bigint) AND a.tipo='Comprobante de pago' AND a.estado='COMPLETO' ORDER BY a.creado_en DESC<sql:param value="${sessionScope.usuarioId}"/></sql:query><sql:query var="proyectos" dataSource="${db}">SELECT p.id,p.titulo FROM proyectos p JOIN proyecto_estudiantes e ON e.proyecto_id=p.id WHERE e.estudiante_id=CAST(NULLIF(?::text,'') AS bigint)<sql:param value="${sessionScope.usuarioId}"/></sql:query><sql:query var="pagos" dataSource="${db}">SELECT pg.*,p.titulo AS proyecto,CASE WHEN pg.estado='VALIDADO' AND EXISTS(SELECT 1 FROM reglas_pagos rp JOIN periodos origen ON origen.id=pg.periodo_id JOIN usuarios u ON u.id=pg.estudiante_id WHERE rp.modalidad_id=pg.modalidad_id AND rp.plan=u.plan AND rp.activo=1 AND (SELECT COUNT(*) FROM periodos z WHERE z.inicio>=origen.inicio AND z.inicio<=CURRENT_DATE)>rp.periodos_vigencia) THEN 'VENCIDO' ELSE pg.estado END AS estado_vigente FROM pagos pg JOIN proyectos p ON p.id=pg.proyecto_id WHERE pg.estudiante_id=CAST(NULLIF(?::text,'') AS bigint) ORDER BY pg.fecha DESC<sql:param value="${sessionScope.usuarioId}"/></sql:query>
<%@ include file="/WEB-INF/jspf/cabecera.jspf" %><h1>Pagos de modalidad</h1><p class="sub">Registro de comprobantes cuando el trámite académico lo requiera. Selecciona la fecha real del pago y adjunta un comprobante ya cargado o una URL HTTPS válida. El Comité deberá validarlo.</p><div class="panel"><form method="post" action="../acciones/guardar.jsp"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="accion" value="pago_crear"><div class="form-grid"><div class="field"><label>Proyecto</label><select name="proyecto_id"><c:forEach var="p" items="${proyectos.rows}"><option value="${p.id}"><c:out value="${p.titulo}"/></option></c:forEach></select></div><div class="field"><label>Referencia</label><input name="referencia" required></div><div class="field"><label>Fecha del pago</label><input type="date" name="fecha_pago" required></div><div class="field"><label>URL del comprobante (si no seleccionas un archivo)</label><input type="url" name="url" placeholder="https://..."><p class="mini">Debes proporcionar una URL HTTPS o seleccionar un comprobante cargado. El sistema no acepta un pago sin soporte.</p><label>O seleccionar un comprobante cargado en Documentos</label><select name="archivo_token"><option value="">Sin archivo</option><c:forEach var="a" items="${comprobantes.rows}"><option value="${a.token}"><c:out value="${a.nombre}"/> · Proyecto ${a.proyecto_id}</option></c:forEach></select></div></div><div class="buttons"><button>Registrar pago</button></div></form></div><div class="panel table-scroll"><table><tr><th>Proyecto</th><th>Referencia</th><th>Fecha</th><th>Estado</th></tr><c:forEach var="p" items="${pagos.rows}"><tr><td><c:out value="${p.proyecto}"/></td><td><c:out value="${p.referencia}"/></td><td>${p.fecha_pago}</td><td><c:out value="${p.estado_vigente}"/> · <span class="mini">Validación por Comité; periodo académico sujeto a fechas oficiales</span></td></tr></c:forEach></table></div><%@ include file="/WEB-INF/jspf/pie.jspf" %>
