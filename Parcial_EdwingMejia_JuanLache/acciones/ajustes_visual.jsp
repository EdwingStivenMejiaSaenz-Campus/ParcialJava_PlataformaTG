<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ include file="/WEB-INF/jspf/seguridad.jspf" %><%@ include file="/WEB-INF/jspf/conexion.jspf" %>
<c:if test="${pageContext.request.method ne 'POST' or sessionScope.rol ne 'COMITE' or param.csrf ne sessionScope.csrf or empty param.proyecto_id or (not empty param.fecha_fin and not empty param.fecha_inicio and param.fecha_fin lt param.fecha_inicio)}"><c:redirect url="/dashboard.jsp"><c:param name="error" value="validacion"/></c:redirect></c:if>
<sql:update var="modificados" dataSource="${db}">INSERT INTO ajustes_proyecto_uts(proyecto_id,inicio_fdc125,fin_fdc125,retirar_estudiante_id,numero_acta,fecha_acta,comentarios,responsable_id) SELECT p.id,CAST(NULLIF(?::text,'') AS date),CAST(NULLIF(?::text,'') AS date),CAST(NULLIF(?::text,'') AS bigint),NULLIF(?::text,''),CAST(NULLIF(?::text,'') AS date),?,? FROM proyectos p WHERE p.id=CAST(NULLIF(?::text,'') AS bigint) AND p.estado!='FINALIZADO' AND (?='' OR EXISTS(SELECT 1 FROM proyecto_estudiantes pe WHERE pe.proyecto_id=p.id AND pe.estudiante_id=CAST(NULLIF(?::text,'') AS bigint))) ON CONFLICT (proyecto_id) DO UPDATE SET inicio_fdc125=EXCLUDED.inicio_fdc125,fin_fdc125=EXCLUDED.fin_fdc125,retirar_estudiante_id=EXCLUDED.retirar_estudiante_id,numero_acta=EXCLUDED.numero_acta,fecha_acta=EXCLUDED.fecha_acta,comentarios=EXCLUDED.comentarios,responsable_id=EXCLUDED.responsable_id
<sql:param value="${param.fecha_inicio}"/><sql:param value="${param.fecha_fin}"/><sql:param value="${param.retirar_estudiante_id}"/><sql:param value="${param.numero_acta}"/><sql:param value="${param.fecha_acta}"/><sql:param value="${param.comentarios}"/><sql:param value="${sessionScope.usuarioId}"/><sql:param value="${param.proyecto_id}"/><sql:param value="${param.retirar_estudiante_id}"/><sql:param value="${param.retirar_estudiante_id}"/></sql:update>
<c:if test="${modificados gt 0}"><sql:update dataSource="${db}">INSERT INTO historial(proyecto_id,usuario_id,evento,detalle) VALUES(?,?,'Ajustes del proyecto',?)<sql:param value="${param.proyecto_id}"/><sql:param value="${sessionScope.usuarioId}"/><sql:param value="${param.comentarios}"/></sql:update><sql:update dataSource="${db}">INSERT INTO auditoria(usuario_id,proyecto_id,entidad,accion,anterior,nuevo) VALUES(?,?,'ajustes_proyecto_uts','actualizar',?,?)<sql:param value="${sessionScope.usuarioId}"/><sql:param value="${param.proyecto_id}"/><sql:param value="${param.numero_acta}"/><sql:param value="${param.comentarios}"/></sql:update><c:redirect url="/comun/seguimiento.jsp"><c:param name="id" value="${param.proyecto_id}"/><c:param name="ok" value="1"/></c:redirect></c:if><c:redirect url="/dashboard.jsp"><c:param name="error" value="validacion"/></c:redirect>