<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ include file="/WEB-INF/jspf/seguridad.jspf" %><%@ include file="/WEB-INF/jspf/conexion.jspf" %>
<c:if test="${pageContext.request.method ne 'POST' or param.csrf ne sessionScope.csrf}"><c:redirect url="/dashboard.jsp"><c:param name="error" value="acceso"/></c:redirect></c:if>
<c:choose><c:when test="${param.accion eq 'crear' and (sessionScope.rol eq 'DIRECTOR' or sessionScope.rol eq 'EVALUADOR') and not empty fn:trim(param.titulo) and not empty fn:trim(param.objetivo) and not empty fn:trim(param.descripcion) and fn:length(param.titulo) le 220 and (param.nivel eq 'TECNICO' or param.nivel eq 'TECNOLOGO' or param.nivel eq 'PROFESIONAL')}">
<sql:update var="afectadas" dataSource="${db}">INSERT INTO propuestas_banco_uts(docente_id,periodo_id,programa_id,modalidad_id,nivel,titulo,objetivo,descripcion) SELECT ?,per.id,pr.id,m.id,?,?,?,? FROM periodos per JOIN programas pr ON pr.id=CAST(NULLIF(?::text,'') AS bigint) AND pr.activo=1 JOIN modalidades m ON m.id=CAST(NULLIF(?::text,'') AS bigint) AND m.activo=1 WHERE per.id=CAST(NULLIF(?::text,'') AS bigint) AND per.estado='ACTIVO' AND CURRENT_DATE BETWEEN per.apertura_banco AND per.cierre_banco AND EXISTS(SELECT 1 FROM usuarios u WHERE u.id=CAST(NULLIF(?::text,'') AS bigint) AND u.programa_id=pr.id AND u.activo=1)
<sql:param value="${sessionScope.usuarioId}"/><sql:param value="${param.nivel}"/><sql:param value="${param.titulo}"/><sql:param value="${param.objetivo}"/><sql:param value="${param.descripcion}"/><sql:param value="${param.programa_id}"/><sql:param value="${param.modalidad_id}"/><sql:param value="${param.periodo_id}"/><sql:param value="${sessionScope.usuarioId}"/></sql:update><c:if test="${afectadas gt 0}"><c:redirect url="/comun/propuestas_banco.jsp"><c:param name="ok" value="1"/></c:redirect></c:if><c:redirect url="/comun/propuestas_banco.jsp"><c:param name="error" value="validacion"/></c:redirect></c:when>
<c:when test="${param.accion eq 'resolver' and sessionScope.rol eq 'COMITE' and (param.estado eq 'PUBLICADA' or param.estado eq 'RECHAZADA') and not empty fn:trim(param.comentario)}">
<sql:query var="previo" dataSource="${db}">SELECT * FROM propuestas_banco_uts WHERE id=CAST(NULLIF(?::text,'') AS bigint) AND estado='PENDIENTE' LIMIT 1<sql:param value="${param.id}"/></sql:query><c:if test="${empty previo.rows}"><c:redirect url="/comun/propuestas_banco.jsp"><c:param name="error" value="fase"/></c:redirect></c:if>
<sql:transaction dataSource="${db}"><c:choose><c:when test="${param.estado eq 'PUBLICADA'}"><sql:update>INSERT INTO ideas(periodo_id,programa_id,nivel,modalidad_id,titulo,descripcion,estado) VALUES(?,?,?,?,?,?,'ABIERTA')<sql:param value="${previo.rows[0].periodo_id}"/><sql:param value="${previo.rows[0].programa_id}"/><sql:param value="${previo.rows[0].nivel}"/><sql:param value="${previo.rows[0].modalidad_id}"/><sql:param value="${previo.rows[0].titulo}"/><sql:param value="${previo.rows[0].descripcion}"/></sql:update><sql:update>UPDATE propuestas_banco_uts SET estado='PUBLICADA',comentario_comite=?,idea_publicada_id=currval('uts_grado.ideas_id_seq') WHERE id=CAST(NULLIF(?::text,'') AS bigint) AND estado='PENDIENTE'<sql:param value="${param.comentario}"/><sql:param value="${param.id}"/></sql:update></c:when><c:otherwise><sql:update>UPDATE propuestas_banco_uts SET estado='RECHAZADA',comentario_comite=? WHERE id=CAST(NULLIF(?::text,'') AS bigint) AND estado='PENDIENTE'<sql:param value="${param.comentario}"/><sql:param value="${param.id}"/></sql:update></c:otherwise></c:choose>
<sql:update>INSERT INTO auditoria(usuario_id,entidad,accion,anterior,nuevo) VALUES(?,'propuestas_banco_uts','resolver','PENDIENTE',?)<sql:param value="${sessionScope.usuarioId}"/><sql:param value="${param.estado}"/></sql:update>
<sql:update>INSERT INTO notificaciones(usuario_id,mensaje) VALUES(?,?)<sql:param value="${previo.rows[0].docente_id}"/><sql:param value="${param.estado eq 'PUBLICADA' ? 'Propuesta de Banco aprobada y publicada' : 'Propuesta de Banco rechazada'}"/></sql:update>
</sql:transaction><c:redirect url="/comun/propuestas_banco.jsp"><c:param name="ok" value="1"/></c:redirect></c:when><c:otherwise><c:redirect url="/dashboard.jsp"><c:param name="error" value="acceso"/></c:redirect></c:otherwise></c:choose>