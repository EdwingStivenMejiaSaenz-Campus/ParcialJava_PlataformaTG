<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ include file="/WEB-INF/jspf/seguridad.jspf" %><c:if test="${sessionScope.rol ne 'ESTUDIANTE'}"><c:redirect url="/dashboard.jsp"><c:param name="error" value="acceso"/></c:redirect></c:if><%@ include file="/WEB-INF/jspf/conexion.jspf" %>
<sql:query var="proyectos" dataSource="${db}">SELECT p.* FROM proyectos p JOIN proyecto_estudiantes e ON e.proyecto_id=p.id WHERE e.estudiante_id=CAST(NULLIF(?::text,'') AS bigint) AND p.fase='PROPUESTA' AND p.estado IN ('BORRADOR','CON_OBSERVACIONES')<sql:param value="${sessionScope.usuarioId}"/></sql:query><sql:query var="modalidades" dataSource="${db}">SELECT * FROM modalidades WHERE activo=1</sql:query><sql:query var="cambios" dataSource="${db}">SELECT c.*,p.titulo,m1.nombre AS anterior,m2.nombre AS nueva FROM cambios_modalidad c JOIN proyectos p ON p.id=c.proyecto_id JOIN modalidades m1 ON m1.id=c.anterior_id JOIN modalidades m2 ON m2.id=c.nueva_id WHERE c.solicitante_id=CAST(NULLIF(?::text,'') AS bigint) ORDER BY c.fecha DESC<sql:param value="${sessionScope.usuarioId}"/></sql:query>
<%@ include file="/WEB-INF/jspf/cabecera.jspf" %><h1>Cambio de modalidad</h1><p class="sub">Las solicitudes se revisan y deciden por el Comité.</p><div class="panel"><form method="post" action="../acciones/guardar.jsp"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="accion" value="cambio_solicitar"><div class="form-grid"><div class="field"><label>Proyecto en fase permitida</label><select name="proyecto_id"><c:forEach var="p" items="${proyectos.rows}"><option value="${p.id}"><c:out value="${p.titulo}"/></option></c:forEach></select></div><div class="field"><label>Nueva modalidad</label><select name="nueva_id"><c:forEach var="m" items="${modalidades.rows}"><option value="${m.id}"><c:out value="${m.nombre}"/></option></c:forEach></select></div><div class="field wide"><label>Motivo</label><textarea name="motivo" required></textarea></div></div><div class="buttons"><button>Solicitar cambio</button></div></form></div><div class="panel table-scroll"><table><tr><th>Proyecto</th><th>Cambio</th><th>Estado</th><th>Fecha</th></tr><c:forEach var="c" items="${cambios.rows}"><tr><td><c:out value="${c.titulo}"/></td><td><c:out value="${c.anterior}"/> → <c:out value="${c.nueva}"/></td><td><c:out value="${c.estado}"/></td><td>${c.fecha}</td></tr></c:forEach></table></div><%@ include file="/WEB-INF/jspf/pie.jspf" %>
