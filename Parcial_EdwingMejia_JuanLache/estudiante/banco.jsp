<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ include file="/WEB-INF/jspf/seguridad.jspf" %><c:if test="${sessionScope.rol ne 'ESTUDIANTE'}"><c:redirect url="/dashboard.jsp"><c:param name="error" value="acceso"/></c:redirect></c:if><%@ include file="/WEB-INF/jspf/conexion.jspf" %>
<sql:query var="ideas" dataSource="${db}">SELECT i.*,p.nombre AS periodo,m.nombre AS modalidad FROM ideas i JOIN periodos p ON p.id=i.periodo_id LEFT JOIN modalidades m ON m.id=i.modalidad_id JOIN usuarios u ON u.id=CAST(NULLIF(?::text,'') AS bigint) WHERE i.estado='ABIERTA' AND p.estado='ACTIVO' AND CURRENT_DATE() BETWEEN p.apertura_banco AND p.cierre_banco AND i.programa_id=u.programa_id AND (i.nivel IS NULL OR i.nivel=u.nivel) AND (u.nivel!='TECNICO' OR m.nombre='Práctica') AND ((u.plan='ANTERIOR' AND u.metodologia=1 AND ( (m.nombre IN ('Proyecto de Investigación','Desarrollo Tecnológico','Monografía','Emprendimiento') AND u.creditos>=75 AND u.nivel!='TECNICO') OR (m.nombre='Seminario' AND u.creditos>=90 AND u.nivel!='TECNICO') OR (m.nombre='Práctica' AND u.creditos >= uts_if(u.nivel='TECNICO',70,90)))) OR (u.plan='POSTERIOR' AND ((u.nivel='TECNOLOGO' AND u.matricula_seminario_i=1 AND u.seminario_i=1 AND u.seminario_ii=1) OR (u.nivel='PROFESIONAL' AND u.matricula_seminario_iii=1 AND u.seminario_iii=1 AND u.seminario_iv=1) OR (u.nivel='TECNICO' AND u.matricula_seminario_i=1 AND u.seminario_i=1 AND u.seminario_ii=1)))) ORDER BY i.titulo
<sql:param value="${sessionScope.usuarioId}"/></sql:query>
<%@ include file="/WEB-INF/jspf/cabecera.jspf" %><h1>Ideas disponibles</h1><p class="sub">Se muestran únicamente las ideas abiertas compatibles con tus datos académicos.</p><div class="grid"><c:forEach var="i" items="${ideas.rows}"><div class="panel"><h3><c:out value="${i.titulo}"/></h3><p class="mini"><c:out value="${i.periodo}"/> · <c:out value="${i.modalidad}"/></p><p><c:out value="${i.descripcion}"/></p><form method="post" action="../acciones/guardar.jsp"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="accion" value="proyecto_de_idea"><input type="hidden" name="idea_id" value="${i.id}"><button>Elegir idea</button></form></div></c:forEach><c:if test="${empty ideas.rows}"><div class="panel">No hay ideas habilitadas para tu perfil y periodo actual.</div></c:if></div><%@ include file="/WEB-INF/jspf/pie.jspf" %>
