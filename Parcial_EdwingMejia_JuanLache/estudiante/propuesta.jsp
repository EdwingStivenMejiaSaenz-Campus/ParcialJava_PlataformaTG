<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ include file="/WEB-INF/jspf/seguridad.jspf" %><c:if test="${sessionScope.rol ne 'ESTUDIANTE'}"><c:redirect url="/dashboard.jsp"><c:param name="error" value="acceso"/></c:redirect></c:if><%@ include file="/WEB-INF/jspf/conexion.jspf" %>
<sql:query var="proyecto" dataSource="${db}">SELECT p.*,d.nombre AS director,e.nombre AS evaluador FROM proyectos p JOIN proyecto_estudiantes pe ON pe.proyecto_id=p.id LEFT JOIN usuarios d ON d.id=p.director_id LEFT JOIN usuarios e ON e.id=p.evaluador_id WHERE p.id=CAST(NULLIF(?::text,'') AS bigint) AND pe.estudiante_id=CAST(NULLIF(?::text,'') AS bigint) LIMIT 1<sql:param value="${param.id}"/><sql:param value="${sessionScope.usuarioId}"/></sql:query>
<c:if test="${empty proyecto.rows}"><c:redirect url="/dashboard.jsp"><c:param name="error" value="acceso"/></c:redirect></c:if><c:set var="p" value="${proyecto.rows[0]}"/>
<sql:query var="versiones" dataSource="${db}">SELECT v.*,u.nombre AS autor FROM propuestas v JOIN usuarios u ON u.id=v.autor_id WHERE v.proyecto_id=CAST(NULLIF(?::text,'') AS bigint) ORDER BY v.version DESC<sql:param value="${p.id}"/></sql:query>
<sql:query var="grupos" dataSource="${db}">SELECT * FROM grupos_investigacion WHERE programa_id=CAST(NULLIF(?::text,'') AS bigint)<sql:param value="${p.programa_id}"/></sql:query><sql:query var="lineas" dataSource="${db}">SELECT l.*,g.nombre AS grupo FROM lineas_investigacion l JOIN grupos_investigacion g ON g.id=l.grupo_id WHERE g.programa_id=CAST(NULLIF(?::text,'') AS bigint)<sql:param value="${p.programa_id}"/></sql:query>
<sql:query var="docentes" dataSource="${db}">SELECT id,nombre FROM usuarios WHERE rol='DIRECTOR' AND activo=1 ORDER BY nombre</sql:query>
<sql:query var="obs" dataSource="${db}">SELECT o.*,u.nombre AS autor FROM observaciones o JOIN usuarios u ON u.id=o.usuario_id WHERE o.proyecto_id=CAST(NULLIF(?::text,'') AS bigint) ORDER BY o.fecha DESC<sql:param value="${p.id}"/></sql:query>
<%@ include file="/WEB-INF/jspf/cabecera.jspf" %><h1>Propuesta de grado</h1><p class="sub"><c:out value="${p.codigo}"/> · <c:out value="${p.titulo}"/></p><div class="panel"><div class="steps"><span class="active"><c:out value="${p.fase}"/></span><span><c:out value="${p.estado}"/></span><span>Director: <c:out value="${p.director}" default="Pendiente"/></span><span>Evaluador: <c:out value="${p.evaluador}" default="Pendiente"/></span></div></div>
<c:if test="${(p.estado ne 'APROBADO' and p.fase eq 'PROPUESTA') or (p.fase eq 'DESARROLLO' and (p.cambio_oficial_autorizado eq 1))}"><div class="panel"><h2>Agregar versión de la propuesta (F-DC-124)</h2><form method="post" action="../acciones/guardar.jsp"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="accion" value="propuesta_version"><input type="hidden" name="proyecto_id" value="${p.id}"><div class="form-grid"><div class="field"><label>Modalidad específica del proyecto (F-DC-124)</label><input name="modalidad_especifica" maxlength="130" value="<c:out value='${p.modalidad_especifica}'/>"></div><div class="field wide"><label>Descripción del problema</label><textarea name="problema" required></textarea></div><div class="field wide"><label>Justificación</label><textarea name="justificacion" required></textarea></div><div class="field wide"><label>Objetivo general</label><textarea name="objetivo_general" required></textarea></div><div class="field wide"><label>Objetivos específicos</label><textarea name="objetivos_especificos" required></textarea></div><div class="field wide"><label>Estado del arte</label><textarea name="estado_arte"></textarea></div><div class="field wide"><label>Fundamento teórico</label><textarea name="teoria"></textarea></div><div class="field wide"><label>Resultados esperados</label><textarea name="resultados"></textarea></div><div class="field wide"><label>Plan de actividades</label><textarea name="actividades"></textarea></div><div class="field wide"><label>Presupuesto</label><textarea name="presupuesto"></textarea></div><div class="field wide"><label>Otros datos del F-DC-124 vigente</label><textarea name="otros_campos_fdc" placeholder="Anota aquí apartados adicionales que exija el formato institucional vigente"></textarea></div><div class="field wide"><label>Enlace al F-DC-124 (opcional si lo subiste)</label><input type="url" name="fdc124_url" placeholder="https://..."><small class="mini">Para subir el PDF/DOCX original, utiliza <a href="documentos.jsp?id=${p.id}">Documentos y entregables</a>, seleccionando Propuesta F-DC-124. Es necesario cargarlo antes de enviar al Director.</small></div><div class="field"><label>Grupo de investigación</label><select name="grupo_id"><option value="">Sin definir</option><c:forEach var="g" items="${grupos.rows}"><option value="${g.id}"><c:out value="${g.nombre}"/></option></c:forEach></select></div><div class="field"><label>Línea de investigación</label><select name="linea_id"><option value="">Sin definir</option><c:forEach var="l" items="${lineas.rows}"><option value="${l.id}"><c:out value="${l.grupo}"/> - <c:out value="${l.nombre}"/></option></c:forEach></select></div><div class="field"><label>Solicitar director</label><select name="director_id"><option value="">Sin solicitar</option><c:forEach var="d" items="${docentes.rows}"><option value="${d.id}"><c:out value="${d.nombre}"/></option></c:forEach></select></div><div class="field"><label>Solicitar codirector (opcional)</label><select name="codirector_id"><option value="">Sin solicitar</option><c:forEach var="d" items="${docentes.rows}"><option value="${d.id}"><c:out value="${d.nombre}"/></option></c:forEach></select></div></div><div class="buttons"><button>Guardar versión</button></div></form></div></c:if>
<div class="panel"><h2>Versiones e historial de revisión</h2><div class="table-scroll"><table><tr><th>Versión</th><th>Registrado por</th><th>Documento</th><th>Fecha</th><th>Estado</th></tr><c:forEach var="v" items="${versiones.rows}"><tr><td>${v.version}</td><td><c:out value="${v.autor}"/></td><td><c:choose><c:when test="${not empty v.fdc124_url}"><a href="<c:out value='${v.fdc124_url}'/>" rel="noopener noreferrer" target="_blank">Consultar enlace</a></c:when><c:otherwise><a href="documentos.jsp?id=${p.id}">Ver documento adjunto</a></c:otherwise></c:choose></td><td>${v.fecha}</td><td><c:choose><c:when test="${(v.oficial eq 1)}">Versión oficial</c:when><c:otherwise>Versión histórica</c:otherwise></c:choose></td></tr></c:forEach></table></div></div>
<div class="panel"><h2>Observaciones</h2><c:forEach var="o" items="${obs.rows}"><p><strong><c:out value="${o.autor}"/></strong> <span class="mini">${o.fecha} - ${o.tipo}</span><br><c:out value="${o.comentario}"/></p></c:forEach></div>
<c:if test="${p.estado eq 'BORRADOR' or p.estado eq 'CON_OBSERVACIONES'}"><div class="panel"><h2>Enviar para revisión</h2><form method="post" action="../acciones/guardar.jsp"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="accion" value="propuesta_enviar"><input type="hidden" name="proyecto_id" value="${p.id}"><button>Enviar al Director</button></form><p class="mini">Se exige una versión de la propuesta y Director asignado.</p></div></c:if>
<%@ include file="/WEB-INF/jspf/pie.jspf" %>
