<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ include file="/WEB-INF/jspf/seguridad.jspf" %><c:if test="${sessionScope.rol ne 'EVALUADOR'}"><c:redirect url="/dashboard.jsp"><c:param name="error" value="acceso"/></c:redirect></c:if><%@ include file="/WEB-INF/jspf/conexion.jspf" %>
<sql:query var="sustentaciones" dataSource="${db}">SELECT s.*,p.titulo,p.codigo FROM sustentaciones s JOIN proyectos p ON p.id=s.proyecto_id WHERE p.evaluador_id=CAST(NULLIF(?::text,'') AS bigint) ORDER BY s.fecha DESC<sql:param value="${sessionScope.usuarioId}"/></sql:query>
<%@ include file="/WEB-INF/jspf/cabecera.jspf" %><h1>Concepto de sustentación</h1><p class="sub">Registra el resultado cuando se haya realizado la sustentación.</p><div class="panel table-scroll"><table><tr><th>Proyecto</th><th>Fecha</th><th>Estado</th><th>Resultado</th></tr><c:forEach var="s" items="${sustentaciones.rows}"><tr><td><c:out value="${s.titulo}"/></td><td>${s.fecha}</td><td><c:out value="${s.estado}"/></td><td><c:choose><c:when test="${s.estado eq 'REALIZADA'}"><form method="post" action="../acciones/guardar.jsp" class="actions-inline"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="accion" value="sustentacion_concepto"><input type="hidden" name="proyecto_id" value="${s.proyecto_id}"><select name="concepto"><option value="APROBADA">Aprobada</option><option value="NO APROBADA">No aprobada</option><option value="CORRECCIONES">Correcciones</option></select><button>Registrar</button></form></c:when><c:otherwise><c:out value="${s.concepto}" default="Aún no procede"/></c:otherwise></c:choose></td></tr></c:forEach></table></div><%@ include file="/WEB-INF/jspf/pie.jspf" %>
