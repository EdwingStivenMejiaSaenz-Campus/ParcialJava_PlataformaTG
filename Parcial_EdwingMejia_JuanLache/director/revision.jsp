<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ include file="/WEB-INF/jspf/seguridad.jspf" %><c:if test="${sessionScope.rol ne 'DIRECTOR'}"><c:redirect url="/dashboard.jsp"><c:param name="error" value="acceso"/></c:redirect></c:if><%@ include file="/WEB-INF/jspf/conexion.jspf" %>
<sql:query var="proyecto" dataSource="${db}">SELECT p.*,u.nombre AS estudiante FROM proyectos p JOIN usuarios u ON u.id=p.estudiante_id WHERE p.id=CAST(NULLIF(?::text,'') AS bigint) AND p.director_id=CAST(NULLIF(?::text,'') AS bigint)<sql:param value="${param.id}"/><sql:param value="${sessionScope.usuarioId}"/></sql:query><c:if test="${empty proyecto.rows}"><c:redirect url="/dashboard.jsp"><c:param name="error" value="acceso"/></c:redirect></c:if><c:set var="p" value="${proyecto.rows[0]}"/>
<sql:query var="versiones" dataSource="${db}">SELECT * FROM propuestas WHERE proyecto_id=CAST(NULLIF(?::text,'') AS bigint) ORDER BY version DESC<sql:param value="${p.id}"/></sql:query><sql:query var="documentos" dataSource="${db}">SELECT * FROM documentos WHERE proyecto_id=CAST(NULLIF(?::text,'') AS bigint) ORDER BY fecha DESC<sql:param value="${p.id}"/></sql:query><sql:query var="obs" dataSource="${db}">SELECT o.*,u.nombre AS autor FROM observaciones o JOIN usuarios u ON u.id=o.usuario_id WHERE o.proyecto_id=CAST(NULLIF(?::text,'') AS bigint) ORDER BY o.fecha DESC<sql:param value="${p.id}"/></sql:query>
<%@ include file="/WEB-INF/jspf/cabecera.jspf" %><h1>Revisión del Director</h1><p class="sub"><c:out value="${p.titulo}"/> · <c:out value="${p.estudiante}"/></p><div class="panel"><p><span class="pill">${p.fase}</span> · <span class="pill">${p.estado}</span></p><h2>Versiones de la propuesta</h2><div class="table-scroll"><table><tr><th>Versión</th><th>Problema</th><th>Objetivo general</th><th>Documento</th></tr><c:forEach var="v" items="${versiones.rows}"><tr><td>${v.version}</td><td><c:out value="${v.problema}"/></td><td><c:out value="${v.objetivo_general}"/></td><td><a href="<c:out value='${v.fdc124_url}'/>" target="_blank" rel="noopener noreferrer">F-DC-124</a></td></tr></c:forEach></table></div><h2>Entregables</h2><c:forEach var="d" items="${documentos.rows}"><p><a href="<c:out value='${d.url}'/>" target="_blank" rel="noopener noreferrer"><c:out value="${d.nombre}"/></a> · <c:out value="${d.tipo}"/></p></c:forEach></div>
<div class="panel"><h2>Registrar observación</h2><form method="post" action="../acciones/guardar.jsp"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="accion" value="director_observar"><input type="hidden" name="proyecto_id" value="${p.id}"><div class="field"><label>Etapa</label><select name="tipo"><option value="PROPUESTA">Propuesta</option><option value="DESARROLLO">Desarrollo</option><option value="INFORME_FINAL">Informe final</option></select></div><div class="field"><label>Observación</label><textarea name="comentario" required></textarea></div><div class="buttons"><button>Guardar observación</button></div></form></div>
<c:if test="${p.evaluador_propuesta_excepcion_id eq sessionScope.usuarioId and p.fase eq 'PROPUESTA'}"><p><a class="btn" href="../evaluador/evaluacion.jsp?id=${p.id}">Evaluar propuesta por excepción del plan posterior</a></p></c:if><div class="panel"><h2>Aval del Director</h2><form method="post" action="../acciones/guardar.jsp"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="accion" value="director_avalar"><input type="hidden" name="proyecto_id" value="${p.id}"><c:choose><c:when test="${p.fase eq 'PROPUESTA'}"><button>Avalar propuesta y pasar a evaluación</button></c:when><c:when test="${p.fase eq 'INFORME_FINAL'}"><button>Avalar informe final</button></c:when><c:otherwise><p class="mini">No hay una etapa que pueda avalarse en este momento.</p></c:otherwise></c:choose></form></div><c:if test="${p.fase eq 'INFORME_FINAL' and p.estado eq 'INFORME_EN_REVISION'}"><div class="panel"><h2>Nueva evaluación del Informe Final</h2><form method="post" action="../acciones/guardar.jsp"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="accion" value="solicitar_reevaluacion"><input type="hidden" name="proyecto_id" value="${p.id}"><button>Revisar correcciones y solicitar reevaluación</button></form><p class="mini">Solo procede tras cargar la versión corregida del Informe Final.</p></div></c:if><div class="panel"><h2>Observaciones registradas</h2><c:forEach var="o" items="${obs.rows}"><p><strong><c:out value="${o.autor}"/></strong> <span class="mini">${o.fecha}</span><br><c:out value="${o.comentario}"/></p></c:forEach></div><div class="panel"><h2>Resultado de similitud de propuesta</h2><form method="post" action="../acciones/guardar.jsp" class="form-grid"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="accion" value="similitud_registrar"><input type="hidden" name="proyecto_id" value="${param.id}"><div class="field"><label>Resultado Turnitin / referencia de revisión</label><input name="resultado" maxlength="120" required></div><div class="field"><label>&nbsp;</label><button>Registrar resultado</button></div></form></div><p><a class="btn secondary" href="../comun/historial.jsp?id=${param.id}">Consultar todas las versiones, documentos y evaluaciones</a></p><%@ include file="/WEB-INF/jspf/pie.jspf" %>
