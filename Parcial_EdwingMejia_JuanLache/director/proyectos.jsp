<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ include file="/WEB-INF/jspf/seguridad.jspf" %><c:if test="${sessionScope.rol ne 'DIRECTOR'}"><c:redirect url="/dashboard.jsp"><c:param name="error" value="acceso"/></c:redirect></c:if><%@ include file="/WEB-INF/jspf/conexion.jspf" %>
<sql:query var="proyectos" dataSource="${db}">SELECT p.*,u.nombre AS estudiante,per.nombre AS periodo FROM proyectos p JOIN usuarios u ON u.id=p.estudiante_id JOIN periodos per ON per.id=p.periodo_id WHERE p.director_id=CAST(NULLIF(?::text,'') AS bigint) AND (p.titulo LIKE CONCAT('%',?,'%') OR p.codigo LIKE CONCAT('%',?,'%') OR u.nombre LIKE CONCAT('%',?,'%')) AND (?='' OR p.estado=?) AND (?='' OR p.fase=?) AND (?='' OR p.periodo_id=CAST(NULLIF(?::text,'') AS bigint)) ORDER BY p.modificado_en DESC
<sql:param value="${sessionScope.usuarioId}"/><sql:param value="${empty param.buscar ? '' : param.buscar}"/><sql:param value="${empty param.buscar ? '' : param.buscar}"/><sql:param value="${empty param.buscar ? '' : param.buscar}"/><sql:param value="${empty param.estado ? '' : param.estado}"/><sql:param value="${empty param.estado ? '' : param.estado}"/><sql:param value="${empty param.fase ? '' : param.fase}"/><sql:param value="${empty param.fase ? '' : param.fase}"/><sql:param value="${empty param.periodo ? '' : param.periodo}"/><sql:param value="${empty param.periodo ? '' : param.periodo}"/></sql:query>
<%@ include file="/WEB-INF/jspf/cabecera.jspf" %><h1>Proyectos asignados</h1><p class="sub">Acompañamiento, observaciones y aval académico.</p><div class="panel"><form method="get" class="actions-inline"><input name="buscar" placeholder="Código, título o estudiante" value="<c:out value='${param.buscar}'/>"><select name="estado"><option value="">Todos los estados</option><option value="EN_REVISION">En revisión</option><option value="CON_OBSERVACIONES">Con observaciones</option><option value="INFORME_EN_REVISION">Informe final</option></select><select name="fase"><option value="">Todas las fases</option><option>PROPUESTA</option><option>DESARROLLO</option><option>INFORME_FINAL</option><option>SUSTENTACION</option><option>CIERRE</option></select><input type="number" name="periodo" min="1" placeholder="ID del periodo" value="<c:out value='${param.periodo}'/>"><button>Buscar</button></form><div class="table-scroll"><table><tr><th>Proyecto</th><th>Estudiante</th><th>Periodo</th><th>Fase / estado</th><th>Revisar</th></tr><c:forEach var="p" items="${proyectos.rows}"><tr><td><strong><c:out value="${p.titulo}"/></strong><div class="mini"><c:out value="${p.codigo}"/></div></td><td><c:out value="${p.estudiante}"/></td><td><c:out value="${p.periodo}"/></td><td>${p.fase} · ${p.estado}</td><td><a class="btn secondary" href="revision.jsp?id=${p.id}">Abrir expediente</a></td></tr></c:forEach></table></div></div><%@ include file="/WEB-INF/jspf/pie.jspf" %>
