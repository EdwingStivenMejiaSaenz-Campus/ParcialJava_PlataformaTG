<%@ page pageEncoding="UTF-8" %>
<%-- Tomcat 8.5 proporciona tomcat-dbcp.jar. Pool reutilizable y validación al solicitar cada conexión. --%>
<jsp:useBean id="utsDbPool" class="org.apache.tomcat.dbcp.dbcp2.BasicDataSource" scope="application">
 <jsp:setProperty name="utsDbPool" property="driverClassName" value="org.postgresql.Driver"/>
 <jsp:setProperty name="utsDbPool" property="url" value="${initParam.DB_URL}"/>
 <jsp:setProperty name="utsDbPool" property="username" value="${initParam.DB_USER}"/>
 <jsp:setProperty name="utsDbPool" property="password" value="${initParam.DB_PASSWORD}"/>
 <jsp:setProperty name="utsDbPool" property="initialSize" value="0"/>
 <jsp:setProperty name="utsDbPool" property="maxTotal" value="5"/>
 <jsp:setProperty name="utsDbPool" property="maxIdle" value="3"/>
 <jsp:setProperty name="utsDbPool" property="minIdle" value="0"/>
 <jsp:setProperty name="utsDbPool" property="maxWaitMillis" value="12000"/>
 <jsp:setProperty name="utsDbPool" property="validationQuery" value="SELECT 1"/>
 <jsp:setProperty name="utsDbPool" property="testOnBorrow" value="true"/>
 <jsp:setProperty name="utsDbPool" property="validationQueryTimeout" value="5"/>
 <jsp:setProperty name="utsDbPool" property="testWhileIdle" value="true"/>
 <jsp:setProperty name="utsDbPool" property="timeBetweenEvictionRunsMillis" value="30000"/>
 <jsp:setProperty name="utsDbPool" property="minEvictableIdleTimeMillis" value="180000"/>
</jsp:useBean>
<c:set var="db" scope="request" value="${applicationScope.utsDbPool}"/>
