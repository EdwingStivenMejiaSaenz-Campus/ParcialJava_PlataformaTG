<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ include file="/WEB-INF/jspf/seguridad.jspf" %><c:if test="${sessionScope.rol ne 'ADMINISTRADOR'}"><c:redirect url="/dashboard.jsp"><c:param name="error" value="acceso"/></c:redirect></c:if><%@ include file="/WEB-INF/jspf/conexion.jspf" %>
<sql:query var="logs" dataSource="${db}">SELECT a.*,u.nombre AS responsable FROM auditoria a JOIN usuarios u ON u.id=a.usuario_id WHERE (?='' OR a.entidad LIKE CONCAT('%',?,'%')) AND (?='' OR a.accion LIKE CONCAT('%',?,'%')) AND (?='' OR a.usuario_id=CAST(NULLIF(?::text,'') AS bigint)) AND (?='' OR a.proyecto_id=CAST(NULLIF(?::text,'') AS bigint)) AND (?='' OR DATE(a.fecha)>=CAST(NULLIF(?::text,'') AS date)) AND (?='' OR DATE(a.fecha)<=CAST(NULLIF(?::text,'') AS date)) ORDER BY a.fecha DESC LIMIT 300
<sql:param value="${empty param.entidad ? '' : param.entidad}"/><sql:param value="${empty param.entidad ? '' : param.entidad}"/><sql:param value="${empty param.accion ? '' : param.accion}"/><sql:param value="${empty param.accion ? '' : param.accion}"/><sql:param value="${empty param.usuario ? '' : param.usuario}"/><sql:param value="${empty param.usuario ? '' : param.usuario}"/><sql:param value="${empty param.proyecto ? '' : param.proyecto}"/><sql:param value="${empty param.proyecto ? '' : param.proyecto}"/><sql:param value="${empty param.desde ? '' : param.desde}"/><sql:param value="${empty param.desde ? '' : param.desde}"/><sql:param value="${empty param.hasta ? '' : param.hasta}"/><sql:param value="${empty param.hasta ? '' : param.hasta}"/></sql:query>
<%@ include file="/WEB-INF/jspf/cabecera.jspf" %><h1>Auditoría</h1><p class="sub">Registro de cambios: usuario, entidad, valor anterior, valor nuevo y fecha.</p><div class="panel"><form method="get" class="form-grid"><div class="field"><label>Usuario ID</label><input name="usuario" value="<c:out value='${param.usuario}'/>"></div><div class="field"><label>Proyecto ID</label><input name="proyecto" value="<c:out value='${param.proyecto}'/>"></div><div class="field"><label>Entidad</label><input name="entidad" value="<c:out value='${param.entidad}'/>"></div><div class="field"><label>Acción</label><input name="accion" value="<c:out value='${param.accion}'/>"></div><div class="field"><label>Desde</label><input type="date" name="desde"></div><div class="field"><label>Hasta</label><input type="date" name="hasta"></div><div class="field"><label>&nbsp;</label><button>Buscar</button></div></form></div><div class="panel table-scroll"><table><tr><th>Fecha</th><th>Responsable</th><th>Proyecto</th><th>Entidad y acción</th><th>Antes / Después</th></tr><c:forEach var="a" items="${logs.rows}"><tr><td><c:out value="${a.fecha}"/></td><td><c:out value="${a.responsable}"/></td><td><c:out value="${a.proyecto_id}"/></td><td><c:out value="${a.entidad}"/> · <c:out value="${a.accion}"/></td><td><span class="mini">Anterior: <c:out value="${a.anterior}"/></span><div class="mini">Nuevo: <c:out value="${a.nuevo}"/></div></td></tr></c:forEach></table></div><%@ include file="/WEB-INF/jspf/pie.jspf" %>
