<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ include file="/WEB-INF/jspf/seguridad.jspf" %><c:if test="${sessionScope.rol ne 'COMITE'}"><c:redirect url="/dashboard.jsp"/></c:if><%@ include file="/WEB-INF/jspf/conexion.jspf" %>
<sql:query var="proyectos" dataSource="${db}">SELECT p.id,p.titulo,p.codigo,pb.acceso,pb.estado AS estado_publicacion,pb.motivo,pb.link_repositorio FROM proyectos p LEFT JOIN publicaciones pb ON pb.proyecto_id=p.id WHERE p.estado='FINALIZADO' ORDER BY p.id DESC LIMIT 200</sql:query>
<%@ include file="/WEB-INF/jspf/cabecera.jspf" %><h1>Publicaciones y protección documental</h1><p class="sub">Gestiona restricciones por propiedad intelectual, propiedad industrial o secreto empresarial. El repositorio institucional real debe disponer de una URL habilitada por UTS.</p><div class="panel"><c:forEach var="p" items="${proyectos.rows}"><form method="post" action="../acciones/guardar.jsp" class="panel form-grid"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="accion" value="publicacion_configurar"><input type="hidden" name="proyecto_id" value="${p.id}"><div class="field"><label>Proyecto</label><strong><c:out value="${p.codigo}"/> · <c:out value="${p.titulo}"/></strong></div><div class="field"><label>Nivel de acceso</label><select name="acceso"><option value="RESTRINGIDO">Restringido</option><option value="PUBLICO">Público autorizado</option><option value="RESERVADO">Reservado por derechos</option></select></div><div class="field"><label>Estado de publicación</label><select name="estado"><option value="PENDIENTE">Pendiente de publicación institucional</option><option value="PUBLICADO">Confirmada en repositorio institucional</option></select></div><div class="field"><label>Razón</label><input name="motivo" value="<c:out value='${p.motivo}'/>" maxlength="500"></div><div class="field"><label>URL oficial del repositorio (si se publicó)</label><input name="link_repositorio" type="url" value="<c:out value='${p.link_repositorio}'/>" placeholder="https://..."></div><div class="field"><label>&nbsp;</label><button>Guardar restricción / publicación</button></div></form></c:forEach></div><%@ include file="/WEB-INF/jspf/pie.jspf" %>