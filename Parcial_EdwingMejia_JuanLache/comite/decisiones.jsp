<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ include file="/WEB-INF/jspf/seguridad.jspf" %><c:if test="${sessionScope.rol ne 'COMITE'}"><c:redirect url="/dashboard.jsp"><c:param name="error" value="acceso"/></c:redirect></c:if><%@ include file="/WEB-INF/jspf/conexion.jspf" %>
<sql:query var="proyectos" dataSource="${db}">SELECT p.*,u.nombre AS estudiante FROM proyectos p JOIN usuarios u ON u.id=p.estudiante_id ORDER BY p.modificado_en DESC LIMIT 150</sql:query><sql:query var="pendientes" dataSource="${db}">SELECT c.*,p.titulo,m1.nombre AS anterior,m2.nombre AS nueva FROM cambios_modalidad c JOIN proyectos p ON p.id=c.proyecto_id JOIN modalidades m1 ON m1.id=c.anterior_id JOIN modalidades m2 ON m2.id=c.nueva_id WHERE c.estado='PENDIENTE' ORDER BY c.fecha</sql:query>
<sql:query var="actas" dataSource="${db}">SELECT token,proyecto_id,nombre FROM archivos WHERE estado='COMPLETO' AND tipo='Acta del Comité' ORDER BY creado_en DESC</sql:query><%@ include file="/WEB-INF/jspf/cabecera.jspf" %><h1>Decisiones del Comité</h1><p class="sub">Revisa las propuestas, los conceptos de evaluación y los cambios solicitados.</p><div class="panel table-scroll"><h2>Proyectos</h2><table><tr><th>Proyecto</th><th>Fase / estado</th><th>Expediente</th><th>Registrar decisión</th></tr><c:forEach var="p" items="${proyectos.rows}"><tr><td><strong><c:out value="${p.titulo}"/></strong><div class="mini"><c:out value="${p.estudiante}"/> · <c:out value="${p.codigo}"/></div></td><td>${p.fase} · ${p.estado}</td><td><a href="../comun/historial.jsp?id=${p.id}">Ver historial</a><form data-upload-uts data-destino="../acciones/subir_archivo.jsp"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="proyecto_id" value="${p.id}"><input type="hidden" name="tipo" value="Acta del Comité"><label>Archivo de acta (PDF)</label><input type="file" accept=".pdf,application/pdf" required><button type="submit">Subir acta</button><span data-estado role="status"></span></form></td><td><form method="post" action="../acciones/guardar.jsp"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="accion" value="comite_decidir"><input type="hidden" name="proyecto_id" value="${p.id}"><div class="field"><select name="resultado"><option value="APROBADO">Aprobar propuesta</option><option value="NO_APROBADO">No aprobar</option><option value="DEVUELTO">Devolver propuesta</option><option value="FINALIZADO">Cierre definitivo</option></select></div><div class="field"><input name="observacion" required placeholder="Justificación de la decisión"></div><div class="field"><input type="url" name="acta_url" placeholder="https://... acta institucional (opcional)"></div><div class="field"><label>O adjuntar acta cargada</label><select name="acta_token"><option value="">Sin archivo adjunto</option><c:forEach var="a" items="${actas.rows}"><c:if test="${a.proyecto_id eq p.id}"><option value="${a.token}"><c:out value="${a.nombre}"/></option></c:if></c:forEach></select></div><button>Guardar decisión</button></form><c:if test="${p.fase eq 'DESARROLLO'}"><form method="post" action="../acciones/guardar.jsp"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="accion" value="autorizar_cambio_oficial"><input type="hidden" name="proyecto_id" value="${p.id}"><input name="motivo" required placeholder="Motivo de cambio oficial"><button>Autorizar nueva versión</button></form></c:if></td></tr></c:forEach></table></div>
<div class="panel table-scroll"><h2>Solicitudes de cambio de modalidad</h2><table><tr><th>Proyecto</th><th>Solicitud</th><th>Motivo</th><th>Resolver</th></tr><c:forEach var="c" items="${pendientes.rows}"><tr><td><c:out value="${c.titulo}"/></td><td><c:out value="${c.anterior}"/> → <c:out value="${c.nueva}"/></td><td><c:out value="${c.motivo}"/></td><td><form method="post" action="../acciones/guardar.jsp" class="actions-inline"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="accion" value="cambio_resolver"><input type="hidden" name="id" value="${c.id}"><select name="estado"><option value="APROBADO">Aprobar</option><option value="RECHAZADO">Rechazar</option></select><button>Resolver</button></form></td></tr></c:forEach></table></div><script src="${pageContext.request.contextPath}/js/archivos.js" defer></script><%@ include file="/WEB-INF/jspf/pie.jspf" %>
