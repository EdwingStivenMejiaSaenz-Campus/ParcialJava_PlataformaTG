<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ include file="/WEB-INF/jspf/seguridad.jspf" %><c:if test="${sessionScope.rol ne 'COMITE'}"><c:redirect url="/dashboard.jsp"><c:param name="error" value="acceso"/></c:redirect></c:if><%@ include file="/WEB-INF/jspf/conexion.jspf" %>
<sql:query var="periodos" dataSource="${db}">SELECT * FROM periodos ORDER BY inicio DESC</sql:query>
<sql:query var="actividades" dataSource="${db}">SELECT c.*,p.nombre AS periodo FROM calendario c JOIN periodos p ON p.id=c.periodo_id ORDER BY c.inicio DESC LIMIT 150</sql:query><%@ include file="/WEB-INF/jspf/cabecera.jspf" %><h1>Periodos y calendario</h1><p class="sub">Creación, cierre y parametrización de fechas para los trabajos de grado.</p>
<div class="panel"><h2>Nuevo periodo</h2><form method="post" action="../acciones/guardar.jsp"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="accion" value="periodo_crear"><div class="form-grid"><div class="field"><label>Nombre</label><input name="nombre" required placeholder="2026-II"></div><div class="field"><label>Fecha de inicio</label><input type="date" name="inicio" required></div><div class="field"><label>Fin</label><input type="date" name="fin" required></div><div class="field"><label>Apertura del banco</label><input type="date" name="apertura" required></div><div class="field"><label>Cierre del banco</label><input type="date" name="cierre" required></div></div><div class="buttons"><button>Crear periodo</button></div></form></div>
<div class="panel"><h2>Periodos disponibles</h2><div class="table-scroll"><table><tr><th>Periodo</th><th>Fechas</th><th>Banco</th><th>Estado</th></tr><c:forEach var="p" items="${periodos.rows}"><tr><td><c:out value="${p.nombre}"/></td><td>${p.inicio} - ${p.fin}</td><td>${p.apertura_banco} a ${p.cierre_banco}</td><td><form class="actions-inline" method="post" action="../acciones/guardar.jsp"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="accion" value="periodo_estado"><input type="hidden" name="id" value="${p.id}"><select name="estado"><option value="BORRADOR">Borrador</option><option value="ACTIVO" <c:if test="${p.estado eq 'ACTIVO'}">selected</c:if>>Activo</option><option value="CERRADO" <c:if test="${p.estado eq 'CERRADO'}">selected</c:if>>Cerrado</option></select><button>Guardar</button></form></td></tr></c:forEach></table></div></div>
<div class="panel"><h2>Modificar periodos y fechas</h2><c:forEach var="p" items="${periodos.rows}"><form class="form-grid panel" method="post" action="../acciones/guardar.jsp"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="accion" value="periodo_actualizar"><input type="hidden" name="id" value="${p.id}"><div class="field"><label>Nombre</label><input name="nombre" value="<c:out value='${p.nombre}'/>" required></div><div class="field"><label>Inicio</label><input type="date" name="inicio" value="${p.inicio}" required></div><div class="field"><label>Fin</label><input type="date" name="fin" value="${p.fin}" required></div><div class="field"><label>Abre banco</label><input type="date" name="apertura" value="${p.apertura_banco}" required></div><div class="field"><label>Cierra banco</label><input type="date" name="cierre" value="${p.cierre_banco}" required></div><div class="field"><label>&nbsp;</label><button <c:if test="${p.estado eq 'CERRADO'}">disabled</c:if>>Actualizar periodo</button></div></form></c:forEach></div>
<div class="panel"><h2>Agregar fecha al calendario</h2><form method="post" action="../acciones/guardar.jsp"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="accion" value="calendario_crear"><div class="form-grid"><div class="field"><label>Periodo</label><select name="periodo_id"><c:forEach var="p" items="${periodos.rows}"><option value="${p.id}"><c:out value="${p.nombre}"/></option></c:forEach></select></div><div class="field"><label>Actividad / fase</label><input name="actividad" required></div><div class="field"><label>Inicio</label><input type="datetime-local" name="inicio" required></div><div class="field"><label>Cierre</label><input type="datetime-local" name="fin" required></div></div><div class="buttons"><button>Agregar al calendario</button></div></form></div><div class="panel"><h2>Reprogramar actividades del calendario</h2><c:forEach var="a" items="${actividades.rows}"><form method="post" action="../acciones/guardar.jsp" class="form-grid panel"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="accion" value="calendario_actualizar"><input type="hidden" name="id" value="${a.id}"><div class="field"><label>Actividad · <c:out value="${a.periodo}"/></label><input name="actividad" value="<c:out value='${a.actividad}'/>" required></div><div class="field"><label>Inicio</label><input type="datetime-local" name="inicio" value="${fn:replace(fn:substring(a.inicio,0,16),' ','T')}" required></div><div class="field"><label>Fin</label><input type="datetime-local" name="fin" value="${fn:replace(fn:substring(a.fin,0,16),' ','T')}" required></div><div class="field"><label>&nbsp;</label><button>Guardar cambio</button></div></form></c:forEach></div><%@ include file="/WEB-INF/jspf/pie.jspf" %>
