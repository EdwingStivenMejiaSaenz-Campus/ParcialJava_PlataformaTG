<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ include file="/WEB-INF/jspf/seguridad.jspf" %><c:if test="${sessionScope.rol ne 'COMITE'}"><c:redirect url="/dashboard.jsp"><c:param name="error" value="acceso"/></c:redirect></c:if><%@ include file="/WEB-INF/jspf/conexion.jspf" %>
<sql:query var="programas" dataSource="${db}">SELECT * FROM programas WHERE activo=1 ORDER BY nombre</sql:query><sql:query var="grupos" dataSource="${db}">SELECT g.*,p.nombre AS programa FROM grupos_investigacion g JOIN programas p ON p.id=g.programa_id ORDER BY g.nombre</sql:query><sql:query var="formatos" dataSource="${db}">SELECT * FROM formatos ORDER BY nombre</sql:query>
<%@ include file="/WEB-INF/jspf/cabecera.jspf" %><h1>Catálogos y documentos</h1><p class="sub">Grupos, líneas de investigación y formatos institucionales.</p><div class="grid"><div class="panel"><h2>Grupo de investigación</h2><form method="post" action="../acciones/guardar.jsp"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="accion" value="grupo_crear"><div class="field"><label>Nombre</label><input name="nombre" required></div><div class="field"><label>Programa</label><select name="programa_id"><c:forEach var="p" items="${programas.rows}"><option value="${p.id}"><c:out value="${p.nombre}"/></option></c:forEach></select></div><div class="buttons"><button>Registrar grupo</button></div></form></div><div class="panel"><h2>Línea de investigación</h2><form method="post" action="../acciones/guardar.jsp"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="accion" value="linea_crear"><div class="field"><label>Nombre</label><input name="nombre" required></div><div class="field"><label>Grupo</label><select name="grupo_id"><c:forEach var="g" items="${grupos.rows}"><option value="${g.id}"><c:out value="${g.nombre}"/> · <c:out value="${g.programa}"/></option></c:forEach></select></div><div class="buttons"><button>Registrar línea</button></div></form></div></div>
<div class="panel"><h2>Registrar formato institucional</h2><form method="post" action="../acciones/guardar.jsp"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="accion" value="formato_crear"><div class="form-grid"><div class="field"><label>Nombre</label><input name="nombre" required></div><div class="field"><label>Versión</label><input name="version" required></div><div class="field"><label>URL institucional HTTPS</label><input type="url" name="url" required></div></div><div class="buttons"><button>Registrar formato</button></div></form><div class="table-scroll"><table><tr><th>Documento</th><th>Versión</th></tr><c:forEach var="f" items="${formatos.rows}"><tr><td><c:out value="${f.nombre}"/></td><td><c:out value="${f.version}"/></td></tr></c:forEach></table></div></div><%@ include file="/WEB-INF/jspf/pie.jspf" %>
