<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ include file="/WEB-INF/jspf/seguridad.jspf" %><c:if test="${sessionScope.rol ne 'COMITE'}"><c:redirect url="/dashboard.jsp"/></c:if><%@ include file="/WEB-INF/jspf/conexion.jspf" %>
<sql:query var="modalidades" dataSource="${db}">SELECT id,nombre FROM modalidades WHERE activo=1 ORDER BY nombre</sql:query><sql:query var="entregables" dataSource="${db}">SELECT e.*,m.nombre FROM entregables_modalidad e JOIN modalidades m ON m.id=e.modalidad_id ORDER BY m.nombre,e.tipo</sql:query>
<%@ include file="/WEB-INF/jspf/cabecera.jspf" %><h1>Entregables obligatorios por modalidad</h1><p class="sub">Configurar según la normativa vigente los documentos necesarios para permitir el cierre académico.</p><div class="panel"><form method="post" action="../acciones/guardar.jsp" class="form-grid"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="accion" value="entregable_parametrizar"><div class="field"><label>Modalidad</label><select name="modalidad_id"><c:forEach var="m" items="${modalidades.rows}"><option value="${m.id}"><c:out value="${m.nombre}"/></option></c:forEach></select></div><div class="field"><label>Tipo de documento</label><select name="tipo"><option>Informe Final</option><option>Manual de usuario</option><option>Código fuente</option><option>Soporte</option><option>Desarrollo</option></select></div><div class="field"><label>¿Es obligatorio?</label><select name="obligatorio"><option value="1">Sí</option><option value="0">No</option></select></div><button>Guardar</button></form></div><div class="panel table-scroll"><table><tr><th>Modalidad</th><th>Documento</th><th>Obligatorio</th></tr><c:forEach var="e" items="${entregables.rows}"><tr><td><c:out value="${e.nombre}"/></td><td>${e.tipo}</td><td>${(e.obligatorio eq 1) ? 'Sí' : 'No'}</td></tr></c:forEach></table></div><%@ include file="/WEB-INF/jspf/pie.jspf" %>
