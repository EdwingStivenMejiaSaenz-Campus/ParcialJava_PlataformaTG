<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ include file="/WEB-INF/jspf/seguridad.jspf" %><c:if test="${sessionScope.rol ne 'COMITE'}"><c:redirect url="/dashboard.jsp"/></c:if><%@ include file="/WEB-INF/jspf/conexion.jspf" %>
<sql:query var="modalidades" dataSource="${db}">SELECT id,nombre FROM modalidades WHERE activo=1 ORDER BY nombre</sql:query>
<sql:query var="politicas" dataSource="${db}">SELECT r.*,m.nombre FROM reglas_pagos r JOIN modalidades m ON m.id=r.modalidad_id ORDER BY m.nombre,r.plan</sql:query>
<%@ include file="/WEB-INF/jspf/cabecera.jspf" %><h1>Vigencia de pagos</h1><p class="sub">Solo el Comité puede parametrizar, con base en la regla institucional aplicable, cuántos periodos dura cada pago según modalidad y plan.</p><div class="panel"><form method="post" action="../acciones/guardar.jsp" class="form-grid"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="accion" value="regla_pago"><div class="field"><label>Modalidad</label><select name="modalidad_id"><c:forEach var="m" items="${modalidades.rows}"><option value="${m.id}"><c:out value="${m.nombre}"/></option></c:forEach></select></div><div class="field"><label>Tipo de plan</label><select name="plan"><option>ANTERIOR</option><option>POSTERIOR</option></select></div><div class="field"><label>Vigencia en periodos académicos</label><input type="number" name="periodos_vigencia" min="1" max="24" required></div><div class="field"><label>¿Requiere pago?</label><select name="requiere_pago"><option value="1">Sí</option><option value="0">No</option></select></div><button>Guardar regla</button></form></div><div class="panel table-scroll"><table><tr><th>Modalidad</th><th>Plan</th><th>Vigencia</th><th>Pago</th></tr><c:forEach var="r" items="${politicas.rows}"><tr><td><c:out value="${r.nombre}"/></td><td>${r.plan}</td><td>${r.periodos_vigencia} periodo(s)</td><td>${(r.requiere_pago eq 1) ? 'Sí' : 'No'}</td></tr></c:forEach></table></div><%@ include file="/WEB-INF/jspf/pie.jspf" %>
