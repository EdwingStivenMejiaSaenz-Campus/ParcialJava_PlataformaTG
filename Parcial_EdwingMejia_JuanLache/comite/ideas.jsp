<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ include file="/WEB-INF/jspf/seguridad.jspf" %><c:if test="${sessionScope.rol ne 'COMITE'}"><c:redirect url="/dashboard.jsp"><c:param name="error" value="acceso"/></c:redirect></c:if><%@ include file="/WEB-INF/jspf/conexion.jspf" %>
<sql:query var="periodos" dataSource="${db}">SELECT * FROM periodos ORDER BY inicio DESC</sql:query><sql:query var="programas" dataSource="${db}">SELECT * FROM programas WHERE activo=1</sql:query><sql:query var="modalidades" dataSource="${db}">SELECT * FROM modalidades WHERE activo=1</sql:query><sql:query var="ideas" dataSource="${db}">SELECT i.*,p.nombre AS programa, pe.nombre AS periodo FROM ideas i JOIN programas p ON p.id=i.programa_id JOIN periodos pe ON pe.id=i.periodo_id ORDER BY i.id DESC LIMIT 100</sql:query>
<%@ include file="/WEB-INF/jspf/cabecera.jspf" %><h1>Banco de ideas</h1><p class="sub">Ideas disponibles por programa, nivel, modalidad y periodo.</p><div class="panel"><h2>Registrar nueva idea</h2><form method="post" action="../acciones/guardar.jsp"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="accion" value="idea_crear"><div class="form-grid"><div class="field"><label>Periodo</label><select name="periodo_id"><c:forEach var="p" items="${periodos.rows}"><option value="${p.id}"><c:out value="${p.nombre}"/></option></c:forEach></select></div><div class="field"><label>Programa</label><select name="programa_id"><c:forEach var="p" items="${programas.rows}"><option value="${p.id}"><c:out value="${p.nombre}"/></option></c:forEach></select></div><div class="field"><label>Nivel</label><select name="nivel"><option value="">Todos los niveles</option><option value="TECNICO">Técnico</option><option value="TECNOLOGO">Tecnólogo</option><option value="PROFESIONAL">Profesional</option></select></div><div class="field"><label>Modalidad</label><select name="modalidad_id"><c:forEach var="m" items="${modalidades.rows}"><option value="${m.id}"><c:out value="${m.nombre}"/></option></c:forEach></select></div><div class="field wide"><label>Título</label><input name="titulo" required maxlength="220"></div><div class="field wide"><label>Descripción</label><textarea name="descripcion" required></textarea></div></div><div class="buttons"><button>Crear idea</button></div></form></div><div class="panel table-scroll"><h2>Gestionar ideas</h2><table><tr><th>Idea</th><th>Periodo / programa</th><th>Estado</th></tr><c:forEach var="i" items="${ideas.rows}"><tr><td><form id="idea-${i.id}" method="post" action="../acciones/guardar.jsp"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="accion" value="idea_actualizar"><input type="hidden" name="id" value="${i.id}"></form><input form="idea-${i.id}" name="titulo" aria-label="Título de la idea" value="<c:out value='${i.titulo}'/>" required><textarea form="idea-${i.id}" name="descripcion" aria-label="Descripción" required><c:out value="${i.descripcion}"/></textarea></td><td><c:out value="${i.periodo}"/> / <c:out value="${i.programa}"/></td><td><div class="actions-inline"><select form="idea-${i.id}" name="estado"><option value="ABIERTA">Abierta</option><option value="CERRADA" <c:if test="${i.estado eq 'CERRADA'}">selected</c:if>>Cerrada</option></select><button form="idea-${i.id}">Guardar cambios</button></div></td></tr></c:forEach></table></div><%@ include file="/WEB-INF/jspf/pie.jspf" %>
