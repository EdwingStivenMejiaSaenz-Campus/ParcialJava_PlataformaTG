<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ include file="/WEB-INF/jspf/seguridad.jspf" %><%@ include file="/WEB-INF/jspf/conexion.jspf" %>
<sql:query var="q" dataSource="${db}">SELECT p.*,u.nombre AS estudiante,m.nombre AS modalidad,pe.nombre AS periodo FROM proyectos p JOIN usuarios u ON u.id=p.estudiante_id JOIN modalidades m ON m.id=p.modalidad_id JOIN periodos pe ON pe.id=p.periodo_id WHERE p.id=CAST(NULLIF(?::text,'') AS bigint) AND ((? IN('COMITE','ADMINISTRADOR')) OR (?='ESTUDIANTE' AND EXISTS(SELECT 1 FROM proyecto_estudiantes s WHERE s.proyecto_id=p.id AND s.estudiante_id=CAST(NULLIF(?::text,'') AS bigint))) OR (?='DIRECTOR' AND p.director_id=CAST(NULLIF(?::text,'') AS bigint)) OR (?='EVALUADOR' AND (p.evaluador_id=CAST(NULLIF(?::text,'') AS bigint) OR p.evaluador_propuesta_excepcion_id=CAST(NULLIF(?::text,'') AS bigint)))) LIMIT 1
<sql:param value="${param.id}"/><sql:param value="${sessionScope.rol}"/><sql:param value="${sessionScope.rol}"/><sql:param value="${sessionScope.usuarioId}"/><sql:param value="${sessionScope.rol}"/><sql:param value="${sessionScope.usuarioId}"/><sql:param value="${sessionScope.rol}"/><sql:param value="${sessionScope.usuarioId}"/><sql:param value="${sessionScope.usuarioId}"/></sql:query>
<c:if test="${empty q.rows}"><c:redirect url="/dashboard.jsp"><c:param name="error" value="acceso"/></c:redirect></c:if><c:set var="p" value="${q.rows[0]}"/>
<sql:query var="estadoFases" dataSource="${db}">
SELECT
(SELECT COUNT(*) FROM pagos WHERE proyecto_id=CAST(?::text AS bigint) AND estado='VALIDADO') AS pago,
(SELECT COUNT(*) FROM decisiones WHERE proyecto_id=CAST(?::text AS bigint) AND tipo='PROPUESTA' AND resultado='APROBADO') AS aprobada,
(SELECT COUNT(*) FROM evaluaciones WHERE proyecto_id=CAST(?::text AS bigint) AND tipo='PROPUESTA' AND estado='DEFINITIVA') AS propuesta,
(SELECT COUNT(*) FROM historial WHERE proyecto_id=CAST(?::text AS bigint) AND evento ILIKE '%informe%' AND (nuevo='INFORME_AVALADO' OR evento ILIKE '%Aval%')) AS informe,
(SELECT COUNT(*) FROM evaluaciones WHERE proyecto_id=CAST(?::text AS bigint) AND tipo='INFORME_FINAL' AND estado='DEFINITIVA') AS eval_final,
(SELECT COUNT(*) FROM documentos WHERE proyecto_id=CAST(?::text AS bigint)) AS documentos,
(SELECT COUNT(*) FROM sustentaciones WHERE proyecto_id=CAST(?::text AS bigint) AND UPPER(estado) IN ('REALIZADA','FINALIZADA','APROBADA','CERRADA')) AS cierre_final
<sql:param value="${p.id}"/><sql:param value="${p.id}"/><sql:param value="${p.id}"/><sql:param value="${p.id}"/><sql:param value="${p.id}"/><sql:param value="${p.id}"/><sql:param value="${p.id}"/>
</sql:query>
<c:set var="pago" value="${estadoFases}"/>
<c:set var="faseAprobada" value="${estadoFases}"/>
<c:set var="evaluacionProp" value="${estadoFases}"/>
<c:set var="avalFinal" value="${estadoFases}"/>
<c:set var="evaluacionFinal" value="${estadoFases}"/>
<c:set var="documentos" value="${estadoFases}"/>
<sql:query var="periodo" dataSource="${db}">SELECT c.actividad,c.inicio,c.fin FROM calendario c WHERE c.periodo_id=CAST(NULLIF(?::text,'') AS bigint) ORDER BY c.inicio LIMIT 20<sql:param value="${p.periodo_id}"/></sql:query>
<sql:query var="actas" dataSource="${db}">SELECT token,nombre FROM archivos WHERE proyecto_id=CAST(NULLIF(?::text,'') AS bigint) AND tipo='Acta del Comité' AND estado='COMPLETO' ORDER BY creado_en DESC<sql:param value="${p.id}"/></sql:query>
<c:set var="f1" value="${estadoFases.rows[0].pago gt 0}"/><c:set var="f2" value="${p.estado eq 'AVAL_DIRECTOR' or p.estado eq 'EN_EVALUACION' or p.estado eq 'EVALUADA' or p.fase ne 'PROPUESTA'}"/>
<c:set var="f3" value="${estadoFases.rows[0].aprobada gt 0}"/><c:set var="f4" value="${estadoFases.rows[0].informe gt 0 or p.estado eq 'INFORME_AVALADO' or p.estado eq 'EN_EVALUACION_FINAL' or p.estado eq 'LISTO_SUSTENTACION' or p.estado eq 'FINALIZADO'}"/>
<c:set var="f5" value="${estadoFases.rows[0].eval_final gt 0 and (p.estado eq 'FINALIZADO' or p.estado eq 'LISTO_SUSTENTACION')}"/>
<c:set var="f6" value="${f5 and estadoFases.rows[0].cierre_final gt 0 and p.estado eq 'FINALIZADO'}"/>
<c:if test="${sessionScope.rol eq 'COMITE'}"><sql:query var="ajustes" dataSource="${db}">SELECT * FROM ajustes_proyecto_uts WHERE proyecto_id=CAST(NULLIF(?::text,'') AS bigint)<sql:param value="${p.id}"/></sql:query><sql:query var="estudiantesAjuste" dataSource="${db}">SELECT u.id,u.nombre FROM usuarios u JOIN proyecto_estudiantes pe ON pe.estudiante_id=u.id WHERE pe.proyecto_id=CAST(NULLIF(?::text,'') AS bigint)<sql:param value="${p.id}"/></sql:query></c:if>
<%@ include file="/WEB-INF/jspf/cabecera.jspf" %>
<div class="uts-toolbar"><h1 class="uts-heading">Seguimiento del <b>PROYECTO</b></h1><div class="uts-toolbuttons">
<c:if test="${sessionScope.rol eq 'COMITE'}"><a class="icon-action red" href="reportes.jsp?proyecto_id=${p.id}" title="Enviar reporte del sistema"><svg class="ui-icon" aria-hidden="true"><use href="${pageContext.request.contextPath}/img/icons.svg#warning"/></svg></a><button class="icon-action green" type="button" data-modal="beneficio-modal" title="Beneficio Saber TyT/PRO"><svg class="ui-icon" aria-hidden="true"><use href="${pageContext.request.contextPath}/img/icons.svg#award"/></svg></button></c:if>
<button class="icon-action green" type="button" data-modal="calendario-modal" title="Calendario de proyecto"><svg class="ui-icon" aria-hidden="true"><use href="${pageContext.request.contextPath}/img/icons.svg#calendar"/></svg></button><c:if test="${sessionScope.rol eq 'COMITE'}"><button class="icon-action dark" type="button" data-modal="ajustes-modal" title="Ajustes del proyecto"><svg class="ui-icon" aria-hidden="true"><use href="${pageContext.request.contextPath}/img/icons.svg#settings"/></svg></button></c:if><a href="proyectos_visual.jsp?tipo=${p.modalidad eq 'Práctica' ? 'practicas' : 'proyectos'}" class="icon-action green"><svg class="ui-icon" aria-hidden="true"><use href="${pageContext.request.contextPath}/img/icons.svg#arrowleft"/></svg> Volver</a></div></div>
<p class="uts-small">Aquí podrás llevar el seguimiento del progreso del proyecto de grado en curso. <strong><c:out value="${p.codigo}"/></strong> · <c:out value="${p.titulo}"/></p>
<div class="uts-phases">
<div class="uts-phase ${f1 ? 'done' : 'current'}"><div class="phase-symbol"><svg class="ui-icon uts-phase-icon" aria-hidden="true"><use href="${pageContext.request.contextPath}/img/icons.svg#phase-check"/></svg></div><strong>Fase 1: Pago</strong><small>El estudiante describe su idea y sube el pago.</small><div class="phase-controls"><button type="button" class="icon-action blue" data-modal="detalle-f1" title="Ver detalles de la fase 1"><svg class="ui-icon" aria-hidden="true"><use href="${pageContext.request.contextPath}/img/icons.svg#eye"/></svg></button><c:if test="${sessionScope.rol eq 'COMITE' or (sessionScope.rol eq 'ESTUDIANTE' and not f1)}"><button type="button" class="icon-action sky" data-modal="responder-f1" title="Gestionar fase 1"><svg class="ui-icon" aria-hidden="true"><use href="${pageContext.request.contextPath}/img/icons.svg#send"/></svg></button></c:if></div></div>
<div class="uts-phase ${f2 ? 'done' : (f1 ? 'current' : '')}"><div class="phase-symbol"><svg class="ui-icon uts-phase-icon" aria-hidden="true"><use href="${pageContext.request.contextPath}/img/icons.svg#phase-hourglass"/></svg></div><strong>Fase 2: Propuesta I</strong><small>El estudiante envía la propuesta al director.</small><div class="phase-controls"><button type="button" class="icon-action blue" data-modal="detalle-f2" title="Ver detalles de la fase 2"><svg class="ui-icon" aria-hidden="true"><use href="${pageContext.request.contextPath}/img/icons.svg#eye"/></svg></button><c:if test="${f1 and (sessionScope.rol eq 'DIRECTOR' or sessionScope.rol eq 'ESTUDIANTE')}"><button type="button" class="icon-action sky" data-modal="responder-f2" title="Responder fase 2"><svg class="ui-icon" aria-hidden="true"><use href="${pageContext.request.contextPath}/img/icons.svg#send"/></svg></button></c:if></div></div>
<div class="uts-phase ${f3 ? 'done' : (f2 ? 'current' : '')}"><div class="phase-symbol"><svg class="ui-icon uts-phase-icon" aria-hidden="true"><use href="${pageContext.request.contextPath}/img/icons.svg#phase-plane"/></svg></div><strong>Fase 3: Propuesta II</strong><small>El director envía la propuesta al evaluador y comité.</small><div class="phase-controls"><button type="button" class="icon-action blue" data-modal="detalle-f3" title="Ver detalles de la fase 3"><svg class="ui-icon" aria-hidden="true"><use href="${pageContext.request.contextPath}/img/icons.svg#eye"/></svg></button><c:if test="${f2 and (sessionScope.rol eq 'EVALUADOR' or sessionScope.rol eq 'COMITE')}"><button type="button" class="icon-action sky" data-modal="responder-f3" title="Responder fase 3"><svg class="ui-icon" aria-hidden="true"><use href="${pageContext.request.contextPath}/img/icons.svg#send"/></svg></button></c:if></div></div>
<div class="uts-phase ${f4 ? 'done' : (f3 ? 'current' : '')}"><div class="phase-symbol"><svg class="ui-icon uts-phase-icon" aria-hidden="true"><use href="${pageContext.request.contextPath}/img/icons.svg#phase-hourglass"/></svg></div><strong>Fase 4: Informe I</strong><small>El estudiante envía el informe al director.</small><div class="phase-controls"><button type="button" class="icon-action blue" data-modal="detalle-f4" title="Ver detalles de la fase 4"><svg class="ui-icon" aria-hidden="true"><use href="${pageContext.request.contextPath}/img/icons.svg#eye"/></svg></button><c:if test="${f3 and (sessionScope.rol eq 'ESTUDIANTE' or sessionScope.rol eq 'DIRECTOR')}"><button type="button" class="icon-action sky" data-modal="responder-f4" title="Responder fase 4"><svg class="ui-icon" aria-hidden="true"><use href="${pageContext.request.contextPath}/img/icons.svg#send"/></svg></button></c:if></div></div>
<div class="uts-phase ${f5 ? 'done' : (f4 ? 'current' : '')}"><div class="phase-symbol"><svg class="ui-icon uts-phase-icon" aria-hidden="true"><use href="${pageContext.request.contextPath}/img/icons.svg#phase-plane"/></svg></div><strong>Fase 5: Informe II</strong><small>El director envía el informe al evaluador y comité.</small><div class="phase-controls"><button type="button" class="icon-action blue" data-modal="detalle-f5" title="Ver detalles de la fase 5"><svg class="ui-icon" aria-hidden="true"><use href="${pageContext.request.contextPath}/img/icons.svg#eye"/></svg></button><c:if test="${f4 and (sessionScope.rol eq 'EVALUADOR' or sessionScope.rol eq 'COMITE' or sessionScope.rol eq 'DIRECTOR')}"><button type="button" class="icon-action sky" data-modal="responder-f5" title="Responder fase 5"><svg class="ui-icon" aria-hidden="true"><use href="${pageContext.request.contextPath}/img/icons.svg#send"/></svg></button></c:if></div></div>
</div>
<div class="uts-final-phase ${f6 ? 'is-complete' : (f5 ? 'is-ready' : 'is-locked')}" aria-label="Fase final: Sustentación y cierre">
  <div class="phase-symbol"><svg class="ui-icon uts-phase-icon" aria-hidden="true"><use href="${pageContext.request.contextPath}/img/icons.svg#phase-cap"/></svg></div>
  <strong>Fase final: Sustentación y cierre</strong>
  <c:choose>
    <c:when test="${f6}"><p class="uts-small">Sustentación y cierre registrados.</p></c:when>
    <c:when test="${f5}"><p class="uts-small">Fase 5 superada. Continúa el proceso de sustentación.</p></c:when>
    <c:otherwise><p class="uts-small">Se habilita después de completar la Fase 5.</p></c:otherwise>
  </c:choose>
  <c:if test="${f5 and not f6 and sessionScope.rol eq 'COMITE'}"><a class="btn secondary" href="../comite/sustentaciones.jsp">Gestionar sustentación</a></c:if>
  <c:if test="${f5 and not f6 and sessionScope.rol eq 'EVALUADOR'}"><a class="btn secondary" href="../evaluador/sustentacion.jsp">Registrar concepto</a></c:if>
</div>
<section class="uts-project-summary" aria-label="Información del proyecto">
  <div class="uts-project-summary-header">
    <div><h2>Información del proyecto</h2><p>Estado y responsables registrados en el expediente.</p></div>
    <a class="uts-history-link" href="historial.jsp?id=${p.id}">
      <svg class="ui-icon" aria-hidden="true"><use href="${pageContext.request.contextPath}/img/icons.svg#list"/></svg>
      Ver expediente completo
    </a>
  </div>
  <div class="uts-summary-grid">
    <div class="uts-summary-item"><span>Etapa actual</span><strong><c:choose><c:when test="${p.fase eq 'PROPUESTA'}">Propuesta</c:when><c:when test="${p.fase eq 'DESARROLLO'}">Desarrollo</c:when><c:when test="${p.fase eq 'CIERRE'}">Cierre</c:when><c:otherwise><c:out value="${p.fase}"/></c:otherwise></c:choose></strong></div>
    <div class="uts-summary-item"><span>Estado académico</span><strong><c:choose><c:when test="${p.estado eq 'BORRADOR'}">En preparación</c:when><c:when test="${p.estado eq 'EN_REVISION'}">En revisión por el director</c:when><c:when test="${p.estado eq 'EN_EVALUACION'}">En evaluación</c:when><c:when test="${p.estado eq 'FINALIZADO'}">Finalizado</c:when><c:when test="${p.estado eq 'INFORME_EN_REVISION'}">Informe en revisión</c:when><c:when test="${p.estado eq 'EN_EVALUACION_FINAL'}">Informe en evaluación</c:when><c:when test="${p.estado eq 'EVALUADA'}">Propuesta evaluada</c:when><c:when test="${p.estado eq 'LISTO_SUSTENTACION'}">Listo para sustentación</c:when><c:when test="${p.estado eq 'INFORME_AVALADO'}">Informe avalado</c:when><c:otherwise><c:out value="${p.estado}"/></c:otherwise></c:choose></strong></div>
    <div class="uts-summary-item"><span>Estudiante vinculado</span><strong><c:out value="${p.estudiante}"/></strong></div>
  </div>
</section>
<c:forEach begin="1" end="5" var="n"><dialog class="uts-dialog" id="detalle-f${n}"><div class="uts-dialog-inner"><button class="dialog-close" type="button" data-close-modal aria-label="Cerrar">×</button><h2>Detalles del <span class="uts-tag fase">PROYECTO · FASE ${n}</span></h2><p><c:out value="${p.titulo}"/></p><p>Estado general: <strong><c:out value="${p.estado}"/></strong></p><p class="uts-small"><c:choose><c:when test="${n eq 1}">Pago validado: ${f1 ? 'Sí' : 'No'}.</c:when><c:when test="${n eq 2}">Aval del director: ${f2 ? 'Registrado' : 'Pendiente'}.</c:when><c:when test="${n eq 3}">Evaluaciones recibidas: ${estadoFases.rows[0].propuesta}. Decisión: ${f3 ? 'Aprobada' : 'Pendiente'}.</c:when><c:when test="${n eq 4}">Documentos registrados: ${estadoFases.rows[0].documentos}. Aval del informe: ${f4 ? 'Registrado' : 'Pendiente'}.</c:when><c:otherwise>Evaluación final registrada: ${estadoFases.rows[0].eval_final gt 0 ? 'Sí' : 'No'}.</c:otherwise></c:choose></p>
<div class="dialog-actions"><button type="button" data-close-modal class="cancel-button">Cerrar</button><a class="btn secondary" href="expediente.jsp?id=${p.id}">Ver expediente</a><a class="btn secondary" href="historial.jsp?id=${p.id}">Ver documentos e historial</a></div></div></dialog></c:forEach>

<dialog class="uts-dialog" id="responder-f1"><div class="uts-dialog-inner"><button class="dialog-close" type="button" data-close-modal>×</button><h2>Proyecto <span class="uts-tag fase">FASE 1</span></h2><p>El estudiante registra su idea y el pago cuando corresponda.</p><c:choose><c:when test="${sessionScope.rol eq 'ESTUDIANTE'}"><a class="btn" href="../estudiante/pagos.jsp">Registrar comprobante de pago</a><a class="btn secondary" href="../estudiante/proyectos.jsp">Mi propuesta</a></c:when><c:otherwise><p class="uts-small">El Comité revisa la documentación y valida los pagos; la autorización queda registrada en el sistema.</p><a class="btn" href="../comite/pagos.jsp">Validar soportes de pago</a><a class="btn secondary" href="../comite/asignaciones.jsp">Asignar docentes</a></c:otherwise></c:choose></div></dialog>
<dialog class="uts-dialog" id="responder-f2"><div class="uts-dialog-inner"><button class="dialog-close" type="button" data-close-modal>×</button><h2>Proyecto de grado <span class="uts-tag fase">FASE 2</span></h2><c:choose><c:when test="${sessionScope.rol eq 'DIRECTOR'}"><p class="uts-small">Registra observaciones o avala la propuesta. El sistema verifica el estado antes de aceptar el envío.</p><form method="post" action="../acciones/guardar.jsp" data-confirm-send><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="accion" value="director_observar"><input type="hidden" name="proyecto_id" value="${p.id}"><input type="hidden" name="tipo" value="PROPUESTA"><div class="field"><label>Estado de la revisión: Observaciones</label><textarea name="comentario" required placeholder="Describa los detalles de la respuesta para el estudiante"></textarea></div><div class="dialog-actions"><button type="button" data-close-modal class="cancel-button">Cancelar</button><button type="submit" class="lime-button">Responder</button></div></form><a href="../director/revision.jsp?id=${p.id}">Abrir revisión y aval formal del Director</a></c:when><c:otherwise><p>Registra la propuesta F-DC-124 y envíala al Director para su revisión.</p><a class="btn" href="../estudiante/propuesta.jsp?id=${p.id}">Abrir propuesta</a></c:otherwise></c:choose></div></dialog>
<dialog class="uts-dialog" id="responder-f3"><div class="uts-dialog-inner"><button class="dialog-close" type="button" data-close-modal>×</button><h2>Proyecto de grado <span class="uts-tag fase">FASE 3</span></h2><c:choose><c:when test="${sessionScope.rol eq 'EVALUADOR'}"><p>La evaluación del formato F-DC-124 exige responder la rejilla completa antes de emitir el concepto final.</p><a href="../evaluador/evaluacion.jsp?id=${p.id}" class="btn">Diligenciar evaluación</a></c:when><c:otherwise><form method="post" action="../acciones/guardar.jsp" data-confirm-send><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="accion" value="comite_decidir"><input type="hidden" name="proyecto_id" value="${p.id}"><div class="field"><label>Estado del proyecto</label><select name="resultado" required><option value="">Selecciona una opción</option><option value="APROBADO">Aprobado</option><option value="DEVUELTO">Aplazado / devolver</option><option value="NO_APROBADO">No aprobado</option></select></div><div class="field"><label>Acta institucional (archivo cargado)</label><select name="acta_token"><option value="">Seleccionar acta</option><c:forEach var="a" items="${actas.rows}"><option value="${a.token}"><c:out value="${a.nombre}"/></option></c:forEach></select></div><div class="field"><label>O enlace HTTPS al acta</label><input name="acta_url" type="url" placeholder="https://..."></div><div class="form-grid"><div class="field"><label>Número de acta *</label><input name="numero_acta" maxlength="90" placeholder="Ingrese el número de acta" required></div><div class="field"><label>Fecha del acta *</label><input type="date" name="fecha_acta" required></div></div><div class="field"><label>Comentarios de la respuesta</label><textarea name="observacion" required placeholder="Describa los detalles de la respuesta"></textarea></div><p class="uts-small">Para aprobar, antes deben existir aval del Director y evaluación definitiva aprobada. Es obligatorio adjuntar un acta o enlace válido.</p><div class="dialog-actions"><button type="button" data-close-modal class="cancel-button">Cancelar</button><button type="submit" class="lime-button">Responder</button></div></form></c:otherwise></c:choose></div></dialog>
<dialog class="uts-dialog" id="responder-f4"><div class="uts-dialog-inner"><button class="dialog-close" type="button" data-close-modal>×</button><h2>Proyecto de grado <span class="uts-tag fase">FASE 4</span></h2><c:choose><c:when test="${sessionScope.rol eq 'DIRECTOR'}"><p>Revisa el informe final, registra observaciones y el aval formal.</p><a href="../director/revision.jsp?id=${p.id}" class="btn">Abrir informe para revisar</a></c:when><c:otherwise><p>Sube el Informe Final y los entregables institucionales según la modalidad.</p><a href="../estudiante/documentos.jsp?id=${p.id}" class="btn">Cargar informe final</a></c:otherwise></c:choose></div></dialog>
<dialog class="uts-dialog" id="responder-f5"><div class="uts-dialog-inner"><button class="dialog-close" type="button" data-close-modal>×</button><h2>Proyecto de grado <span class="uts-tag fase">FASE 5</span></h2><c:choose><c:when test="${sessionScope.rol eq 'EVALUADOR'}"><p>Registra el concepto del Informe Final. Adjunta las evidencias exigidas en la base documental.</p><a href="../evaluador/evaluacion.jsp?id=${p.id}" class="btn">Evaluar informe final</a></c:when><c:when test="${sessionScope.rol eq 'DIRECTOR'}"><a href="../director/revision.jsp?id=${p.id}" class="btn">Revisar correcciones</a></c:when><c:otherwise><p>El cierre definitivo requiere la evaluación final, actas y sustentación según la modalidad. No puede aprobarse sin esas condiciones.</p><a href="../comite/decisiones.jsp" class="btn">Registrar concepto del Comité</a><a href="../comite/sustentaciones.jsp" class="btn secondary">Programar sustentación</a></c:otherwise></c:choose></div></dialog>

<dialog class="uts-dialog" id="calendario-modal"><div class="uts-dialog-inner"><button class="dialog-close" data-close-modal type="button">×</button><h2>Calendario del <span class="uts-tag fase">PROYECTO</span></h2><p class="uts-small">Fechas registradas para el periodo <c:out value="${p.periodo}"/>.</p><div class="table-scroll"><table><tr><th>DESCRIPCIÓN</th><th>FECHAS</th></tr><c:forEach var="f" items="${periodo.rows}"><tr><td><c:out value="${f.actividad}"/></td><td><c:out value="${f.inicio}"/> a <c:out value="${f.fin}"/></td></tr></c:forEach></table></div><c:if test="${empty periodo.rows}"><p>No hay fechas configuradas para este periodo.</p></c:if><div class="dialog-actions"><button type="button" class="cancel-button" data-close-modal>Cerrar</button></div></div></dialog>
<c:if test="${sessionScope.rol eq 'COMITE'}"><dialog class="uts-dialog" id="ajustes-modal"><div class="uts-dialog-inner"><button class="dialog-close" type="button" data-close-modal>×</button><h2>Ajustes del <span class="uts-tag fase">PROYECTO</span></h2><form method="post" action="../acciones/ajustes_visual.jsp" data-confirm-send><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="proyecto_id" value="${p.id}"><div class="form-grid"><div class="field"><label>Fecha de inicio F-DC-125</label><input type="date" name="fecha_inicio" value="${ajustes.rows[0].inicio_fdc125}"></div><div class="field"><label>Fecha máxima para F-DC-125</label><input type="date" name="fecha_fin" value="${ajustes.rows[0].fin_fdc125}"></div></div><div class="field"><label>Retirar estudiante (registrar solicitud, no eliminar sin decisión)</label><select name="retirar_estudiante_id"><option value="">No solicitar retiro</option><c:forEach var="e" items="${estudiantesAjuste.rows}"><option value="${e.id}"><c:out value="${e.nombre}"/></option></c:forEach></select></div><div class="form-grid"><div class="field"><label>Número de acta</label><input name="numero_acta" value="<c:out value='${ajustes.rows[0].numero_acta}'/>" maxlength="100"></div><div class="field"><label>Fecha del acta</label><input type="date" name="fecha_acta" value="${ajustes.rows[0].fecha_acta}"></div></div><div class="field"><label>Comentarios de la respuesta</label><textarea name="comentarios" placeholder="Describa los detalles" required><c:out value="${ajustes.rows[0].comentarios}"/></textarea></div><p class="uts-small">Los ajustes quedan registrados y auditados. Los cambios de docentes se formalizan desde Asignaciones.</p><div class="dialog-actions"><button type="button" data-close-modal class="cancel-button">Cancelar</button><button type="submit" class="lime-button">Enviar</button></div></form><div class="uts-action-card"><a href="../comite/asignaciones.jsp">Cambiar director, evaluador o codirector</a> · <a href="../comite/periodos.jsp">Fechas del periodo</a></div></div></dialog>
<dialog class="uts-dialog" id="beneficio-modal"><div class="uts-dialog-inner"><button class="dialog-close" type="button" data-close-modal>×</button><h2>Beneficio Saber <span class="uts-tag fase">TyT/PRO</span></h2><p class="uts-small">Registra el reconocimiento solo cuando haya soporte institucional verificable.</p><form method="post" action="../acciones/solicitudes.jsp" data-confirm-send><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="accion" value="beneficio"><input type="hidden" name="proyecto_id" value="${p.id}"><div class="field"><label>Estado de la solicitud</label><select name="estado" required><option value="">Selecciona una opción</option><option value="APROBADO">Aprobado</option><option value="RECHAZADO">Rechazado</option><option value="PENDIENTE">Pendiente</option></select></div><div class="field"><label>Integrante del proyecto</label><select name="estudiante_id" required><option value="">Selecciona un integrante</option><sql:query var="integrantes" dataSource="${db}">SELECT u.id,u.nombre FROM usuarios u JOIN proyecto_estudiantes pe ON pe.estudiante_id=u.id WHERE pe.proyecto_id=CAST(NULLIF(?::text,'') AS bigint)<sql:param value="${p.id}"/></sql:query><c:forEach var="est" items="${integrantes.rows}"><option value="${est.id}"><c:out value="${est.nombre}"/></option></c:forEach></select></div><div class="form-grid"><div class="field"><label>Número de acta</label><input name="acta" maxlength="90" required placeholder="Número de acta"></div><div class="field"><label>Fecha del acta</label><input type="date" name="fecha" required></div></div><div class="field"><label>Comentarios de la respuesta</label><textarea name="comentarios" required placeholder="Describa los detalles de la respuesta para el estudiante"></textarea></div><div class="dialog-actions"><button class="cancel-button" type="button" data-close-modal>Cancelar</button><button class="lime-button" type="submit">Enviar</button></div></form></div></dialog></c:if>
<%@ include file="/WEB-INF/jspf/pie.jspf" %>