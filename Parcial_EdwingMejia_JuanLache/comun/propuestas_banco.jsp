<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ include file="/WEB-INF/jspf/seguridad.jspf" %>
<c:if test="${sessionScope.rol ne 'COMITE' and sessionScope.rol ne 'EVALUADOR' and sessionScope.rol ne 'DIRECTOR' and sessionScope.rol ne 'ADMINISTRADOR'}"><c:redirect url="/dashboard.jsp"><c:param name="error" value="acceso"/></c:redirect></c:if><%@ include file="/WEB-INF/jspf/conexion.jspf" %>
<sql:query var="propuestas" dataSource="${db}">SELECT a.id,a.titulo,a.objetivo,a.descripcion,a.estado,a.nivel,a.docente_id,a.modalidad_id,a.programa_id,a.periodo_id,a.comentario_comite,u.nombre AS docente,pe.nombre AS periodo,m.nombre AS modalidad,pr.nombre AS programa FROM propuestas_banco_uts a JOIN usuarios u ON u.id=a.docente_id JOIN periodos pe ON pe.id=a.periodo_id JOIN programas pr ON pr.id=a.programa_id LEFT JOIN modalidades m ON m.id=a.modalidad_id WHERE ? IN('COMITE','ADMINISTRADOR') OR (? IN('DIRECTOR','EVALUADOR') AND a.docente_id=?) ORDER BY a.fecha DESC LIMIT 300
<sql:param value="${sessionScope.rol}"/><sql:param value="${sessionScope.rol}"/><sql:param value="${sessionScope.usuarioId}"/></sql:query>
<sql:query var="periodosActivos" dataSource="${db}">SELECT id,nombre FROM periodos WHERE estado='ACTIVO' AND CURRENT_DATE BETWEEN apertura_banco AND cierre_banco ORDER BY inicio DESC</sql:query>
<sql:query var="catalogo" dataSource="${db}">SELECT id,nombre FROM modalidades WHERE activo=1 ORDER BY nombre</sql:query>
<sql:query var="programas" dataSource="${db}">SELECT id,nombre FROM programas WHERE activo=1 ORDER BY nombre</sql:query>
<%@ include file="/WEB-INF/jspf/cabecera.jspf" %><div class="uts-toolbar"><h1 class="uts-heading">Propuestas <b>BANCO</b></h1><div class="uts-toolbuttons"><a class="icon-action green" href="banco_visual.jsp" title="Ir al banco de ideas"><svg class="ui-icon" aria-hidden="true"><use href="${pageContext.request.contextPath}/img/icons.svg#book"/></svg></a><c:if test="${sessionScope.rol eq 'COMITE'}"><a class="icon-action dark" href="../comite/config_visual.jsp" title="Configurar ventanas del banco"><svg class="ui-icon" aria-hidden="true"><use href="${pageContext.request.contextPath}/img/icons.svg#settings"/></svg></a></c:if></div></div>
<p class="uts-small">Los docentes pueden proponer nuevas ideas dentro de las fechas habilitadas. El Comité revisa su propuesta antes de publicarla en el Banco de Ideas.</p>
<c:if test="${sessionScope.rol eq 'DIRECTOR' or sessionScope.rol eq 'EVALUADOR'}"><c:choose><c:when test="${not empty periodosActivos.rows}"><button type="button" data-modal="nueva-propuesta" class="btn">+ Proponer nueva idea</button></c:when><c:otherwise><div class="uts-info-notice">El periodo para proponer ideas está cerrado. El Comité puede habilitarlo en Configuraciones al final del semestre.</div></c:otherwise></c:choose></c:if>
<div class="uts-searchbar"><label>Mostrar <select data-page-size><option>5</option><option>10</option><option>20</option></select> registros por página</label><label>Buscar: <input type="search" data-filter-table="tablaPropuestas" placeholder="Ingrese una clave."></label></div>
<div class="table-scroll"><table class="uts-table" id="tablaPropuestas" data-paginate><thead><tr><th>ID</th><th>Descripción</th><th>Estado</th><th>Acciones</th></tr></thead><tbody><c:forEach var="i" items="${propuestas.rows}"><tr><td class="uts-code">BAN-<c:out value="${i.id}"/></td><td>Propuesta de docente para publicar en el banco de ideas institucional<div class="uts-small"><c:out value="${i.titulo}"/></div></td><td><span class="uts-tag ${i.estado eq 'PUBLICADA' or i.estado eq 'APROBADA' ? 'ok' : (i.estado eq 'RECHAZADA' ? 'bad' : 'fase')}"><c:out value="${i.estado}"/></span></td><td><button type="button" class="icon-action blue" data-modal="banco-det-${i.id}" title="Ver detalles"><svg class="ui-icon" aria-hidden="true"><use href="${pageContext.request.contextPath}/img/icons.svg#eye"/></svg></button><c:if test="${sessionScope.rol eq 'COMITE' and i.estado eq 'PENDIENTE'}"><button type="button" class="icon-action sky" data-modal="banco-rev-${i.id}" title="Responder propuesta"><svg class="ui-icon" aria-hidden="true"><use href="${pageContext.request.contextPath}/img/icons.svg#send"/></svg></button></c:if></td></tr></c:forEach></tbody></table></div><div class="uts-pagination" data-pagination></div>
<c:forEach var="i" items="${propuestas.rows}"><dialog class="uts-dialog" id="banco-det-${i.id}"><div class="uts-dialog-inner"><button class="dialog-close" type="button" data-close-modal aria-label="Cerrar">×</button><h2>Detalles de la <span class="uts-tag fase">PROPUESTA</span></h2><dl class="uts-detail-grid"><dt>Docente responsable:</dt><dd><c:out value="${i.docente}"/></dd><dt>Título de la idea:</dt><dd><c:out value="${i.titulo}"/></dd><dt>Tipo de modalidad:</dt><dd><c:out value="${i.modalidad}"/></dd><dt>Objetivo general:</dt><dd><c:out value="${i.objetivo}"/></dd><dt>Descripción:</dt><dd><c:out value="${i.descripcion}"/></dd><dt>Nivel:</dt><dd><c:out value="${i.nivel}"/></dd><dt>Programa:</dt><dd><c:out value="${i.programa}"/></dd><dt>Periodo académico:</dt><dd><c:out value="${i.periodo}"/></dd><dt>Estado:</dt><dd><c:out value="${i.estado}"/></dd><dt>Comentarios Comité:</dt><dd><c:out value="${i.comentario_comite}" default="Sin observaciones"/></dd></dl><div class="dialog-actions"><button type="button" data-close-modal class="cancel-button">Cerrar</button></div></div></dialog>
<c:if test="${sessionScope.rol eq 'COMITE' and i.estado eq 'PENDIENTE'}"><dialog class="uts-dialog" id="banco-rev-${i.id}"><div class="uts-dialog-inner"><button class="dialog-close" type="button" data-close-modal>×</button><h2>Evaluar <span class="uts-tag fase">PROPUESTA BANCO</span></h2><p><c:out value="${i.titulo}"/></p><form method="post" action="../acciones/banco_uts.jsp" data-confirm-send><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="accion" value="resolver"><input type="hidden" name="id" value="${i.id}"><div class="field"><label>Estado</label><select name="estado" required><option value="">Selecciona una opción</option><option value="PUBLICADA">Aprobar y publicar en el Banco</option><option value="RECHAZADA">No aprobar</option></select></div><div class="field"><label>Comentarios del Comité</label><textarea name="comentario" required></textarea></div><div class="dialog-actions"><button type="button" data-close-modal class="cancel-button">Cancelar</button><button class="lime-button" type="submit">Responder</button></div></form></div></dialog></c:if></c:forEach>
<c:if test="${sessionScope.rol eq 'DIRECTOR' or sessionScope.rol eq 'EVALUADOR'}"><dialog class="uts-dialog" id="nueva-propuesta"><div class="uts-dialog-inner"><button class="dialog-close" type="button" data-close-modal aria-label="Cerrar">×</button><h2>Propuesta para el <span class="uts-tag fase">BANCO</span></h2><form method="post" action="../acciones/banco_uts.jsp" data-confirm-send><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="accion" value="crear"><div class="field"><label>Periodo habilitado</label><select name="periodo_id" required><c:forEach var="per" items="${periodosActivos.rows}"><option value="${per.id}"><c:out value="${per.nombre}"/></option></c:forEach></select></div><div class="field"><label>Programa</label><select name="programa_id" required><c:forEach var="pr" items="${programas.rows}"><option value="${pr.id}"><c:out value="${pr.nombre}"/></option></c:forEach></select></div><div class="field"><label>Nivel de formación</label><select name="nivel" required><option value="TECNICO">Técnico</option><option value="TECNOLOGO">Tecnológico</option><option value="PROFESIONAL">Profesional</option></select></div><div class="field"><label>Modalidad</label><select name="modalidad_id" required><c:forEach var="m" items="${catalogo.rows}"><option value="${m.id}"><c:out value="${m.nombre}"/></option></c:forEach></select></div><div class="field"><label>Título de la idea</label><input name="titulo" maxlength="220" required></div><div class="field"><label>Objetivo general</label><textarea name="objetivo" required></textarea></div><div class="field"><label>Descripción de la idea</label><textarea name="descripcion" required></textarea></div><div class="dialog-actions"><button class="cancel-button" type="button" data-close-modal>Cancelar</button><button class="lime-button" type="submit">Enviar propuesta</button></div></form></div></dialog></c:if>
<%@ include file="/WEB-INF/jspf/pie.jspf" %>