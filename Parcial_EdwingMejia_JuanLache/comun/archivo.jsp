<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ include file="/WEB-INF/jspf/seguridad.jspf" %><%@ include file="/WEB-INF/jspf/conexion.jspf" %>
<sql:query var="archivo" dataSource="${db}">SELECT a.nombre,a.mime,a.tamano,a.id FROM archivos a JOIN proyectos p ON p.id=a.proyecto_id
WHERE a.token=? AND a.estado='COMPLETO' AND (?='COMITE' OR (?='ESTUDIANTE' AND EXISTS(SELECT 1 FROM proyecto_estudiantes pe WHERE pe.proyecto_id=p.id AND pe.estudiante_id=CAST(NULLIF(?::text,'') AS bigint))) OR (?='DIRECTOR' AND p.director_id=CAST(NULLIF(?::text,'') AS bigint)) OR (?='EVALUADOR' AND p.evaluador_id=CAST(NULLIF(?::text,'') AS bigint)))
<sql:param value="${param.token}"/><sql:param value="${sessionScope.rol}"/><sql:param value="${sessionScope.rol}"/><sql:param value="${sessionScope.usuarioId}"/><sql:param value="${sessionScope.rol}"/><sql:param value="${sessionScope.usuarioId}"/><sql:param value="${sessionScope.rol}"/><sql:param value="${sessionScope.usuarioId}"/></sql:query>
<c:if test="${empty archivo.rows}"><c:redirect url="/dashboard.jsp"><c:param name="error" value="acceso"/></c:redirect></c:if>
<sql:query var="partes" dataSource="${db}">SELECT contenido FROM archivo_partes WHERE archivo_id=? ORDER BY numero<sql:param value="${archivo.rows[0].id}"/></sql:query>
<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Documento · UTS</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/estilos.css"></head><body class="download-shell"><main class="panel"><h1>Documento autorizado</h1><p><c:out value="${archivo.rows[0].nombre}"/></p><p>El archivo se entrega desde la base de datos a tu navegador. Solo los usuarios autorizados del proyecto pueden consultarlo.</p><p><button id="descargar">Descargar archivo</button> <a href="${pageContext.request.contextPath}/dashboard.jsp">Volver</a></p><span id="estado" role="status"></span></main>
<div id="archivo" hidden data-nombre="<c:out value='${archivo.rows[0].nombre}'/>" data-mime="<c:out value='${archivo.rows[0].mime}'/>"><c:forEach var="p" items="${partes.rows}"><span class="parte"><c:out value="${p.contenido}"/></span></c:forEach></div>
<script>
document.getElementById('descargar').addEventListener('click',function(){try{const root=document.getElementById('archivo');const bytes=[];root.querySelectorAll('.parte').forEach(s=>{const decoded=atob(s.textContent.trim());const buf=new Uint8Array(decoded.length);for(let i=0;i<decoded.length;i++)buf[i]=decoded.charCodeAt(i);bytes.push(buf)});const blob=new Blob(bytes,{type:root.dataset.mime||'application/octet-stream'});const url=URL.createObjectURL(blob),link=document.createElement('a');link.href=url;link.download=root.dataset.nombre||'archivo';link.click();setTimeout(()=>URL.revokeObjectURL(url),2000);document.getElementById('estado').textContent='Archivo preparado.'}catch(e){document.getElementById('estado').textContent='No fue posible reconstruir el archivo.'}});
</script></body></html>
