<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ include file="/WEB-INF/jspf/seguridad.jspf" %><%@ include file="/WEB-INF/jspf/conexion.jspf" %>
<sql:query var="proyecto" dataSource="${db}">SELECT p.*,u.nombre AS estudiante,u.identificacion,u.correo AS correo_estudiante,u.nivel,dr.nombre AS director,ev.nombre AS evaluador,co.nombre AS codirector,m.nombre AS modalidad,pe.nombre AS periodo,i.titulo AS titulo_idea,li.nombre AS linea FROM proyectos p JOIN usuarios u ON u.id=p.estudiante_id JOIN modalidades m ON m.id=p.modalidad_id JOIN periodos pe ON pe.id=p.periodo_id LEFT JOIN usuarios dr ON dr.id=p.director_id LEFT JOIN usuarios ev ON ev.id=p.evaluador_id LEFT JOIN usuarios co ON co.id=p.codirector_id LEFT JOIN ideas i ON i.id=p.idea_id LEFT JOIN lineas_investigacion li ON li.id=p.linea_id WHERE p.id=CAST(NULLIF(?::text,'') AS bigint) AND ((? IN('COMITE','ADMINISTRADOR')) OR (?='ESTUDIANTE' AND EXISTS(SELECT 1 FROM proyecto_estudiantes s WHERE s.proyecto_id=p.id AND s.estudiante_id=CAST(NULLIF(?::text,'') AS bigint))) OR (?='DIRECTOR' AND p.director_id=CAST(NULLIF(?::text,'') AS bigint)) OR (?='EVALUADOR' AND (p.evaluador_id=CAST(NULLIF(?::text,'') AS bigint) OR p.evaluador_propuesta_excepcion_id=CAST(NULLIF(?::text,'') AS bigint)))) LIMIT 1
<sql:param value="${param.id}"/><sql:param value="${sessionScope.rol}"/><sql:param value="${sessionScope.rol}"/><sql:param value="${sessionScope.usuarioId}"/><sql:param value="${sessionScope.rol}"/><sql:param value="${sessionScope.usuarioId}"/><sql:param value="${sessionScope.rol}"/><sql:param value="${sessionScope.usuarioId}"/><sql:param value="${sessionScope.usuarioId}"/></sql:query>
<c:choose><c:when test="${empty proyecto.rows}"><h2>Expediente no disponible</h2><p>Este proyecto no existe o no tienes autorización para consultarlo.</p></c:when><c:otherwise><c:set var="p" value="${proyecto.rows[0]}"/>
<sql:query var="propuesta" dataSource="${db}">SELECT * FROM propuestas WHERE proyecto_id=CAST(NULLIF(?::text,'') AS bigint) ORDER BY version DESC LIMIT 1<sql:param value="${p.id}"/></sql:query>
<sql:query var="docs" dataSource="${db}">SELECT nombre,tipo,url,archivo_token,version FROM documentos WHERE proyecto_id=CAST(NULLIF(?::text,'') AS bigint) ORDER BY fecha DESC LIMIT 30<sql:param value="${p.id}"/></sql:query>
<sql:query var="pagos" dataSource="${db}">SELECT referencia,estado,url,archivo_token FROM pagos WHERE proyecto_id=CAST(NULLIF(?::text,'') AS bigint) ORDER BY fecha DESC LIMIT 10<sql:param value="${p.id}"/></sql:query>
<h2>Detalles del <span class="uts-tag fase">PROYECTO</span></h2><dl class="uts-detail-grid">
<dt>Tipo de idea:</dt><dd><c:choose><c:when test="${empty p.idea_id}">Idea propia del estudiante</c:when><c:otherwise>Idea del banco de ideas</c:otherwise></c:choose></dd>
<dt>Título de la idea:</dt><dd><c:out value="${empty p.titulo_idea ? p.titulo : p.titulo_idea}"/></dd>
<dt>Estudiante:</dt><dd><c:out value="${p.estudiante}"/> · <c:out value="${p.identificacion}"/></dd>
<dt>Docentes:</dt><dd>Director: <c:out value="${empty p.director ? 'No asignado' : p.director}"/><br>Evaluador: <c:out value="${empty p.evaluador ? 'No asignado' : p.evaluador}"/><br>Codirector: <c:out value="${empty p.codirector ? 'No asignado' : p.codirector}"/></dd>
<dt>Nivel académico:</dt><dd><c:out value="${p.nivel}"/></dd><dt>Modalidad:</dt><dd><c:out value="${p.modalidad}"/></dd><dt>Periodo académico:</dt><dd><c:out value="${p.periodo}"/></dd>
<dt>Objetivo de la idea:</dt><dd><c:out value="${empty propuesta.rows ? 'Aún no registrado' : propuesta.rows[0].objetivo_general}"/></dd>
<dt>Descripción:</dt><dd><c:out value="${empty propuesta.rows ? 'Sin propuesta registrada' : propuesta.rows[0].problema}"/></dd>
<dt>Línea de investigación:</dt><dd><c:out value="${empty p.linea ? 'Sin asignar' : p.linea}"/></dd>
<dt>Estado actual:</dt><dd><c:out value="${p.fase}"/> — <c:out value="${p.estado}"/></dd>
<dt>Soportes de pago:</dt><dd><c:forEach var="pa" items="${pagos.rows}"><div><c:out value="${pa.referencia}"/> · <c:out value="${pa.estado}"/> <c:if test="${not empty pa.archivo_token}"><a href="../comun/archivo.jsp?token=${pa.archivo_token}">Ver comprobante</a></c:if></div></c:forEach><c:if test="${empty pagos.rows}">No hay soportes registrados.</c:if></dd>
<dt>Documentos:</dt><dd><c:forEach var="d" items="${docs.rows}"><div><c:out value="${d.tipo}"/>: <c:choose><c:when test="${not empty d.archivo_token}"><a href="../comun/archivo.jsp?token=${d.archivo_token}"><c:out value="${d.nombre}"/></a></c:when><c:when test="${fn:startsWith(d.url,'https://')}"><a href="<c:out value='${d.url}'/>" target="_blank" rel="noopener noreferrer"><c:out value="${d.nombre}"/></a></c:when><c:otherwise><c:out value="${d.nombre}"/></c:otherwise></c:choose> · v${d.version}</div></c:forEach><c:if test="${empty docs.rows}">Aún no hay archivos.</c:if></dd>
</dl><div class="dialog-actions"><a class="btn secondary" href="../comun/seguimiento.jsp?id=${p.id}">Seguimiento de fases</a><a class="btn secondary" href="../comun/historial.jsp?id=${p.id}">Historial completo</a></div>
</c:otherwise></c:choose>